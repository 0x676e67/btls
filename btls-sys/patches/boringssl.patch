 }
 
+// BoringSSL removed generic SHA-384 CBC verification in
+// https://github.com/google/boringssl/commit/c31fb79cfe35f8b14731bb2598d091b2e1394577.
+// This specialization follows the current SHA-256 secret-suffix design while
+// retaining SHA-384's 128-byte block and 16-byte length field. That design was
+// introduced in
+// https://github.com/google/boringssl/commit/b1c6f45f1fe6d808555d04a41bb44b322e4f4c1d.
+// The earlier SHA-384 variable-block correction is recorded in
+// https://github.com/google/boringssl/commit/144d924e0b3c3a5ceb7083a408ba69b7cca1a25c.
+// Its fixed variance count is replaced by the public max_len loop below.
+static int sha384_final_with_secret_suffix(
+    SHA512_CTX *ctx, uint8_t out[SHA384_DIGEST_LENGTH], const uint8_t *in,
+    size_t len, size_t max_len) {
+  constexpr size_t kBlockSize = SHA384_CBLOCK;
+  constexpr size_t kLengthFieldSize = 2 * sizeof(uint64_t);
+  static_assert(SHA384_DIGEST_LENGTH == 48);
+  static_assert(kBlockSize == 128);
+  static_assert(kLengthFieldSize == 16);
+  static_assert(kBlockSize == SHA512_CBLOCK);
+
+  // TLS records are much smaller than this bound. Keeping the total byte count
+  // below 2^61 lets the SHA-384 bit length fit in the low half of its 128-bit
+  // length field and also bounds the block-count arithmetic below.
+  constexpr uint64_t kMaxBytes = UINT64_MAX >> 3;
+  if (len > max_len || ctx->md_len != SHA384_DIGEST_LENGTH ||
+      ctx->num >= kBlockSize ||
+      ctx->bytes_so_far_high != 0 ||
+      ctx->bytes_so_far_low > kMaxBytes ||
+      max_len > kMaxBytes - ctx->bytes_so_far_low ||
+      max_len >
+          SIZE_MAX - ctx->num - 1 - kLengthFieldSize - (kBlockSize - 1)) {
+    return 0;
+  }
+
+  // SHA-384 uses SHA-512's compression function, 128-byte blocks, and 16-byte
+  // length field. See FIPS 180-4, sections 5.1.2 and 5.3.4.
+  // https://doi.org/10.6028/NIST.FIPS.180-4
+  size_t num_blocks =
+      (ctx->num + len + 1 + kLengthFieldSize + kBlockSize - 1) / kBlockSize;
+  size_t last_block = num_blocks - 1;
+  size_t max_blocks =
+      (ctx->num + max_len + 1 + kLengthFieldSize + kBlockSize - 1) /
+      kBlockSize;
+
+  uint64_t total_bits = (ctx->bytes_so_far_low + len) << 3;
+  uint8_t length_bytes[kLengthFieldSize] = {0};
+  CRYPTO_store_u64_be(
+      length_bytes + kLengthFieldSize - sizeof(total_bits), total_bits);
+
+  uint8_t block[kBlockSize] = {0};
+  uint8_t result[SHA384_DIGEST_LENGTH] = {0};
+  size_t input_idx = 0;
+  for (size_t i = 0; i < max_blocks; i++) {
+    size_t block_start = 0;
+    if (i == 0) {
+      OPENSSL_memcpy(block, ctx->p, ctx->num);
+      block_start = ctx->num;
+    }
+    if (input_idx < max_len) {
+      size_t to_copy = kBlockSize - block_start;
+      if (to_copy > max_len - input_idx) {
+        to_copy = max_len - input_idx;
+      }
+      OPENSSL_memcpy(block + block_start, in + input_idx, to_copy);
+    }
+
+    for (size_t j = block_start; j < kBlockSize; j++) {
+      size_t idx = input_idx + j - block_start;
+      uint8_t is_in_bounds =
+          constant_time_lt_8(idx, value_barrier_w(len));
+      uint8_t is_padding_byte =
+          constant_time_eq_8(idx, value_barrier_w(len));
+      block[j] &= is_in_bounds;
+      block[j] |= 0x80 & is_padding_byte;
+    }
+
+    input_idx += kBlockSize - block_start;
+
+    crypto_word_t is_last_block =
+        value_barrier_w(constant_time_eq_w(i, last_block));
+    for (size_t j = 0; j < sizeof(length_bytes); j++) {
+      block[kBlockSize - sizeof(length_bytes) + j] |=
+          is_last_block & length_bytes[j];
+    }
+
+    SHA512_Transform(ctx, block);
+    for (size_t j = 0; j < 8; j++) {
+      CRYPTO_store_u64_be(block + 8 * j, ctx->h[j]);
+    }
+    for (size_t j = 0; j < sizeof(result); j++) {
+      result[j] |= block[j] & is_last_block;
+    }
+  }
+
+  OPENSSL_memcpy(out, result, sizeof(result));
+  return 1;
+}
