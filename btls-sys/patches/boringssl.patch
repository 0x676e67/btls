+UniquePtr<DH> MakeFFDHEGroup(UniquePtr<BIGNUM> p) {
+  UniquePtr<DH> dh(DH_new());
+  UniquePtr<BIGNUM> g(BN_new());
+  if (!p || !dh || !g || !BN_set_word(g.get(), 2) ||
+      !DH_set0_pqg(dh.get(), p.get(), /*q=*/nullptr, g.get())) {
+    return nullptr;
+  }
+  // DH_set0_pqg takes ownership on success.
+  p.release();
+  g.release();
+  return dh;
