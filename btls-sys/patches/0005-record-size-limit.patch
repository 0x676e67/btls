+static bool ConfigureECH(SSL *client, SSL_CTX *server_ctx) {
+  ScopedEVP_HPKE_KEY key;
+  uint8_t *ech_config = nullptr;
+  size_t ech_config_len = 0;
+  if (!EVP_HPKE_KEY_generate(key.get(), EVP_hpke_x25519_hkdf_sha256()) ||
+      !SSL_marshal_ech_config(&ech_config, &ech_config_len,
+                              /*config_id=*/1, key.get(), "public.example",
+                              /*max_name_len=*/16)) {
+    return false;
+  }
+  UniquePtr<uint8_t> ech_config_storage(ech_config);
+
+  UniquePtr<SSL_ECH_KEYS> keys(SSL_ECH_KEYS_new());
+  if (!keys ||
+      !SSL_ECH_KEYS_add(keys.get(), /*is_retry_config=*/1, ech_config,
+                        ech_config_len, key.get()) ||
+      !SSL_CTX_set1_ech_keys(server_ctx, keys.get())) {
+    return false;
+  }
+
+  uint8_t *ech_config_list = nullptr;
+  size_t ech_config_list_len = 0;
+  if (!SSL_ECH_KEYS_marshal_retry_configs(keys.get(), &ech_config_list,
+                                          &ech_config_list_len)) {
+    return false;
+  }
+  UniquePtr<uint8_t> ech_config_list_storage(ech_config_list);
+  return SSL_set_tlsext_host_name(client, "secret.example") &&
+         SSL_set1_ech_config_list(client, ech_config_list, ech_config_list_len);
+}
+
+static bool IsRetryableHandshakeError(int error) {
+  return error == SSL_ERROR_NONE || error == SSL_ERROR_WANT_READ ||
+         error == SSL_ERROR_WANT_WRITE || error == SSL_ERROR_PENDING_TICKET;
+}
+
+static bool CompleteHandshakes(SSL *client, SSL *server) {
+  for (size_t i = 0; i < 1000; i++) {
+    for (SSL *ssl : {client, server}) {
+      if (!SSL_in_init(ssl)) {
+        continue;
+      }
+      const int ret = SSL_do_handshake(ssl);
+      const int error = SSL_get_error(ssl, ret);
+      if (!IsRetryableHandshakeError(error)) {
+        fprintf(stderr, "%s error: %s\n", ssl == client ? "Client" : "Server",
+                SSL_error_description(error));
+        return false;
+      }
+    }
+    if (!SSL_in_init(client) && !SSL_in_init(server)) {
+      return true;
+    }
+  }
+  fprintf(stderr, "Handshake did not converge\n");
+  return false;
+}
+
+static bool FlushNewSessionTickets(SSL *client, SSL *server) {
+  for (size_t i = 0; i < 1000; i++) {
+    const int server_ret = SSL_write(server, nullptr, 0);
+    const int server_error = SSL_get_error(server, server_ret);
+    if (server_ret > 0 ||
+        (server_ret < 0 && server_error != SSL_ERROR_WANT_WRITE)) {
+      return false;
+    }
+
+    const int client_ret = SSL_read(client, nullptr, 0);
+    if (client_ret != -1 ||
+        SSL_get_error(client, client_ret) != SSL_ERROR_WANT_READ) {
+      return false;
+    }
+    if (server_ret == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static UniquePtr<SSL_SESSION> g_last_session;
+
+static int SaveLastSession(SSL *, SSL_SESSION *session) {
+  g_last_session.reset(session);
+  return 1;
+}
+
+static UniquePtr<SSL_SESSION> CreateClientSession(SSL_CTX *client_ctx,
+                                                  SSL_CTX *server_ctx) {
+  g_last_session = nullptr;
+  SSL_CTX_sess_set_new_cb(client_ctx, SaveLastSession);
+  UniquePtr<SSL> client, server;
+  if (!CreatePair(&client, &server, client_ctx, server_ctx) ||
+      !CompleteHandshakes(client.get(), server.get()) ||
+      !FlushNewSessionTickets(client.get(), server.get())) {
+    return nullptr;
+  }
+  SSL_CTX_sess_set_new_cb(client_ctx, nullptr);
+  return std::move(g_last_session);
+}
+
+static bool ReadExact(SSL *ssl, Span<uint8_t> out) {
+  size_t offset = 0;
+  while (offset < out.size()) {
+    const int ret = SSL_read(ssl, out.data() + offset, out.size() - offset);
+    if (ret <= 0) {
+      return false;
+    }
+    offset += static_cast<size_t>(ret);
+  }
+  return true;
+}
+
+static bool ErrorQueueContains(int reason) {
+  bool found = false;
+  for (;;) {
+    const uint32_t error = ERR_get_error();
+    if (error == 0) {
+      return found;
+    }
+    found |=
+        ERR_GET_LIB(error) == ERR_LIB_SSL && ERR_GET_REASON(error) == reason;
+  }
+}
