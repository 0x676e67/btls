+TEST(RecordSizeLimitTest, RejectedEarlyDataDoesNotUseNewEpochLimit) {
+  // RFC 8446 section 4.2.10 requires rejected early data to be discarded.
+  // The patch must not apply the new RFC 8449 limit to those old-epoch records.
+  // https://www.rfc-editor.org/rfc/rfc8446.html#section-4.2.10
+  for (uint16_t old_limit : {0, 512}) {
+    SCOPED_TRACE(old_limit);
+    auto client_ctx = CreateContext(false, TLS1_3_VERSION);
+    auto server_ctx = CreateContext(true, TLS1_3_VERSION);
+    ASSERT_TRUE(client_ctx);
+    ASSERT_TRUE(server_ctx);
+    SSL_CTX_set_session_cache_mode(client_ctx.get(), SSL_SESS_CACHE_BOTH);
+    SSL_CTX_set_session_cache_mode(server_ctx.get(), SSL_SESS_CACHE_BOTH);
+    SSL_CTX_set_early_data_enabled(client_ctx.get(), 1);
+    SSL_CTX_set_early_data_enabled(server_ctx.get(), 1);
+    SSL_CTX_set_record_size_limit(client_ctx.get(), 96);
+    SSL_CTX_set_record_size_limit(server_ctx.get(), old_limit);
+    auto session = CreateClientSession(client_ctx.get(), server_ctx.get());
+    ASSERT_TRUE(session);
+    ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+
+    SSL_CTX_set_record_size_limit(server_ctx.get(), 64);
+    UniquePtr<SSL> client, server;
+    ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+    ASSERT_TRUE(SSL_set_session(client.get(), session.get()));
+    SSL_set_early_data_enabled(server.get(), 0);
+    ASSERT_EQ(SSL_do_handshake(client.get()), 1);
+    ASSERT_TRUE(SSL_in_early_data(client.get()));
+    std::array<uint8_t, 200> sent = {0x5a};
+    ASSERT_EQ(SSL_write(client.get(), sent.data(), sent.size()),
+              static_cast<int>(sent.size()));
+
+    int ret = SSL_do_handshake(server.get());
+    ASSERT_EQ(SSL_get_error(server.get(), ret), SSL_ERROR_WANT_READ);
+    ASSERT_TRUE(FromOpaque(server.get())->s3->skip_early_data);
+    ret = SSL_do_handshake(client.get());
+    ASSERT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_EARLY_DATA_REJECTED);
+    SSL_reset_early_data_reject(client.get());
+    ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+    EXPECT_TRUE(SSL_session_reused(client.get()));
+    EXPECT_FALSE(SSL_early_data_accepted(server.get()));
+    EXPECT_FALSE(FromOpaque(server.get())->s3->skip_early_data);
+    EXPECT_EQ(FromOpaque(server.get())->s3->read_record_size_limit, 64);
+    EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 64);
+
+    // Only the new application data may reach the server, not the discarded
+    // early data. It must now be fragmented using the new, smaller limit.
+    sent.fill(0xa5);
+    ASSERT_EQ(SSL_write(client.get(), sent.data(), sent.size()),
+              static_cast<int>(sent.size()));
+    std::array<uint8_t, 200> received = {};
+    ASSERT_TRUE(ReadExact(server.get(), received));
+    EXPECT_EQ(received, sent);
+  }
+}
