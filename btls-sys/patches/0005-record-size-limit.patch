+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+
+  // The offer alone must not reject the record containing the server's
+  // refusal. Check the first record, not merely the largest in the flight.
+  ASSERT_FALSE(lengths.empty());
+  EXPECT_GT(lengths.front(), 64u + 16u);
+  for (SSL *ssl : {client.get(), server.get()}) {
+    const SSL3_STATE *state = FromOpaque(ssl)->s3;
+    EXPECT_EQ(state->read_record_size_limit, 0);
+    EXPECT_EQ(state->write_record_size_limit, 0);
+    EXPECT_EQ(state->unconfirmed_read_record_size_limit, 0);
+    EXPECT_FALSE(state->unconfirmed_read_record_size_limit_exceeded);
+  }
+  std::array<uint8_t, 200> sent = {0x5a};
+  std::array<uint8_t, 200> received = {};
+  ASSERT_EQ(SSL_write(server.get(), sent.data(), sent.size()),
+            static_cast<int>(sent.size()));
+  ASSERT_TRUE(ReadExact(client.get(), received));
+  EXPECT_EQ(received, sent);
+}
