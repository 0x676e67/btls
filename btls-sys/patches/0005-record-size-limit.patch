+TEST(RecordSizeLimitTest, FragmentsFirstTls13ProtectedFlight) {
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(false, TLS1_3_VERSION);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(true, TLS1_3_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  SSL_CTX_set_record_size_limit(client_ctx.get(), 64);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 96);
+  SSL_CTX_set_options(server_ctx.get(), SSL_OP_NO_TICKET);
+
+  std::vector<uint16_t> lengths;
+  SSL_CTX_set_msg_callback(server_ctx.get(), CaptureProtectedRecordLengths);
+  SSL_CTX_set_msg_callback_arg(server_ctx.get(), &lengths);
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+
+  // The 64-byte limit includes the inner content type. All enabled TLS 1.3
+  // ciphers add a 16-byte tag; record headers are not counted here.
+  ASSERT_GT(lengths.size(), 1u);
+  EXPECT_LE(lengths.front(), 64u + 16u);
+  for (uint16_t length : lengths) {
+    EXPECT_LE(length, 64u + 16u);
+  }
+  EXPECT_EQ(FromOpaque(client.get())->s3->read_record_size_limit, 64);
+  EXPECT_EQ(FromOpaque(server.get())->s3->write_record_size_limit, 64);
