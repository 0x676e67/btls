+TEST(RecordSizeLimitTest, EarlyDataUsesTheSessionEpochLimits) {
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(false, TLS1_3_VERSION);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(true, TLS1_3_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  SSL_CTX_set_session_cache_mode(client_ctx.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_session_cache_mode(server_ctx.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_set_early_data_enabled(client_ctx.get(), 1);
+  SSL_CTX_set_early_data_enabled(server_ctx.get(), 1);
+  SSL_CTX_set_record_size_limit(client_ctx.get(), 96);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 128);
+
+  UniquePtr<SSL_SESSION> session =
+      CreateClientSession(client_ctx.get(), server_ctx.get());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+  EXPECT_EQ(session->local_record_size_limit, 96);
+  EXPECT_EQ(session->peer_record_size_limit, 128);
+
+  uint8_t *encoded = nullptr;
+  size_t encoded_len = 0;
+  ASSERT_TRUE(SSL_SESSION_to_bytes(session.get(), &encoded, &encoded_len));
+  UniquePtr<uint8_t> encoded_storage(encoded);
+  UniquePtr<SSL_SESSION> decoded(
+      SSL_SESSION_from_bytes(encoded, encoded_len, client_ctx.get()));
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(decoded->local_record_size_limit, 96);
+  EXPECT_EQ(decoded->peer_record_size_limit, 128);
+
+  SSL_CTX_set_record_size_limit(client_ctx.get(), 80);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 64);
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  ASSERT_TRUE(SSL_set_session(client.get(), decoded.get()));
+
+  ASSERT_EQ(SSL_do_handshake(client.get()), 1);
+  ASSERT_TRUE(SSL_in_early_data(client.get()));
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 128);
+
+  ASSERT_EQ(SSL_do_handshake(server.get()), 1);
+  ASSERT_TRUE(SSL_in_early_data(server.get()));
+  EXPECT_EQ(FromOpaque(server.get())->s3->read_record_size_limit, 128);
+
+  std::array<uint8_t, 100> sent = {};
+  std::array<uint8_t, 100> received = {};
+  for (size_t i = 0; i < sent.size(); i++) {
+    sent[i] = static_cast<uint8_t>(i);
+  }
+  ASSERT_EQ(SSL_write(client.get(), sent.data(), sent.size()),
+            static_cast<int>(sent.size()));
+  ASSERT_TRUE(ReadExact(server.get(), received));
+  EXPECT_EQ(received, sent);
+
+  const int client_finish = SSL_do_handshake(client.get());
+  ASSERT_TRUE(
+      IsRetryableHandshakeError(SSL_get_error(client.get(), client_finish)));
+  uint8_t unused;
+  const int server_finish = SSL_read(server.get(), &unused, sizeof(unused));
+  ASSERT_EQ(server_finish, -1);
+  ASSERT_EQ(SSL_get_error(server.get(), server_finish), SSL_ERROR_WANT_READ);
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_TRUE(SSL_session_reused(server.get()));
+  EXPECT_EQ(FromOpaque(client.get())->s3->read_record_size_limit, 80);
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 64);
+  EXPECT_EQ(FromOpaque(server.get())->s3->read_record_size_limit, 64);
+  EXPECT_EQ(FromOpaque(server.get())->s3->write_record_size_limit, 80);
+}
