+#include <openssl/ssl.h>
+
+#include <algorithm>
+#include <variant>
+
+#include <openssl/bytestring.h>
+#include <openssl/err.h>
+
+#include "internal.h"
+
+
+BSSL_NAMESPACE_BEGIN
+
+// RFC 8449 limits protected record plaintext to 2^14 bytes before TLS 1.3 and
+// 2^14 + 1 bytes in TLS 1.3, where the extra byte is the inner content type.
+static constexpr uint16_t kMinRecordSizeLimit = 64;
+
+static uint16_t record_size_limit_max_for_version(uint16_t version) {
+  return version >= TLS1_3_VERSION ? SSL3_RT_MAX_PLAIN_LENGTH + 1
+                                   : SSL3_RT_MAX_PLAIN_LENGTH;
+}
+
+static uint16_t record_size_limit_for_version(uint16_t limit,
+                                              uint16_t version) {
+  return std::clamp(limit, kMinRecordSizeLimit,
+                    record_size_limit_max_for_version(version));
+}
+
+static bool record_size_limit_parse(uint16_t *out, uint8_t *out_alert,
+                                    CBS *contents) {
+  if (!CBS_get_u16(contents, out) || CBS_len(contents) != 0) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DECODE_ERROR);
+    *out_alert = SSL_AD_DECODE_ERROR;
+    return false;
+  }
+  if (*out < kMinRecordSizeLimit) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+    return false;
+  }
+  return true;
+}
+
+static void record_size_limit_clear_pending(SSL_HANDSHAKE *hs) {
+  hs->ssl->s3->pending_read_record_size_limit = 0;
+  hs->ssl->s3->pending_write_record_size_limit = 0;
+}
+
+void ssl_record_size_limit_store_session(SSL_HANDSHAKE *hs) {
+  if (hs->new_session == nullptr ||
+      ssl_protocol_version(hs->ssl) < TLS1_3_VERSION) {
+    return;
+  }
+  hs->new_session->local_record_size_limit =
+      hs->ssl->s3->pending_read_record_size_limit;
+  hs->new_session->peer_record_size_limit =
+      hs->ssl->s3->pending_write_record_size_limit;
+}
+
+static void record_size_limit_negotiate(SSL_HANDSHAKE *hs,
+                                        uint16_t peer_limit) {
+  const uint16_t version = ssl_protocol_version(hs->ssl);
+  hs->ssl->s3->pending_write_record_size_limit =
+      std::min(peer_limit, record_size_limit_max_for_version(version));
+  hs->ssl->s3->pending_read_record_size_limit =
+      record_size_limit_for_version(hs->record_size_limit, version);
+  ssl_record_size_limit_store_session(hs);
+}
+
+static void record_size_limit_clear_unconfirmed(SSLImpl *ssl) {
+  ssl->s3->unconfirmed_read_record_size_limit = 0;
+  ssl->s3->unconfirmed_read_record_size_limit_exceeded = false;
+}
+
+void ssl_record_size_limit_snapshot_config(SSL_HANDSHAKE *hs) {
+  // The value stays fixed for the rest of the handshake, including a second
+  // ClientHello after HelloRetryRequest. DTLS and QUIC do not use it.
+  hs->record_size_limit = SSL_is_dtls(hs->ssl) || SSL_is_quic(hs->ssl)
+                              ? 0
+                              : hs->config->record_size_limit;
+}
+
+bool ssl_record_size_limit_disallows_handoff(const SSLImpl *ssl) {
+  if ((ssl->config != nullptr && ssl->config->record_size_limit != 0) ||
+      ssl->s3->read_record_size_limit != 0 ||
+      ssl->s3->write_record_size_limit != 0 ||
+      ssl->s3->pending_read_record_size_limit != 0 ||
+      ssl->s3->pending_write_record_size_limit != 0 ||
+      ssl->s3->unconfirmed_read_record_size_limit != 0) {
+    return true;
+  }
+  const SSL_HANDSHAKE *hs = ssl->s3->hs.get();
+  return hs != nullptr && hs->record_size_limit != 0;
+}
+
+bool record_size_limit_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out, CBB *,
+                                       ssl_client_hello_type_t) {
+  if (hs->record_size_limit == 0) {
+    return true;
+  }
+
+  CBB data;
+  const uint16_t limit =
+      record_size_limit_for_version(hs->record_size_limit, hs->max_version);
+  return CBB_add_u16(out, TLSEXT_TYPE_record_size_limit) &&
+         CBB_add_u16_length_prefixed(out, &data) && CBB_add_u16(&data, limit) &&
+         CBB_flush(out);
+}
+
+bool record_size_limit_parse_serverhello(SSL_HANDSHAKE *hs, uint8_t *out_alert,
+                                         CBS *contents) {
+  record_size_limit_clear_pending(hs);
+  const bool unconfirmed_limit_exceeded =
+      hs->ssl->s3->unconfirmed_read_record_size_limit_exceeded;
+  record_size_limit_clear_unconfirmed(hs->ssl);
+  if (contents == nullptr) {
+    ssl_record_size_limit_store_session(hs);
+    return true;
+  }
+
+  uint16_t peer_limit;
+  if (!record_size_limit_parse(&peer_limit, out_alert, contents)) {
+    return false;
+  }
+  if (peer_limit >
+      record_size_limit_max_for_version(ssl_protocol_version(hs->ssl))) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+    return false;
+  }
+  if (unconfirmed_limit_exceeded) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DATA_LENGTH_TOO_LONG);
+    *out_alert = SSL_AD_RECORD_OVERFLOW;
+    return false;
+  }
+
+  record_size_limit_negotiate(hs, peer_limit);
+  if (ssl_protocol_version(hs->ssl) >= TLS1_3_VERSION) {
+    // EncryptedExtensions confirms the limit after the client installed its
+    // handshake keys. Apply it to that epoch now. If 0-RTT is active, its write
+    // epoch retains the prior session's limit until close_early_data.
+    hs->ssl->s3->read_record_size_limit =
+        hs->ssl->s3->pending_read_record_size_limit;
+    if (!hs->in_early_data) {
+      hs->ssl->s3->write_record_size_limit =
+          hs->ssl->s3->pending_write_record_size_limit;
+    }
+  }
+  return true;
+}
+
+bool record_size_limit_parse_clienthello(SSL_HANDSHAKE *hs, uint8_t *out_alert,
+                                         CBS *contents) {
+  // The server snapshots here rather than at handshake start so that
+  // select_certificate_cb may still adjust the limit for this connection.
+  ssl_record_size_limit_snapshot_config(hs);
+  record_size_limit_clear_pending(hs);
+  hs->peer_record_size_limit = 0;
+  if (hs->record_size_limit == 0 || contents == nullptr) {
+    return true;
+  }
+
+  uint16_t peer_limit;
+  if (!record_size_limit_parse(&peer_limit, out_alert, contents)) {
+    return false;
+  }
+  // RFC 8449 section 4 permits a client to send a value above the protocol
+  // maximum. Servers clamp it to the maximum they can send.
+  hs->peer_record_size_limit = peer_limit;
+  record_size_limit_negotiate(hs, peer_limit);
+  return true;
+}
+
+bool ssl_record_size_limit_check_second_clienthello(
+    const SSL_HANDSHAKE *hs, const SSL_CLIENT_HELLO *client_hello) {
+  if (hs->record_size_limit == 0) {
+    return true;
+  }
+
+  // RFC 8446 section 4.1.2 only allows listed changes between the two
+  // ClientHellos, and RFC 8449 fixes the value for the handshake.
+  CBS contents;
+  const bool present = ssl_client_hello_get_extension(
+      client_hello, &contents, TLSEXT_TYPE_record_size_limit);
+  if (present != (hs->peer_record_size_limit != 0)) {
+    OPENSSL_PUT_ERROR(SSL, present ? SSL_R_UNEXPECTED_EXTENSION
+                                   : SSL_R_MISSING_EXTENSION);
+    return false;
+  }
+  uint16_t second_limit;
+  if (present && (!CBS_get_u16(&contents, &second_limit) ||
+                  CBS_len(&contents) != 0 ||
+                  second_limit != hs->peer_record_size_limit)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    return false;
+  }
+  return true;
+}
+
+bool record_size_limit_add_serverhello(SSL_HANDSHAKE *hs, CBB *out) {
+  if (hs->ssl->s3->pending_read_record_size_limit == 0) {
+    return true;
+  }
+
+  CBB data;
+  return CBB_add_u16(out, TLSEXT_TYPE_record_size_limit) &&
+         CBB_add_u16_length_prefixed(out, &data) &&
+         CBB_add_u16(&data, hs->ssl->s3->pending_read_record_size_limit) &&
+         CBB_flush(out);
+}
+
+static const SSL_SESSION *record_size_limit_psk_session(
+    const SSLPreSharedKey *psk) {
+  if (psk == nullptr) {
+    return nullptr;
+  }
+  const auto *session = std::get_if<UniquePtr<SSL_SESSION>>(psk);
+  return session != nullptr && *session != nullptr ? session->get() : nullptr;
+}
+
+void ssl_record_size_limit_set_read_state(SSLImpl *ssl,
+                                          ssl_encryption_level_t level) {
+  uint16_t limit = ssl->s3->pending_read_record_size_limit;
+  if (level == ssl_encryption_early_data && ssl->server) {
+    const SSL_SESSION *session = record_size_limit_psk_session(
+        ssl->s3->hs == nullptr ? nullptr : ssl->s3->hs->pre_shared_key.get());
+    limit = session == nullptr ? 0 : session->local_record_size_limit;
+  }
+
+  ssl->s3->read_record_size_limit = limit;
+  record_size_limit_clear_unconfirmed(ssl);
+  if (level == ssl_encryption_handshake && !ssl->server &&
+      ssl_protocol_version(ssl) >= TLS1_3_VERSION && limit == 0 &&
+      ssl->s3->hs != nullptr && ssl->s3->hs->record_size_limit != 0) {
+    ssl->s3->unconfirmed_read_record_size_limit = record_size_limit_for_version(
+        ssl->s3->hs->record_size_limit, ssl_protocol_version(ssl));
+  }
+}
+
+void ssl_record_size_limit_set_write_state(SSLImpl *ssl,
+                                           ssl_encryption_level_t level) {
+  uint16_t limit = ssl->s3->pending_write_record_size_limit;
+  if (level == ssl_encryption_early_data && !ssl->server &&
+      ssl->s3->hs != nullptr && ssl->s3->hs->early_session != nullptr) {
+    limit = ssl->s3->hs->early_session->peer_record_size_limit;
+  }
+  ssl->s3->write_record_size_limit = limit;
+}
+
+size_t ssl_record_size_limit_max_send_fragment(const SSLImpl *ssl,
+                                               size_t configured_limit) {
+  if (ssl->s3->write_record_size_limit == 0 ||
+      ssl->s3->aead_write_ctx->is_null_cipher()) {
+    return configured_limit;
+  }
+
+  size_t record_size_limit = ssl->s3->write_record_size_limit;
+  if (ssl_protocol_version(ssl) >= TLS1_3_VERSION) {
+    // TLS 1.3 includes the inner content type in the advertised limit.
+    record_size_limit--;
+  }
+  return std::min(configured_limit, record_size_limit);
+}
+
+bool ssl_record_size_limit_check_seal(const SSLImpl *ssl, size_t in_len,
+                                      size_t extra_in_len) {
+  // Callers fragment by ssl_record_size_limit_max_send_fragment, so this only
+  // guards against a record layer path that bypasses that fragmentation.
+  const uint16_t limit = ssl->s3->write_record_size_limit;
+  if (limit != 0 && !ssl->s3->aead_write_ctx->is_null_cipher() &&
+      in_len + extra_in_len > limit) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_RECORD_TOO_LARGE);
+    return false;
+  }
+  return true;
+}
+
+bool ssl_record_size_limit_check_ciphertext(SSLImpl *ssl, size_t ciphertext_len,
+                                            uint8_t *out_alert) {
+  const uint16_t limit = ssl->s3->read_record_size_limit;
+  if (limit == 0 || ssl->s3->aead_read_ctx->is_null_cipher()) {
+    return true;
+  }
+
+  // Rejected 0-RTT uses the previous session's keys and limits. Let trial
+  // decryption discard it before applying the new handshake's limit (RFC
+  // 8446 section 4.2.10). Successfully decrypted records still pass through
+  // ssl_record_size_limit_check_plaintext before they can be processed.
+  if (ssl->s3->skip_early_data) {
+    return true;
+  }
+
+  const uint16_t version = ssl_protocol_version(ssl);
+  if (version < TLS1_3_VERSION &&
+      limit == record_size_limit_max_for_version(version)) {
+    // RFC 8449 section 4.1 narrows CBC padding only when the advertised limit
+    // is below the protocol maximum. The normal record bound remains in force.
+    return true;
+  }
+
+  const size_t inner_type_len = version >= TLS1_3_VERSION ? 1 : 0;
+  const size_t plaintext_len = limit - inner_type_len;
+  size_t max_ciphertext_len;
+  if (!ssl->s3->aead_read_ctx->CiphertextLen(&max_ciphertext_len, plaintext_len,
+                                             inner_type_len)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return false;
+  }
+  if (ciphertext_len > max_ciphertext_len) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_ENCRYPTED_LENGTH_TOO_LONG);
+    *out_alert = SSL_AD_RECORD_OVERFLOW;
+    return false;
+  }
+  return true;
+}
+
+bool ssl_record_size_limit_check_plaintext(SSLImpl *ssl, size_t plaintext_len,
+                                           size_t protocol_limit,
+                                           uint8_t *out_alert) {
+  if (plaintext_len > protocol_limit) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DATA_LENGTH_TOO_LONG);
+    *out_alert = SSL_AD_RECORD_OVERFLOW;
+    return false;
+  }
+  if (ssl->s3->aead_read_ctx->is_null_cipher()) {
+    return true;
+  }
+
+  const uint16_t limit = ssl->s3->read_record_size_limit;
+  if (limit != 0 && plaintext_len > limit) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DATA_LENGTH_TOO_LONG);
+    *out_alert = SSL_AD_RECORD_OVERFLOW;
+    return false;
+  }
+  if (limit == 0 && ssl->s3->unconfirmed_read_record_size_limit != 0 &&
+      plaintext_len > ssl->s3->unconfirmed_read_record_size_limit) {
+    ssl->s3->unconfirmed_read_record_size_limit_exceeded = true;
+  }
+  return true;
+}
+
+bool ssl_record_size_limit_session_values_valid(const SSL_SESSION *session) {
+  const uint16_t local = session->local_record_size_limit;
+  const uint16_t peer = session->peer_record_size_limit;
+  if (local == 0 || peer == 0) {
+    return local == 0 && peer == 0;
+  }
+  if (ssl_session_protocol_version(session) < TLS1_3_VERSION) {
+    return false;
+  }
+  const uint16_t max = record_size_limit_max_for_version(TLS1_3_VERSION);
+  return local >= kMinRecordSizeLimit && local <= max &&
+         peer >= kMinRecordSizeLimit && peer <= max;
+}
+
+BSSL_NAMESPACE_END
+
+using namespace bssl;
+
+void SSL_set_record_size_limit(SSL *ssl, uint16_t limit) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (ssl_impl->config != nullptr) {
+    ssl_impl->config->record_size_limit = limit;
+  }
+}
+
+void SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit) {
+  FromOpaque(ctx)->record_size_limit = limit;
+}
