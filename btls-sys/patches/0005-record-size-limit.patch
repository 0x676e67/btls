+// Observe the patch's RFC 8449 behavior on the wire. In TLS 1.3 the first
+// protected server record carries the start of EncryptedExtensions, before
+// the client knows whether its advertised receive limit was accepted.
+// https://www.rfc-editor.org/rfc/rfc8449.html#section-4
+static void CaptureProtectedRecordLengths(int is_write, int, int content_type,
+                                          const void *buf, size_t len, SSL *,
+                                          void *arg) {
+  if (!is_write || content_type != SSL3_RT_HEADER ||
+      len != SSL3_RT_HEADER_LENGTH) {
+    return;
+  }
+  const auto *header = static_cast<const uint8_t *>(buf);
+  if (header[0] == SSL3_RT_APPLICATION_DATA) {
+    auto *lengths = static_cast<std::vector<uint16_t> *>(arg);
+    lengths->push_back((static_cast<uint16_t>(header[3]) << 8) | header[4]);
+  }
+}
