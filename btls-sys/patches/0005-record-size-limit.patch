+// SSL_set_record_size_limit configures the maximum protected-record plaintext
+// that |ssl| is willing to receive and advertises it with RFC 8449. Zero
+// disables the extension. Values below 64 and above the protocol maximum are
+// clamped when advertised. The default is zero to preserve existing ClientHello
+// behavior. The value is fixed once the client builds its first ClientHello or
+// the server parses one, so a server may still set it from
+// |SSL_CTX_set_select_certificate_cb|; later calls apply to a future handshake.
+// This is currently supported for stream TLS only, not DTLS, QUIC, or split
+// handshakes.
+OPENSSL_EXPORT void SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
+
+// SSL_CTX_set_record_size_limit applies SSL_set_record_size_limit to new
+// connections created from |ctx|.
+OPENSSL_EXPORT void SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit);
+
 // SSL_max_seal_overhead returns the maximum overhead, in bytes, of sealing a
 // record with `ssl`.
