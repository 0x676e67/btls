+TEST(RecordSizeLimitTest, TrialDecryptionStillEnforcesAuthenticatedRecordLimit) {
+  auto client_ctx = CreateContext(false, TLS1_3_VERSION);
+  auto server_ctx = CreateContext(true, TLS1_3_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  SSL_CTX_set_record_size_limit(client_ctx.get(), 96);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 64);
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+
+  // Isolate the trial-decryption state with a record authenticated by the
+  // current keys. Skipping the ciphertext check must not bypass the limit.
+  FromOpaque(server.get())->s3->skip_early_data = true;
+  FromOpaque(client.get())->s3->write_record_size_limit = 0;
+  std::array<uint8_t, 200> data = {};
+  ASSERT_EQ(SSL_write(client.get(), data.data(), data.size()),
+            static_cast<int>(data.size()));
+  ERR_clear_error();
+  const int ret = SSL_read(server.get(), data.data(), data.size());
+  EXPECT_EQ(SSL_get_error(server.get(), ret), SSL_ERROR_SSL);
+  EXPECT_TRUE(ErrorQueueContains(SSL_R_DATA_LENGTH_TOO_LONG));
+  EXPECT_EQ(FromOpaque(server.get())->s3->send_alert[1], SSL_AD_RECORD_OVERFLOW);
+}
