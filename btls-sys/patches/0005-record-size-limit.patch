+TEST(RecordSizeLimitTest, RejectsOversizedFirstTls13ProtectedFlight) {
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(false, TLS1_3_VERSION);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(true, TLS1_3_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  SSL_CTX_set_record_size_limit(client_ctx.get(), 64);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 96);
+  SSL_CTX_set_cert_cb(
+      server_ctx.get(),
+      [](SSL *ssl, void *) -> int {
+        // Simulate a peer which acknowledges record_size_limit but does not
+        // apply it while constructing its first protected flight.
+        FromOpaque(ssl)->s3->pending_write_record_size_limit = 0;
+        return 1;
+      },
+      nullptr);
+
+  SSL_CTX_set_options(server_ctx.get(), SSL_OP_NO_TICKET);
+  std::vector<uint16_t> lengths;
+  SSL_CTX_set_msg_callback(server_ctx.get(), CaptureProtectedRecordLengths);
+  SSL_CTX_set_msg_callback_arg(server_ctx.get(), &lengths);
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  int ret = SSL_do_handshake(client.get());
+  ASSERT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_WANT_READ);
+  ret = SSL_do_handshake(server.get());
+  ASSERT_TRUE(IsRetryableHandshakeError(SSL_get_error(server.get(), ret)));
+
+  ASSERT_FALSE(lengths.empty());
+  ASSERT_GT(lengths.front(), 64u + 16u);
+  ERR_clear_error();
+  ret = SSL_do_handshake(client.get());
+  EXPECT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_SSL);
+  EXPECT_TRUE(ErrorQueueContains(SSL_R_DATA_LENGTH_TOO_LONG));
+  EXPECT_EQ(FromOpaque(client.get())->s3->send_alert[1],
+            SSL_AD_RECORD_OVERFLOW);
+
+  ERR_clear_error();
+  ret = SSL_do_handshake(server.get());
+  EXPECT_EQ(SSL_get_error(server.get(), ret), SSL_ERROR_SSL);
+  EXPECT_TRUE(ErrorQueueContains(SSL_R_TLSV1_ALERT_RECORD_OVERFLOW));
+}
