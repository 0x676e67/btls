+TEST(RecordSizeLimitTest, SecondClientHelloMustRepeatExtension) {
+  UniquePtr<SSL_CTX> ctx = CreateContext(true, TLS1_3_VERSION);
+  ASSERT_TRUE(ctx);
+  SSL_CTX_set_record_size_limit(ctx.get(), 96);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_accept_state(ssl.get());
+  SSLImpl *ssl_impl = FromOpaque(ssl.get());
+  SSL_HANDSHAKE hs(ssl_impl);
+  hs.config = ssl_impl->config.get();
+  ssl_impl->s3->version = TLS1_3_VERSION;
+
+  const uint8_t first[] = {0x02, 0x00};
+  CBS contents(first);
+  uint8_t alert = 0;
+  ASSERT_TRUE(record_size_limit_parse_clienthello(&hs, &alert, &contents));
+  EXPECT_EQ(hs.peer_record_size_limit, 512);
+
+  auto check = [&](Span<const uint8_t> extensions) {
+    SSL_CLIENT_HELLO client_hello = {};
+    client_hello.extensions = extensions.data();
+    client_hello.extensions_len = extensions.size();
+    ERR_clear_error();
+    return ssl_record_size_limit_check_second_clienthello(&hs, &client_hello);
+  };
+  const uint8_t same[] = {0x00, 0x1c, 0x00, 0x02, 0x02, 0x00};
+  const uint8_t changed[] = {0x00, 0x1c, 0x00, 0x02, 0x03, 0x00};
+  const uint8_t malformed[] = {0x00, 0x1c, 0x00, 0x01, 0x02};
+  EXPECT_TRUE(check(same));
+  EXPECT_FALSE(check(changed));
+  EXPECT_TRUE(ErrorQueueContains(SSL_R_BAD_LENGTH));
+  EXPECT_FALSE(check(malformed));
+  EXPECT_FALSE(check(Span<const uint8_t>()));
+  EXPECT_TRUE(ErrorQueueContains(SSL_R_MISSING_EXTENSION));
+
+  // Without the extension in the first ClientHello, it must stay absent.
+  hs.peer_record_size_limit = 0;
+  EXPECT_TRUE(check(Span<const uint8_t>()));
+  EXPECT_FALSE(check(same));
+  EXPECT_TRUE(ErrorQueueContains(SSL_R_UNEXPECTED_EXTENSION));
+
+  // A server with the extension disabled does not track it at all.
+  hs.record_size_limit = 0;
+  EXPECT_TRUE(check(same));
+}
