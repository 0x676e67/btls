+TEST(RecordSizeLimitTest, CapsClientOfferAtTls12Maximum) {
+  // A TLS 1.3-capable client may offer 2^14 + 1. A server that negotiates
+  // TLS 1.2 must not reject it and caps its sends at 2^14 (RFC 8449 section
+  // 4), and the client's own receive limit follows the negotiated version.
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(false, TLS1_2_VERSION);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(true, TLS1_2_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ASSERT_TRUE(SSL_CTX_set_max_proto_version(client_ctx.get(), TLS1_3_VERSION));
+  SSL_CTX_set_record_size_limit(client_ctx.get(), UINT16_MAX);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 96);
+
+  ClientHelloObservation observation;
+  ScopedClientHelloObservation scoped_observation(&observation);
+  SSL_CTX_set_select_certificate_cb(server_ctx.get(), ObserveClientHello);
+
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+  EXPECT_EQ(SSL_version(client.get()), TLS1_2_VERSION);
+  EXPECT_TRUE(observation.present);
+  EXPECT_EQ(observation.value, SSL3_RT_MAX_PLAIN_LENGTH + 1);
+  const SSL3_STATE *client_state = FromOpaque(client.get())->s3;
+  const SSL3_STATE *server_state = FromOpaque(server.get())->s3;
+  EXPECT_EQ(client_state->read_record_size_limit, SSL3_RT_MAX_PLAIN_LENGTH);
+  EXPECT_EQ(client_state->write_record_size_limit, 96);
+  EXPECT_EQ(server_state->read_record_size_limit, 96);
+  EXPECT_EQ(server_state->write_record_size_limit, SSL3_RT_MAX_PLAIN_LENGTH);
+}
