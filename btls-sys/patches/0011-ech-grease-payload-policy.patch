   bssl::ScopedCBB cbb;
   CBB enc_cbb, payload_cbb;
   uint8_t *payload;
@@ -785,7 +813,11 @@ static bool setup_ech_grease(SSL_HANDSHAKE *hs) {
 
 bool ssl_encrypt_client_hello(SSL_HANDSHAKE *hs, Span<const uint8_t> enc) {
   SSLImpl *const ssl = hs->ssl;
+  hs->ech_grease_policy_locked = true;
   if (!hs->selected_ech_config) {
+    if (ssl_ech_grease_pending(hs)) {
+      return true;
