     return setup_ech_grease(hs);
   }
 
@@ -889,6 +921,81 @@ bool ssl_encrypt_client_hello(SSL_HANDSHAKE *hs, Span<const uint8_t> enc) {
   return true;
 }
 
+// The 42-byte body framing includes the type byte, suite, config ID,
+// X25519 encapsulated key and both length prefixes. Four more bytes encode
+// the TLS extension header. Account for the whole extensions vector as well.
+static constexpr size_t kGreaseFraming = 42;
+
+bool ssl_ech_grease_pending(const SSL_HANDSHAKE *hs) {
+  return !hs->selected_ech_config && hs->max_version >= TLS1_3_VERSION &&
+         hs->config->ech_grease_enabled && hs->ech_client_outer.empty() &&
+         hs->config->ech_grease_callback != nullptr;
+}
+
+bool ssl_setup_ech_grease(SSL_HANDSHAKE *hs, Span<const uint8_t> extensions,
+                          Span<const uint8_t> preamble, size_t psk_len,
+                          size_t padding_reserve) {
+  const size_t old_len = extensions.size();
+  if (old_len > UINT16_MAX - 4 - kGreaseFraming ||
+      psk_len > UINT16_MAX - 4 - kGreaseFraming - old_len ||
+      padding_reserve > UINT16_MAX - 4 - kGreaseFraming - old_len - psk_len) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+    return false;
+  }
+  SSL_ECH_GREASE_SIZE_INFO info = {};
+  info.preamble_length = preamble.size();
+  info.psk_extension_length = psk_len;
+  info.is_dtls = SSL_is_dtls(hs->ssl);
+  info.is_quic = SSL_is_quic(hs->ssl);
+  info.max_payload_length =
+      UINT16_MAX - 4 - kGreaseFraming - old_len - psk_len - padding_reserve;
+
+  // Expose cipher bytes and extension sizes, not session IDs or ticket data.
+  CBS header(preamble), ignored, ciphers;
+  if (!CBS_skip(&header, 2 + SSL3_RANDOM_SIZE) ||
+      !CBS_get_u8_length_prefixed(&header, &ignored) ||
+      (info.is_dtls && !CBS_get_u8_length_prefixed(&header, &ignored)) ||
+      !CBS_get_u16_length_prefixed(&header, &ciphers) ||
+      !CBS_get_u8_length_prefixed(&header, &ignored) || CBS_len(&header) != 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+  info.cipher_suites = CBS_data(&ciphers);
+  info.cipher_suites_length = CBS_len(&ciphers);
+  Array<SSL_ECH_GREASE_EXTENSION> metadata;
+  CBS remaining(extensions);
+  size_t count = 0;
+  while (CBS_len(&remaining) != 0) {
+    CBS body;
+    if (!CBS_skip(&remaining, 2) ||
+        !CBS_get_u16_length_prefixed(&remaining, &body)) {
+      return false;
+    }
+    count++;
+  }
+  // Allocate metadata only on the custom path, never proportional to key shares
+  // or other large extension bodies. Its lifetime includes the callback.
+  if (!metadata.InitForOverwrite(count)) {
+    return false;
+  }
+  remaining = CBS(extensions);
+  while (CBS_len(&remaining) != 0) {
+    uint16_t type;
+    CBS body;
+    if (!CBS_get_u16(&remaining, &type) ||
+        !CBS_get_u16_length_prefixed(&remaining, &body)) {
+      return false;
+    }
+    metadata[info.num_extensions++] = {type, CBS_len(&body)};
+    if (type == TLSEXT_TYPE_server_name) {
+      info.has_server_name = 1;
+      info.server_name_length = strlen(hs->ssl->hostname.get());
+    }
+  }
+  info.extensions = metadata.data();
+  return setup_ech_grease(hs, &info);
+}
+
 BSSL_NAMESPACE_END
 
 using namespace bssl;
@@ -901,6 +1008,19 @@ void SSL_set_enable_ech_grease(SSL *ssl, int enable) {
   ssl_impl->config->ech_grease_enabled = !!enable;
 }
 
+int SSL_set_ech_grease_callback(
+    SSL *ssl, SSL_ech_grease_callback callback, void *arg) {
+  auto *impl = FromOpaque(ssl);
+  if (!impl->config || !impl->s3->hs ||
+      impl->s3->hs->ech_grease_policy_locked) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  impl->config->ech_grease_callback = callback;
+  impl->config->ech_grease_callback_arg = arg;
+  return 1;
+}
+
 int SSL_set1_ech_config_list(SSL *ssl, const uint8_t *ech_config_list,
                              size_t ech_config_list_len) {
   auto *ssl_impl = FromOpaque(ssl);
