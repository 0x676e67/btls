diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index d786638787..64e40e6115 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -4638,6 +4638,58 @@ OPENSSL_EXPORT const char *SSL_early_data_reason_string(
 // ECH extension when no supported ECHConfig is available.
 OPENSSL_EXPORT void SSL_set_enable_ech_grease(SSL *ssl, int enable);
 
+// ECH GREASE parameters. These APIs do not enable GREASE or affect real ECH.
+// Configure before the first ClientHello is built. Lengths include the simulated
+// AEAD tag, but exclude the encapsulated key and extension framing.
+typedef struct {
+  uint16_t type;
+  size_t length;  // Extension body length, excluding its four-byte header.
+} SSL_ECH_GREASE_EXTENSION;
+
+// All pointers are borrowed for the callback only. Extensions exclude ECH,
+// padding, and pre_shared_key. psk_extension_length includes its header.
+// preamble_length excludes handshake headers and the extensions length prefix.
+typedef struct {
+  const uint8_t *cipher_suites;
+  size_t cipher_suites_length;
+  const SSL_ECH_GREASE_EXTENSION *extensions;
+  size_t num_extensions;
+  size_t preamble_length;
+  size_t psk_extension_length;
+  size_t server_name_length;
+  int has_server_name;
+  int is_dtls;
+  int is_quic;
+  uint16_t default_aead_id;
+  size_t aead_overhead;
+  size_t max_payload_length;
+} SSL_ECH_GREASE_SIZE_INFO;
+
+typedef struct {
+  uint16_t aead_id;
+  size_t payload_length;
+} SSL_ECH_GREASE_PARAMETERS;
+
+// The callback returns one on success, zero to fail the handshake. It must set
+// out->aead_id to EVP_HPKE_AES_128_GCM or EVP_HPKE_CHACHA20_POLY1305, and
+// out->payload_length to a nonzero value at most info->max_payload_length.
+// Both supported AEADs have the same overhead, exposed in info->aead_overhead.
+// Invalid output fails the handshake, without truncation or fallback. Only
+// GREASE parameters change, not TLS cipher preferences or real ECH. BoringSSL
+// still generates the random payload bytes.
+// The callback must not mutate or reenter the SSL. It is called once for the
+// first GREASE ClientHello; HRR reuses the complete extension (RFC 9849 6.2.1).
+typedef int (*SSL_ech_grease_callback)(
+    const SSL_ECH_GREASE_SIZE_INFO *info, SSL_ECH_GREASE_PARAMETERS *out,
+    void *arg);
+
+// Sets or replaces the callback. A null callback restores upstream defaults.
+// Returns one on success, zero if ClientHello has already started, leaving the
+// previous callback unchanged.
+// arg must remain valid until replacement or SSL destruction.
+OPENSSL_EXPORT int SSL_set_ech_grease_callback(
+    SSL *ssl, SSL_ech_grease_callback callback, void *arg);
+
 // SSL_set1_ech_config_list configures `ssl` to, as a client, offer ECH with the
 // specified configuration. `ech_config_list` should contain a serialized
 // ECHConfigList structure. It returns one on success and zero on error.
diff --git a/ssl/ech_grease_policy_test.cc b/ssl/ech_grease_policy_test.cc
new file mode 100644
index 0000000000..a37fe7b59a
--- /dev/null
+++ b/ssl/ech_grease_policy_test.cc
@@ -0,0 +1,194 @@
+// Copyright 2026 The btls Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#include <algorithm>
+#include <vector>
+#include <gtest/gtest.h>
+#include <openssl/err.h>
+#include <openssl/ssl.h>
+#include "../crypto/bytestring/internal.h"
+#include "internal.h"
+
+BSSL_NAMESPACE_BEGIN
+namespace {
+
+static int FixedLength(const SSL_ECH_GREASE_SIZE_INFO *info,
+                       SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+  out->aead_id = info->default_aead_id;
+  out->payload_length = *static_cast<const size_t *>(arg);
+  return 1;
+}
+
+// Collect all records so near-limit ClientHellos may span record boundaries.
+static bool GetHello(SSL *ssl, Array<uint8_t> *out) {
+  UniquePtr<BIO> bio(BIO_new(BIO_s_mem()));
+  if (!bio || !BIO_up_ref(bio.get())) {
+    return false;
+  }
+  SSL_set_bio(ssl, nullptr, bio.get());
+  SSL_connect(ssl);
+  ERR_clear_error();
+  const uint8_t *data;
+  size_t length;
+  if (!BIO_mem_contents(bio.get(), &data, &length) || length == 0) {
+    return false;
+  }
+  CBS records(Span(data, length)), record;
+  ScopedCBB hello;
+  if (!CBB_init(hello.get(), 256)) {
+    return false;
+  }
+  while (CBS_len(&records) != 0) {
+    uint8_t type;
+    if (!CBS_get_u8(&records, &type) || type != SSL3_RT_HANDSHAKE ||
+        !CBS_skip(&records, 2) ||
+        !CBS_get_u16_length_prefixed(&records, &record) ||
+        !CBB_add_bytes(hello.get(), CBS_data(&record), CBS_len(&record))) {
+      return false;
+    }
+  }
+  return CBBFinishArray(hello.get(), out);
+}
+
+TEST(ECHGreasePolicyTest, WireLengthAndTotalBudget) {
+  for (size_t requested : {size_t{1}, size_t{239}, size_t{65000}}) {
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    ASSERT_TRUE(SSL_CTX_set1_curves_list(ctx.get(), "X25519"));
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    ASSERT_TRUE(
+        SSL_set_ech_grease_callback(ssl.get(), FixedLength, &requested));
+    Array<uint8_t> hello;
+    ASSERT_TRUE(GetHello(ssl.get(), &hello));
+    ASSERT_GE(hello.size(), size_t{4});
+    SSL_CLIENT_HELLO parsed;
+    ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed, hello.data() + 4,
+                                       hello.size() - 4));
+    const uint8_t *ech;
+    size_t length;
+    ASSERT_TRUE(SSL_early_callback_ctx_extension_get(
+        &parsed, TLSEXT_TYPE_encrypted_client_hello, &ech, &length));
+    ASSERT_EQ(length, requested + 42);
+    EXPECT_EQ((size_t{ech[40]} << 8) | ech[41], requested);
+    EXPECT_FALSE(SSL_set_ech_grease_callback(ssl.get(), nullptr, nullptr));
+    ERR_clear_error();
+  }
+}
+
+TEST(ECHGreasePolicyTest, RejectsCallbackOverflowAndFailure) {
+  for (int failure = 0; failure < 8; failure++) {
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    ASSERT_TRUE(SSL_set_ech_grease_callback(
+        ssl.get(),
+        [](const SSL_ECH_GREASE_SIZE_INFO *info, SSL_ECH_GREASE_PARAMETERS *out,
+           void *arg) {
+          EXPECT_GT(info->num_extensions, size_t{0});
+          EXPECT_GT(info->cipher_suites_length, size_t{0});
+          EXPECT_LT(info->max_payload_length, size_t{UINT16_MAX - 42});
+          out->aead_id = info->default_aead_id;
+          switch (*static_cast<int *>(arg)) {
+            case 0:
+              out->payload_length = info->max_payload_length + 1;
+              break;
+            case 1:
+              out->payload_length = 0;
+              break;
+            case 2:
+              out->payload_length = SIZE_MAX;
+              break;
+            case 3:
+              return 0;
+            case 4:
+              return 1;  // Success without writing a length is invalid.
+            case 5:
+              out->aead_id = 0;
+              out->payload_length = 239;
+              break;
+            case 6:
+              out->aead_id = 2;  // AES-256-GCM is not a supported GREASE AEAD.
+              out->payload_length = 239;
+              break;
+            case 7:
+              out->aead_id = UINT16_MAX;
+              out->payload_length = 239;
+              break;
+          }
+          return 1;
+        },
+        &failure));
+    Array<uint8_t> hello;
+    EXPECT_FALSE(GetHello(ssl.get(), &hello));
+  }
+}
+
+TEST(ECHGreasePolicyTest, CallbackMayUseExactRemainingBudget) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  ASSERT_TRUE(SSL_set_ech_grease_callback(
+      ssl.get(),
+      [](const SSL_ECH_GREASE_SIZE_INFO *info, SSL_ECH_GREASE_PARAMETERS *out,
+         void *) {
+        out->aead_id = info->default_aead_id;
+        out->payload_length = info->max_payload_length;
+        return 1;
+      },
+      nullptr));
+  Array<uint8_t> hello;
+  EXPECT_TRUE(GetHello(ssl.get(), &hello));
+}
+
+TEST(ECHGreasePolicyTest, PreservesExplicitExtensionPosition) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  const auto capture = [&](std::vector<uint16_t> *order) {
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    size_t length = 239;
+    ASSERT_TRUE(SSL_set_ech_grease_callback(ssl.get(), FixedLength, &length));
+    Array<uint8_t> hello;
+    ASSERT_TRUE(GetHello(ssl.get(), &hello));
+    ASSERT_GE(hello.size(), size_t{4});
+    SSL_CLIENT_HELLO parsed;
+    ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed, hello.data() + 4,
+                                       hello.size() - 4));
+    CBS extensions(Span(parsed.extensions, parsed.extensions_len)), body;
+    while (CBS_len(&extensions) != 0) {
+      uint16_t type;
+      ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+      ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &body));
+      if (type != TLSEXT_TYPE_padding) {
+        order->push_back(type);
+      }
+    }
+  };
+  std::vector<uint16_t> others;
+  ASSERT_NO_FATAL_FAILURE(capture(&others));
+  const auto ech = std::find(others.begin(), others.end(),
+                             TLSEXT_TYPE_encrypted_client_hello);
+  ASSERT_NE(ech, others.end());
+  others.erase(ech);
+  // Derive the inventory from a real hello, not a copy of upstream's table.
+  for (size_t position : {size_t{0}, others.size() / 2, others.size()}) {
+    auto expected = others;
+    expected.insert(expected.begin() + position,
+                    TLSEXT_TYPE_encrypted_client_hello);
+    ASSERT_TRUE(SSL_CTX_set_extension_order(ctx.get(), expected.data(),
+                                            expected.size()));
+    std::vector<uint16_t> actual;
+    ASSERT_NO_FATAL_FAILURE(capture(&actual));
+    EXPECT_EQ(actual, expected);
+  }
+}
+
+}  // namespace
+BSSL_NAMESPACE_END
