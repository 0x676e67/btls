index f8627416b4..0c8acaba3f 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -4712,11 +4712,21 @@ bool ssl_add_clienthello_tlsext(SSL_HANDSHAKE *hs, CBB *out, CBB *out_encoded,
   }
 
   bool last_was_empty = false;
+  const bool custom_ech = ssl_ech_grease_pending(hs);
+  size_t ech_offset = 0;
+  size_t ech_index = 0;
   for (size_t unpermuted = 0; unpermuted < kNumExtensions; unpermuted++) {
     size_t i = hs->extension_permutation.empty()
                    ? unpermuted
                    : hs->extension_permutation[unpermuted];
     const size_t len_before = CBB_len(&extensions);
+    if (custom_ech &&
+        kExtensions[i].value == TLSEXT_TYPE_encrypted_client_hello) {
+      ech_offset = len_before;
+      ech_index = i;
+      last_was_empty = false;
+      continue;
+    }
     if (!kExtensions[i].add_clienthello(hs, &extensions, &extensions, type)) {
       OPENSSL_PUT_ERROR(SSL, SSL_R_ERROR_ADDING_EXTENSION);
       ERR_add_error_dataf("extension %u", (unsigned)kExtensions[i].value);
@@ -4745,6 +4755,41 @@ bool ssl_add_clienthello_tlsext(SSL_HANDSHAKE *hs, CBB *out, CBB *out_encoded,
   // bugs. We also apply this padding to ClientHelloOuter, to keep the wire
   // images aligned.
   size_t psk_len = ext_pre_shared_key_clienthello_length(hs, type);
+  if (custom_ech) {
+    const size_t preamble_len = msg_len - SSL3_HM_HEADER_LENGTH;
+    if (!CBB_flush(&extensions)) {
+      return false;
+    }
+    // `out` has an active child, so CBB_data(out) is not permitted. The child's
+    // data follows the preamble and its two-byte extensions length prefix in
+    // the same allocation. Derive the view after all potentially reallocating
+    // extension writers have finished.
+    const auto preamble =
+        Span(CBB_data(&extensions) - 2 - preamble_len, preamble_len);
+    // A trailing empty extension needs a five-byte WebSphere workaround.
+    // The F5 workaround only applies to small messages, far below UINT16_MAX.
+    const size_t padding_reserve =
+        last_was_empty && psk_len == 0 && !SSL_is_dtls(ssl) &&
+                !SSL_is_quic(ssl) && !ssl->s3->used_hello_retry_request
+            ? 5
+            : 0;
+    const size_t old_len = CBB_len(&extensions);
+    if (ech_offset > old_len) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_LENGTH);
+      return false;
+    }
+    if (!ssl_setup_ech_grease(hs, Span(CBB_data(&extensions), old_len),
+                             preamble, psk_len, padding_reserve) ||
+        !ext_ech_add_clienthello(hs, &extensions, &extensions, type)) {
+      return false;
+    }
+    // Reuse the upstream encoder, then move the complete extension into place.
+    // Fetch data after encoding, which may have reallocated the CBB.
+    uint8_t *data = CBB_data(&extensions);
+    std::rotate(data + ech_offset, data + old_len,
+                data + CBB_len(&extensions));
+    hs->extensions.sent |= (1u << ech_index);
+  }
   if (!SSL_is_dtls(ssl) && !SSL_is_quic(ssl) &&
       !ssl->s3->used_hello_retry_request) {
     msg_len += 2 /* length prefix */ + CBB_len(&extensions) + psk_len;
