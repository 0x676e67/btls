+
+int SSL_set1_ech_config_list_with_policy(SSL *ssl,
+                                        const uint8_t *ech_config_list,
+                                        size_t ech_config_list_len,
+                                        int nss_inner) {
   auto *ssl_impl = FromOpaque(ssl);
   if (!ssl_impl->config) {
     return 0;
@@ -1097,7 +1105,11 @@ int SSL_set1_ech_config_list(SSL *ssl, const uint8_t *ech_config_list,
