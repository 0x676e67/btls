 int SSL_set1_ech_config_list(SSL *ssl, const uint8_t *ech_config_list,
                              size_t ech_config_list_len) {
+  return SSL_set1_ech_config_list_with_policy(
+      ssl, ech_config_list, ech_config_list_len, /*nss_inner=*/0);
