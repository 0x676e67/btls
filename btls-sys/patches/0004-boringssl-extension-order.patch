diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index e44af9b12..9ad7527ec 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -4359,6 +4359,105 @@ static_assert(kNumExtensions <=
                   sizeof(((SSL_HANDSHAKE *)nullptr)->extensions.received) * 8,
               "too many extensions for received bitset");
 
+
+// Shuffle only the part that was not configured. This is the same Fisher-Yates
+// loop used by ssl_setup_extension_permutation: for a suffix of length L,
+// iteration i reads seeds[i - 1] and swaps with an entry from 0 through i.
+// Every index here is relative to suffix, so no offset adjustment is needed.
+static bool ssl_shuffle_extension_order_suffix(Span<uint8_t> suffix) {
+  if (suffix.size() < 2) {
+    return true;
+  }
+
+  static_assert(kNumExtensions <= UINT8_MAX,
+                "extensions_permutation type is too small");
+  // suffix should come from a kNumExtensions-sized permutation. Check it here
+  // too, because seeds has room for only kNumExtensions - 1 values.
+  if (suffix.size() > kNumExtensions) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+
+  uint32_t seeds[kNumExtensions - 1];
+  // A suffix of L entries needs L - 1 swaps and therefore L - 1 seeds.
+  const size_t seeds_num = suffix.size() - 1;
+  if (!RAND_bytes(reinterpret_cast<uint8_t *>(seeds),
+                  seeds_num * sizeof(seeds[0]))) {
+    return false;
+  }
+
+  for (size_t i = suffix.size() - 1; i > 0; i--) {
+    std::swap(suffix[i], suffix[seeds[i - 1] % (i + 1)]);
+  }
+  return true;
+}
+
+// Put configured extensions first, then append every extension not listed in
+// the configuration. Unknown IDs and duplicates do not take a slot. The first
+// part stays in order; ssl_shuffle_extension_order_suffix randomizes the rest.
+bool ssl_setup_extension_order(SSL_HANDSHAKE *hs) {
+  SSLImpl *const ssl = hs->ssl;
+  if (ssl->ctx->extension_order.empty()) {
+    return ssl_setup_extension_permutation(hs);
+  }
+
+  Array<uint8_t> permutation;
+  if (!permutation.InitForOverwrite(kNumExtensions)) {
+    return false;
+  }
+
+  bool seen[kNumExtensions] = {0};
+  size_t permutation_len = 0;
+
+  // extension_order contains wire IDs, but the ClientHello writer reads
+  // indexes into kExtensions. Add each known index once.
+  for (uint16_t id : ssl->ctx->extension_order) {
+    size_t j;
+    for (j = 0; j < kNumExtensions; j++) {
+      if (kExtensions[j].value == id) {
+        break;
+      }
+    }
+    if (j == kNumExtensions || seen[j]) {
+      continue;
+    }
+    if (permutation_len >= permutation.size()) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    seen[j] = true;
+    permutation[permutation_len++] = static_cast<uint8_t>(j);
+  }
+
+  // Everything appended after this point belongs to the random suffix. The
+  // helper receives a subspan, so its indexes start at zero.
+  const size_t suffix_offset = permutation_len;
+  for (size_t i = 0; i < kNumExtensions; i++) {
+    if (seen[i]) {
+      continue;
+    }
+    if (permutation_len >= permutation.size()) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    permutation[permutation_len++] = static_cast<uint8_t>(i);
+  }
+
+  // Every kExtensions index must have been written once before the
+  // ClientHello writer uses the permutation.
+  if (permutation_len != permutation.size()) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+  if (!ssl_shuffle_extension_order_suffix(
+          Span(permutation).subspan(suffix_offset))) {
+    return false;
+  }
+
+  hs->extension_permutation = std::move(permutation);
+  return true;
+}
