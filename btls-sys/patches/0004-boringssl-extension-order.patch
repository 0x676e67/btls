+TEST(SSLTest, ExtensionOrderPreservesPrefixAndShufflesRemainder) {
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+
+  // boringssl.patch adds explicit extension ordering. Unknown and duplicate
+  // entries are ignored, while supported unlisted extensions are shuffled.
+  static const uint16_t kExtensionOrder[] = {
+      TLSEXT_TYPE_supported_versions,
+      0xffff,
+      TLSEXT_TYPE_supported_versions,
+      TLSEXT_TYPE_key_share,
+  };
+  static const uint16_t kExpectedPrefix[] = {
+      TLSEXT_TYPE_supported_versions,
+      TLSEXT_TYPE_key_share,
+  };
+  ASSERT_TRUE(SSL_CTX_set_extension_order(
+      ctx.get(), kExtensionOrder,
+      static_cast<int>(std::size(kExtensionOrder))));
+
+  const auto has_expected_prefix = [](const std::vector<uint16_t> &order) {
+    return order.size() >= std::size(kExpectedPrefix) &&
+           std::equal(std::begin(kExpectedPrefix), std::end(kExpectedPrefix),
+                      order.begin());
+  };
+
+  std::vector<uint16_t> first_order;
+  ASSERT_TRUE(GetExtensionOrder(ctx.get(), &first_order, /*ech_keys=*/nullptr,
+                                /*decrypt_ech=*/false));
+  ASSERT_TRUE(has_expected_prefix(first_order));
+  ASSERT_GE(first_order.size(), 5u);
+
+  // As in the upstream permutation test, repeat enough times to make an
+  // unchanged randomized suffix vanishingly unlikely.
+  static const int kNumIterations = 14;
+  bool suffix_changed = false;
+  for (int i = 0; i < kNumIterations; i++) {
+    std::vector<uint16_t> order;
+    ASSERT_TRUE(GetExtensionOrder(ctx.get(), &order, /*ech_keys=*/nullptr,
+                                  /*decrypt_ech=*/false));
+    ASSERT_TRUE(has_expected_prefix(order));
+    if (order != first_order) {
+      suffix_changed = true;
+      break;
+    }
+  }
+  EXPECT_TRUE(suffix_changed) << "Unlisted extensions were not shuffled";
+}
