+int SSL_CTX_set_extension_order(SSL_CTX *ctx, const uint16_t *ids, int num) {
+  Array<uint16_t> order;
+  if (num > 0) {
+    if (!order.Init(num)) {
+      return 0;
+    }
+    for (int i = 0; i < num; i++) {
+      order[i] = ids[i];
+    }
+  }
+  FromOpaque(ctx)->extension_order = std::move(order);
+  return 1;
+}
