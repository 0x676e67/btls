+TEST(ECHGreasePolicyTest, RetryCannotEnablePendingPolicy) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(DTLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  size_t length = 239;
+  ASSERT_TRUE(SSL_set_ech_grease_callback(ssl.get(), FixedLength, &length));
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  auto *hs = FromOpaque(ssl.get())->s3->hs.get();
+  hs->max_version = TLS1_3_VERSION;
+  ASSERT_TRUE(ssl_ech_grease_pending(hs));
+  hs->received_hello_verify_request = true;
+  EXPECT_FALSE(ssl_ech_grease_pending(hs));
+  hs->received_hello_verify_request = false;
+  hs->ssl->s3->used_hello_retry_request = true;
+  EXPECT_FALSE(ssl_ech_grease_pending(hs));
+}
