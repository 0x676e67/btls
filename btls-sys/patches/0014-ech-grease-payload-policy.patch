+BSSL_NAMESPACE_BEGIN
+namespace {
+
+constexpr size_t kEchAeadOffset = 1 + 2;  // Outer type and KDF ID.
+// Outer type, KDF, AEAD, config ID and enc length.
+constexpr size_t kEchEncOffset = 1 + 2 + 2 + 1 + 2;
+// Outer type, KDF, AEAD, config ID, enc length, and X25519 encapsulated key.
+constexpr size_t kEchPayloadLengthOffset = 1 + 2 + 2 + 1 + 2 + 32;
+constexpr size_t kEchBodyFramingLen = kEchPayloadLengthOffset + 2;
+
+static int FixedLength(const SSL_ECH_GREASE_SIZE_INFO *info,
+                       SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+  out->aead_id = info->default_aead_id;
+  out->payload_length = *static_cast<const size_t *>(arg);
+  return 1;
+}
+
+static bool IsGreaseType(uint16_t type) {
+  return (type & 0x0f0f) == 0x0a0a && (type >> 8) == (type & 0xff);
+}
+
+static int QuicSetSecret(SSL *, enum ssl_encryption_level_t, const SSL_CIPHER *,
+                         const uint8_t *, size_t) {
+  return 1;
+}
+
+// QUIC clients hand their ClientHello to the transport instead of a BIO.
+static int QuicAddHandshakeData(SSL *ssl, enum ssl_encryption_level_t,
+                                const uint8_t *data, size_t len) {
+  auto *out = static_cast<std::vector<uint8_t> *>(SSL_get_app_data(ssl));
+  out->insert(out->end(), data, data + len);
+  return 1;
+}
+
+static int QuicFlushFlight(SSL *) { return 1; }
+
+static int QuicSendAlert(SSL *, enum ssl_encryption_level_t, uint8_t) {
+  return 1;
+}
+
+static const SSL_QUIC_METHOD kQuicMethod = {
+    QuicSetSecret,   QuicSetSecret, QuicAddHandshakeData,
+    QuicFlushFlight, QuicSendAlert,
+};
+
+// Returns a client with GREASE enabled and `callback` installed. QUIC clients
+// also need ALPN and transport parameters before their first ClientHello.
+static UniquePtr<SSL> NewClient(SSL_CTX *ctx, SSL_ech_grease_cb callback,
+                                void *arg) {
+  static const uint8_t kAlpn[] = {2, 'h', '3'};
+  static const uint8_t kParams[] = {0};
+  UniquePtr<SSL> ssl(SSL_new(ctx));
+  if (!ssl || !SSL_set_ech_grease_callback(ssl.get(), callback, arg) ||
+      (SSL_is_quic(ssl.get()) &&
+       (SSL_set_alpn_protos(ssl.get(), kAlpn, sizeof(kAlpn)) != 0 ||
+        !SSL_set_quic_transport_params(ssl.get(), kParams, sizeof(kParams))))) {
+    return nullptr;
+  }
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  return ssl;
+}
+
+// Collect all records so near-limit ClientHellos may span record boundaries.
+static bool GetHello(SSL *ssl, Array<uint8_t> *out, int *reason = nullptr,
+                     std::string *error_data = nullptr) {
+  std::vector<uint8_t> quic;
+  UniquePtr<BIO> bio;
+  if (SSL_is_quic(ssl)) {
+    SSL_set_app_data(ssl, &quic);
+  } else {
+    bio.reset(BIO_new(BIO_s_mem()));
+    if (!bio || !BIO_up_ref(bio.get())) {
+      return false;
+    }
+    SSL_set_bio(ssl, nullptr, bio.get());
+  }
+  SSL_connect(ssl);
+  if (reason != nullptr) {
+    const char *data;
+    int flags;
+    *reason = ERR_GET_REASON(
+        ERR_peek_last_error_line_data(nullptr, nullptr, &data, &flags));
+    if (error_data != nullptr) {
+      *error_data = (flags & ERR_FLAG_STRING) ? data : "";
+    }
+  }
+  ERR_clear_error();
+  if (SSL_is_quic(ssl)) {
+    SSL_set_app_data(ssl, nullptr);
+    return !quic.empty() && out->CopyFrom(quic);
+  }
+  const uint8_t *data;
+  size_t length;
+  if (!BIO_mem_contents(bio.get(), &data, &length) || length == 0) {
+    return false;
+  }
+  CBS records(Span(data, length)), record;
+  ScopedCBB hello;
+  if (!CBB_init(hello.get(), 256)) {
+    return false;
+  }
+  while (CBS_len(&records) != 0) {
+    uint8_t type;
+    if (!CBS_get_u8(&records, &type) || type != SSL3_RT_HANDSHAKE ||
+        !CBS_skip(&records, 2) ||
+        !CBS_get_u16_length_prefixed(&records, &record) ||
+        !CBB_add_bytes(hello.get(), CBS_data(&record), CBS_len(&record))) {
+      return false;
+    }
+  }
+  return CBBFinishArray(hello.get(), out);
+}
+
+// Writes the first ClientHello of `ssl` and returns its GREASE ECH body.
+static bool GetGreaseExtension(SSL *ssl, std::vector<uint8_t> *out) {
+  Array<uint8_t> hello;
+  if (!GetHello(ssl, &hello) || hello.size() < SSL3_HM_HEADER_LENGTH) {
+    return false;
+  }
+  SSL_CLIENT_HELLO parsed;
+  const uint8_t *ech;
+  size_t length;
+  if (!SSL_parse_client_hello(ssl, &parsed,
+                              hello.data() + SSL3_HM_HEADER_LENGTH,
+                              hello.size() - SSL3_HM_HEADER_LENGTH) ||
+      !SSL_early_callback_ctx_extension_get(
+          &parsed, TLSEXT_TYPE_encrypted_client_hello, &ech, &length)) {
+    return false;
+  }
+  out->assign(ech, ech + length);
+  return true;
+}
+
+static int RandomEnc(const SSL_ECH_GREASE_SIZE_INFO *info,
+                     SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+  out->aead_id = info->default_aead_id;
+  out->payload_length = 239;
+  out->random_enc = *static_cast<const int *>(arg);
+  return 1;
+}
+
+// A canonical X25519 public key always has bit 255 clear. NSS sends uniformly
+// random bytes, so the opt-in must set that bit in about half of the hellos.
+TEST(ECHGreasePolicyTest, RandomEncSetsHighBit) {
+  constexpr size_t kRounds = 64;
+  for (int random_enc : {0, 1}) {
+    SCOPED_TRACE(random_enc);
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    size_t high_bits = 0;
+    for (size_t i = 0; i < kRounds; i++) {
+      UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+      ASSERT_TRUE(ssl);
+      SSL_set_enable_ech_grease(ssl.get(), 1);
+      ASSERT_TRUE(
+          SSL_set_ech_grease_callback(ssl.get(), RandomEnc, &random_enc));
+      std::vector<uint8_t> ech;
+      ASSERT_TRUE(GetGreaseExtension(ssl.get(), &ech));
+      ASSERT_EQ(ech.size(), 239 + kEchBodyFramingLen);
+      high_bits += (ech[kEchEncOffset + 31] & 0x80) != 0;
+    }
+    if (random_enc) {
+      // Seeing only one bit value has probability 2^-63.
+      EXPECT_GT(high_bits, 0u);
+      EXPECT_LT(high_bits, kRounds);
+    } else {
+      EXPECT_EQ(high_bits, 0u);
+    }
+  }
+}
+
+TEST(ECHGreasePolicyTest, WireLengthAndPolicyLock) {
+  size_t requested = 239;
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  ASSERT_TRUE(SSL_CTX_set1_curves_list(ctx.get(), "X25519"));
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  ASSERT_TRUE(SSL_set_ech_grease_callback(ssl.get(), FixedLength, &requested));
+  Array<uint8_t> hello;
+  ASSERT_TRUE(GetHello(ssl.get(), &hello));
+  ASSERT_GE(hello.size(), size_t{SSL3_HM_HEADER_LENGTH});
+  SSL_CLIENT_HELLO parsed;
+  ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed,
+                                     hello.data() + SSL3_HM_HEADER_LENGTH,
+                                     hello.size() - SSL3_HM_HEADER_LENGTH));
+  const uint8_t *ech;
+  size_t length;
+  ASSERT_TRUE(SSL_early_callback_ctx_extension_get(
+      &parsed, TLSEXT_TYPE_encrypted_client_hello, &ech, &length));
+  ASSERT_EQ(length, requested + kEchBodyFramingLen);
+  EXPECT_EQ((size_t{ech[kEchPayloadLengthOffset]} << 8) |
+                ech[kEchPayloadLengthOffset + 1],
+            requested);
+  EXPECT_FALSE(SSL_set_ech_grease_callback(ssl.get(), nullptr, nullptr));
+  EXPECT_EQ(ERR_GET_REASON(ERR_peek_last_error()),
+            ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+  ERR_clear_error();
+  ASSERT_TRUE(SSL_clear(ssl.get()));
+  EXPECT_TRUE(SSL_set_ech_grease_callback(ssl.get(), nullptr, nullptr));
+}
+
+TEST(ECHGreasePolicyTest, RejectsCallbackOverflowAndFailure) {
+  for (int failure = 0; failure < 8; failure++) {
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    ASSERT_TRUE(SSL_set_ech_grease_callback(
+        ssl.get(),
+        [](const SSL_ECH_GREASE_SIZE_INFO *info, SSL_ECH_GREASE_PARAMETERS *out,
+           void *arg) {
+          EXPECT_GT(info->num_extensions, size_t{0});
+          EXPECT_GT(info->cipher_suites_length, size_t{0});
+          EXPECT_LT(info->max_payload_length, UINT16_MAX - kEchBodyFramingLen);
+          out->aead_id = info->default_aead_id;
+          switch (*static_cast<int *>(arg)) {
+            case 0:
+              out->payload_length = info->max_payload_length + 1;
+              break;
+            case 1:
+              out->payload_length = 0;
+              break;
+            case 2:
+              out->payload_length = SIZE_MAX;
+              break;
+            case 3:
+              return 0;
+            case 4:
+              return 1;  // Success without writing a length is invalid.
+            case 5:
+              out->aead_id = 0;
+              out->payload_length = 239;
+              break;
+            case 6:
+              out->aead_id = 2;  // AES-256-GCM is not a supported GREASE AEAD.
+              out->payload_length = 239;
+              break;
+            case 7:
+              out->aead_id = UINT16_MAX;
+              out->payload_length = 239;
+              break;
+          }
+          return 1;
+        },
+        &failure));
+    Array<uint8_t> hello;
+    int reason = 0;
+    std::string data;
+    EXPECT_FALSE(GetHello(ssl.get(), &hello, &reason, &data));
+    EXPECT_EQ(reason, failure == 3   ? SSL_R_BAD_DATA_RETURNED_BY_CALLBACK
+                      : failure >= 5 ? SSL_R_UNKNOWN_CIPHER_TYPE
+                                     : SSL_R_BAD_LENGTH);
+    // The error data names the rejected value.
+    EXPECT_NE(data.find(failure == 3   ? "ECH GREASE policy"
+                        : failure >= 5 ? "ECH GREASE AEAD"
+                                       : "ECH GREASE payload"),
+              std::string::npos)
+        << data;
+    if (failure == 6) {
+      EXPECT_NE(data.find("AEAD 2"), std::string::npos) << data;
+    }
+  }
+}
+
+// Extension types on the wire, excluding padding and, unless `keep_grease`,
+// RFC 8701 GREASE.
+static void CaptureOrder(SSL_CTX *ctx, bool keep_grease,
+                         std::vector<uint16_t> *order) {
+  size_t length = 239;
+  UniquePtr<SSL> ssl = NewClient(ctx, FixedLength, &length);
+  ASSERT_TRUE(ssl);
+  Array<uint8_t> hello;
+  ASSERT_TRUE(GetHello(ssl.get(), &hello));
+  ASSERT_GE(hello.size(), size_t{SSL3_HM_HEADER_LENGTH});
+  SSL_CLIENT_HELLO parsed;
+  ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed,
+                                     hello.data() + SSL3_HM_HEADER_LENGTH,
+                                     hello.size() - SSL3_HM_HEADER_LENGTH));
+  CBS extensions(Span(parsed.extensions, parsed.extensions_len)), body;
+  while (CBS_len(&extensions) != 0) {
+    uint16_t type;
+    ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &body));
+    if (type != TLSEXT_TYPE_padding && (keep_grease || !IsGreaseType(type))) {
+      order->push_back(type);
+    }
+  }
+}
+
+// Lists every extension ID, ECH second to last and the empty
+// signed_certificate_timestamp last, so TLS reserves the WebSphere padding.
+// Unlisted extensions would trail in random order, and upstream clears
+// `last_was_empty` after an extension that writes nothing.
+static void OrderWithEmptyLast(SSL_CTX *ctx) {
+  SSL_CTX_enable_signed_cert_timestamps(ctx);
+  std::vector<uint16_t> order;
+  for (uint32_t id = 0; id <= UINT16_MAX; id++) {
+    if (id != TLSEXT_TYPE_encrypted_client_hello &&
+        id != TLSEXT_TYPE_certificate_timestamp) {
+      order.push_back(static_cast<uint16_t>(id));
+    }
+  }
+  order.push_back(TLSEXT_TYPE_encrypted_client_hello);
+  order.push_back(TLSEXT_TYPE_certificate_timestamp);
+  ASSERT_TRUE(SSL_CTX_set_extension_order(ctx, order.data(),
+                                          static_cast<int>(order.size())));
+}
+
+struct SizeReport {
+  size_t max = 0, message = 0, preamble = 0, others = 0;
+  int is_quic = 0;
+  size_t payload = 0;  // Zero requests `max_payload_length`.
+};
+
+static int ReportSizes(const SSL_ECH_GREASE_SIZE_INFO *info,
+                       SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+  auto *report = static_cast<SizeReport *>(arg);
+  report->max = info->max_payload_length;
+  report->message = info->message_length;
+  report->preamble = info->preamble_length;
+  report->is_quic = info->is_quic;
+  report->others = 0;
+  for (size_t i = 0; i < info->num_extensions; i++) {
+    report->others += 4 + info->extensions[i].length;
+  }
+  out->aead_id = info->default_aead_id;
+  out->payload_length =
+      report->payload == 0 ? info->max_payload_length : report->payload;
+  return 1;
+}
+
+// Parses `hello`, returning the type and body length of its last extension and
+// the GREASE payload length.
+static void ParseTail(SSL *ssl, const Array<uint8_t> &hello,
+                      SSL_CLIENT_HELLO *parsed, uint16_t *last_type,
+                      size_t *last_length, size_t *payload_length) {
+  ASSERT_GE(hello.size(), size_t{SSL3_HM_HEADER_LENGTH});
+  ASSERT_TRUE(SSL_parse_client_hello(ssl, parsed,
+                                     hello.data() + SSL3_HM_HEADER_LENGTH,
+                                     hello.size() - SSL3_HM_HEADER_LENGTH));
+  CBS extensions(Span(parsed->extensions, parsed->extensions_len)), body;
+  while (CBS_len(&extensions) != 0) {
+    ASSERT_TRUE(CBS_get_u16(&extensions, last_type));
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &body));
+    *last_length = CBS_len(&body);
+  }
+  const uint8_t *ech;
+  size_t length;
+  ASSERT_TRUE(SSL_early_callback_ctx_extension_get(
+      parsed, TLSEXT_TYPE_encrypted_client_hello, &ech, &length));
+  ASSERT_GE(length, kEchBodyFramingLen);
+  *payload_length = (size_t{ech[kEchPayloadLengthOffset]} << 8) |
+                    ech[kEchPayloadLengthOffset + 1];
+  EXPECT_EQ(length, *payload_length + kEchBodyFramingLen);
+}
+
+// `max_payload_length` fills the extensions vector exactly, with the reserved
+// padding spent when the last extension is empty.
+TEST(ECHGreasePolicyTest, ExactMaximumFillsExtensionsVector) {
+  for (bool grease : {false, true}) {
+    SCOPED_TRACE(grease);
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    SSL_CTX_set_grease_enabled(ctx.get(), grease);
+    ASSERT_NO_FATAL_FAILURE(OrderWithEmptyLast(ctx.get()));
+    SizeReport report;
+    UniquePtr<SSL> ssl = NewClient(ctx.get(), ReportSizes, &report);
+    ASSERT_TRUE(ssl);
+    Array<uint8_t> hello;
+    ASSERT_TRUE(GetHello(ssl.get(), &hello));
+    SSL_CLIENT_HELLO parsed;
+    uint16_t last_type = 0;
+    size_t last_length = 0, payload_length = 0;
+    ASSERT_NO_FATAL_FAILURE(ParseTail(ssl.get(), hello, &parsed, &last_type,
+                                      &last_length, &payload_length));
+    // GREASE appends a non-empty extension, so nothing is reserved.
+    const size_t reserve = grease ? 0 : 5;
+    EXPECT_EQ(report.max,
+              UINT16_MAX - 4 - kEchBodyFramingLen - report.others - reserve);
+    EXPECT_EQ(payload_length, report.max);
+    EXPECT_EQ(parsed.extensions_len, size_t{UINT16_MAX});
+    EXPECT_EQ(hello.size() - SSL3_HM_HEADER_LENGTH,
+              report.message + report.max);
+    if (grease) {
+      EXPECT_TRUE(IsGreaseType(last_type));
+    } else {
+      EXPECT_EQ(last_type, TLSEXT_TYPE_padding);
+      EXPECT_EQ(last_length, 1u);
+    }
+  }
+}
+
+// QUIC omits the compatibility session ID and never pads, even after an empty
+// final extension.
+TEST(ECHGreasePolicyTest, QuicReportsBudgetWithoutPadding) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  ASSERT_TRUE(SSL_CTX_set_min_proto_version(ctx.get(), TLS1_3_VERSION));
+  ASSERT_TRUE(SSL_CTX_set_quic_method(ctx.get(), &kQuicMethod));
+  ASSERT_NO_FATAL_FAILURE(OrderWithEmptyLast(ctx.get()));
+  SizeReport report;
+  report.payload = 239;
+  UniquePtr<SSL> ssl = NewClient(ctx.get(), ReportSizes, &report);
+  ASSERT_TRUE(ssl);
+  Array<uint8_t> hello;
+  ASSERT_TRUE(GetHello(ssl.get(), &hello));
+  SSL_CLIENT_HELLO parsed;
+  uint16_t last_type = 0;
+  size_t last_length = 0, payload_length = 0;
+  ASSERT_NO_FATAL_FAILURE(ParseTail(ssl.get(), hello, &parsed, &last_type,
+                                    &last_length, &payload_length));
+  EXPECT_TRUE(report.is_quic);
+  EXPECT_EQ(parsed.session_id_len, 0u);
+  EXPECT_EQ(report.preamble, 2 + 32 + 1 + 2 + parsed.cipher_suites_len + 1 + 1);
+  EXPECT_EQ(report.max, UINT16_MAX - 4 - kEchBodyFramingLen - report.others);
+  EXPECT_EQ(payload_length, 239u);
+  EXPECT_EQ(hello.size() - SSL3_HM_HEADER_LENGTH, report.message + 239);
+  EXPECT_EQ(last_type, TLSEXT_TYPE_certificate_timestamp);
+  EXPECT_EQ(last_length, 0u);
+}
+
+static int Reentrant(const SSL_ECH_GREASE_SIZE_INFO *info,
+                     SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+  // The lock refuses replacement from inside the policy.
+  EXPECT_FALSE(SSL_set_ech_grease_callback(const_cast<SSL *>(info->ssl),
+                                           FixedLength, arg));
+  EXPECT_EQ(ERR_GET_REASON(ERR_peek_last_error()),
+            ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+  ERR_clear_error();
+  return FixedLength(info, out, arg);
+}
+
+// SSL_CB_HANDSHAKE_START precedes the lock, so a policy installed there is the
+// one that runs; the policy itself can no longer change the callback.
+TEST(ECHGreasePolicyTest, LockFollowsHandshakeStart) {
+  static size_t replacement = 300;
+  size_t initial = 239;
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl = NewClient(ctx.get(), FixedLength, &initial);
+  ASSERT_TRUE(ssl);
+  SSL_set_info_callback(ssl.get(), [](const SSL *ssl, int type, int) {
+    if (type == SSL_CB_HANDSHAKE_START) {
+      EXPECT_TRUE(SSL_set_ech_grease_callback(const_cast<SSL *>(ssl), Reentrant,
+                                              &replacement));
+    }
+  });
+  std::vector<uint8_t> ech;
+  ASSERT_TRUE(GetGreaseExtension(ssl.get(), &ech));
+  EXPECT_EQ(ech.size(), replacement + kEchBodyFramingLen);
+}
+
+// A rejected policy keeps the lock until SSL_clear starts over.
+TEST(ECHGreasePolicyTest, ClearRecoversFromRejectedPolicy) {
+  size_t length = SIZE_MAX;
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl = NewClient(ctx.get(), FixedLength, &length);
+  ASSERT_TRUE(ssl);
+  Array<uint8_t> hello;
+  int reason = 0;
+  EXPECT_FALSE(GetHello(ssl.get(), &hello, &reason));
+  EXPECT_EQ(reason, SSL_R_BAD_LENGTH);
+  EXPECT_FALSE(SSL_set_ech_grease_callback(ssl.get(), nullptr, nullptr));
+  ERR_clear_error();
+  ASSERT_TRUE(SSL_clear(ssl.get()));
+  length = 239;
+  ASSERT_TRUE(SSL_set_ech_grease_callback(ssl.get(), FixedLength, &length));
+  std::vector<uint8_t> ech;
+  ASSERT_TRUE(GetGreaseExtension(ssl.get(), &ech));
+  EXPECT_EQ(ech.size(), length + kEchBodyFramingLen);
+}
+
+TEST(ECHGreasePolicyTest, PreservesExplicitExtensionPosition) {
+  for (bool grease : {false, true}) {
+    SCOPED_TRACE(grease);
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    SSL_CTX_set_grease_enabled(ctx.get(), grease);
+    std::vector<uint16_t> others;
+    ASSERT_NO_FATAL_FAILURE(
+        CaptureOrder(ctx.get(), /*keep_grease=*/false, &others));
+    const auto ech = std::find(others.begin(), others.end(),
+                               TLSEXT_TYPE_encrypted_client_hello);
+    ASSERT_NE(ech, others.end());
+    others.erase(ech);
+    // Derive the inventory from a real hello, not a copy of upstream's table.
+    for (size_t position : {size_t{0}, others.size() / 2, others.size()}) {
+      auto expected = others;
+      expected.insert(expected.begin() + position,
+                      TLSEXT_TYPE_encrypted_client_hello);
+      ASSERT_TRUE(SSL_CTX_set_extension_order(ctx.get(), expected.data(),
+                                              expected.size()));
+      std::vector<uint16_t> actual;
+      ASSERT_NO_FATAL_FAILURE(
+          CaptureOrder(ctx.get(), /*keep_grease=*/true, &actual));
+      if (grease) {
+        // RFC 8701 GREASE brackets the configured order, so even an ECH listed
+        // last precedes the trailing GREASE extension.
+        ASSERT_GE(actual.size(), 2u);
+        EXPECT_TRUE(IsGreaseType(actual.front()));
+        EXPECT_TRUE(IsGreaseType(actual.back()));
+        actual.erase(actual.begin());
+        actual.pop_back();
+      }
+      EXPECT_EQ(actual, expected);
+    }
+  }
+}
+
+class ECHGreaseHandshakeTest : public testing::Test {
+ protected:
+  void Init(bool dtls = false) {
+    client_ctx.reset(SSL_CTX_new(dtls ? DTLS_method() : TLS_method()));
+    server_ctx.reset(SSL_CTX_new(dtls ? DTLS_method() : TLS_method()));
+    ASSERT_TRUE(client_ctx);
+    ASSERT_TRUE(server_ctx);
+    const uint16_t version = dtls ? DTLS1_3_VERSION : TLS1_3_VERSION;
+    ASSERT_TRUE(SSL_CTX_set_min_proto_version(client_ctx.get(), version));
+    ASSERT_TRUE(SSL_CTX_set_min_proto_version(server_ctx.get(), version));
+    const uint16_t sigalg = SSL_SIGN_ED25519;
+    ASSERT_TRUE(
+        SSL_CTX_set_verify_algorithm_prefs(client_ctx.get(), &sigalg, 1));
+    const uint8_t seed[32] = {};
+    UniquePtr<EVP_PKEY> key(EVP_PKEY_new_raw_private_key(
+        EVP_PKEY_ED25519, nullptr, seed, sizeof(seed)));
+    UniquePtr<X509> cert(X509_new());
+    ASSERT_TRUE(key);
+    ASSERT_TRUE(cert);
+    ASSERT_TRUE(X509_set_version(cert.get(), 2));
+    ASSERT_TRUE(ASN1_INTEGER_set(X509_get_serialNumber(cert.get()), 1));
+    ASSERT_TRUE(X509_gmtime_adj(X509_getm_notBefore(cert.get()), -60));
+    ASSERT_TRUE(X509_gmtime_adj(X509_getm_notAfter(cert.get()), 86400));
+    ASSERT_TRUE(X509_set_pubkey(cert.get(), key.get()));
+    ASSERT_TRUE(X509_sign(cert.get(), key.get(), nullptr));
+    ASSERT_TRUE(SSL_CTX_use_certificate(server_ctx.get(), cert.get()));
+    ASSERT_TRUE(SSL_CTX_use_PrivateKey(server_ctx.get(), key.get()));
+    SSL_CTX_set_session_cache_mode(client_ctx.get(), SSL_SESS_CACHE_CLIENT);
+    SSL_CTX_sess_set_new_cb(client_ctx.get(), [](SSL *ssl,
+                                                 SSL_SESSION *session) {
+      auto *self = static_cast<ECHGreaseHandshakeTest *>(SSL_get_app_data(ssl));
+      self->session.reset(session);
+      return 1;
+    });
+    SSL_CTX_set_ech_grease_callback(client_ctx.get(), Policy, this);
+  }
+
+  void SetServerEchKeys(std::vector<uint8_t> *retry_configs) {
+    ScopedEVP_HPKE_KEY key;
+    ASSERT_TRUE(
+        EVP_HPKE_KEY_generate(key.get(), EVP_hpke_x25519_hkdf_sha256()));
+    uint8_t *config;
+    size_t config_len;
+    ASSERT_TRUE(SSL_marshal_ech_config(&config, &config_len, 1, key.get(),
+                                       "public.example", 16));
+    UniquePtr<uint8_t> free_config(config);
+    UniquePtr<SSL_ECH_KEYS> keys(SSL_ECH_KEYS_new());
+    ASSERT_TRUE(keys);
+    ASSERT_TRUE(SSL_ECH_KEYS_add(keys.get(), 1, config, config_len, key.get()));
+    ASSERT_TRUE(SSL_CTX_set1_ech_keys(server_ctx.get(), keys.get()));
+    uint8_t *list;
+    size_t list_len;
+    ASSERT_TRUE(
+        SSL_ECH_KEYS_marshal_retry_configs(keys.get(), &list, &list_len));
+    UniquePtr<uint8_t> free_list(list);
+    retry_configs->assign(list, list + list_len);
+  }
+
+  void NewPair() {
+    hellos.clear();
+    calls = 0;
+    psk_length = 0;
+    saw_retry_configs = false;
+    saw_early_data = false;
+    client.reset(SSL_new(client_ctx.get()));
+    server.reset(SSL_new(server_ctx.get()));
+    ASSERT_TRUE(client);
+    ASSERT_TRUE(server);
+    BIO *a, *b;
+    ASSERT_TRUE(BIO_new_bio_pair(&a, 0, &b, 0));
+    SSL_set_bio(client.get(), a, a);
+    SSL_set_bio(server.get(), b, b);
+    SSL_set_connect_state(client.get());
+    SSL_set_accept_state(server.get());
+    SSL_set_enable_ech_grease(client.get(), 1);
+    SSL_set_app_data(client.get(), this);
+    // DTLS receive callbacks expose complete messages, not outgoing fragments.
+    SSL_set_msg_callback(server.get(), CaptureHello);
+    SSL_set_msg_callback_arg(server.get(), this);
+  }
+
+  bool Handshake() {
+    for (size_t i = 0; i < 100; i++) {
+      bool done = true;
+      for (SSL *ssl : {client.get(), server.get()}) {
+        const int ret = SSL_do_handshake(ssl);
+        if (ret != 1) {
+          const int error = SSL_get_error(ssl, ret);
+          if (error != SSL_ERROR_WANT_READ && error != SSL_ERROR_WANT_WRITE) {
+            return false;
+          }
+          done = false;
+        } else if (ssl == client.get() && SSL_in_early_data(ssl)) {
+          // A 0-RTT client returns early; a server completes on SSL_read.
+          done = false;
+        }
+      }
+      if (done) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Exchange() {
+    // Reading application data also processes the TLS 1.3 session tickets.
+    ASSERT_EQ(SSL_write(server.get(), "test", 4), 4);
+    char received[4];
+    ASSERT_EQ(SSL_read(client.get(), received, sizeof(received)), 4);
+    EXPECT_EQ(std::string(received, sizeof(received)), "test");
+  }
+
+  static int Policy(const SSL_ECH_GREASE_SIZE_INFO *info,
+                    SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+    auto *self = static_cast<ECHGreaseHandshakeTest *>(arg);
+    EXPECT_EQ(info->ssl, self->client.get());
+    EXPECT_EQ(info->is_dtls, SSL_is_dtls(info->ssl));
+    EXPECT_GT(info->preamble_length, info->cipher_suites_length);
+    self->calls++;
+    self->psk_length = info->psk_extension_length;
+    for (size_t i = 0; i < info->num_extensions; i++) {
+      self->saw_early_data |=
+          info->extensions[i].type == TLSEXT_TYPE_early_data;
+    }
+    out->aead_id = EVP_HPKE_CHACHA20_POLY1305;
+    out->payload_length = 4096;
+    out->random_enc = self->random_enc;
+    return 1;
+  }
+
+  static void CaptureHello(int write, int, int content_type, const void *data,
+                           size_t len, SSL *ssl, void *arg) {
+    const auto bytes = Span(static_cast<const uint8_t *>(data), len);
+    if (write || content_type != SSL3_RT_HANDSHAKE || bytes.empty() ||
+        bytes[0] != SSL3_MT_CLIENT_HELLO) {
+      return;
+    }
+    auto *self = static_cast<ECHGreaseHandshakeTest *>(arg);
+    const size_t header =
+        SSL_is_dtls(ssl) ? DTLS1_HM_HEADER_LENGTH : SSL3_HM_HEADER_LENGTH;
+    ASSERT_GE(len, header);
+    SSL_CLIENT_HELLO hello;
+    ASSERT_TRUE(SSL_parse_client_hello(ssl, &hello, bytes.data() + header,
+                                       len - header));
+    const uint8_t *ech;
+    size_t ech_len;
+    if (SSL_early_callback_ctx_extension_get(
+            &hello, TLSEXT_TYPE_encrypted_client_hello, &ech, &ech_len)) {
+      self->hellos.emplace_back(ech, ech + ech_len);
+    } else {
+      self->hellos.emplace_back();
+    }
+  }
+
+  static void CaptureRetryConfigs(int write, int, int content_type,
+                                  const void *data, size_t len, SSL *,
+                                  void *arg) {
+    const auto bytes = Span(static_cast<const uint8_t *>(data), len);
+    if (write || content_type != SSL3_RT_HANDSHAKE || bytes.empty() ||
+        bytes[0] != SSL3_MT_ENCRYPTED_EXTENSIONS) {
+      return;
+    }
+    ASSERT_GE(len, size_t{SSL3_HM_HEADER_LENGTH});
+    CBS body(bytes.subspan(SSL3_HM_HEADER_LENGTH)), extensions;
+    ASSERT_TRUE(CBS_get_u16_length_prefixed(&body, &extensions));
+    while (CBS_len(&extensions) != 0) {
+      uint16_t type;
+      CBS contents;
+      ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+      ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &contents));
+      if (type == TLSEXT_TYPE_encrypted_client_hello) {
+        static_cast<ECHGreaseHandshakeTest *>(arg)->saw_retry_configs = true;
+      }
+    }
+  }
+
+  UniquePtr<SSL_CTX> client_ctx, server_ctx;
+  UniquePtr<SSL> client, server;
+  UniquePtr<SSL_SESSION> session;
+  std::vector<std::vector<uint8_t>> hellos;
+  size_t calls = 0, psk_length = 0;
+  bool saw_retry_configs = false;
+  bool saw_early_data = false;
+  bool random_enc = false;
+};
+
+TEST_F(ECHGreaseHandshakeTest, PracticalLengthSurvivesHRRAndDTLS) {
+  for (bool dtls : {false, true}) {
+    for (bool hrr : {false, true}) {
+      for (bool random : {false, true}) {
+        SCOPED_TRACE(dtls);
+        SCOPED_TRACE(hrr);
+        SCOPED_TRACE(random);
+        ASSERT_NO_FATAL_FAILURE(Init(dtls));
+        random_enc = random;
+        ASSERT_TRUE(SSL_CTX_set1_curves_list(client_ctx.get(), "X25519:P-384"));
+        ASSERT_TRUE(SSL_CTX_set1_curves_list(server_ctx.get(),
+                                             hrr ? "P-384" : "X25519"));
+        ASSERT_NO_FATAL_FAILURE(NewPair());
+        ASSERT_TRUE(Handshake());
+        EXPECT_EQ(calls, size_t{1});
+        ASSERT_EQ(hellos.size(), hrr ? size_t{2} : size_t{1});
+        ASSERT_EQ(hellos[0].size(), 4096 + kEchBodyFramingLen);
+        EXPECT_EQ(hellos[0][kEchAeadOffset], 0);
+        EXPECT_EQ(hellos[0][kEchAeadOffset + 1], EVP_HPKE_CHACHA20_POLY1305);
+        if (hrr) {
+          EXPECT_EQ(hellos[0], hellos[1]);
+        }
+        ASSERT_NO_FATAL_FAILURE(Exchange());
+      }
+    }
+  }
+}
+
+TEST_F(ECHGreaseHandshakeTest, ResumptionKeepsBinderValid) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(Handshake());
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_is_resumable(session.get()));
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set_session(client.get(), session.get()));
+  ASSERT_TRUE(Handshake());
+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_EQ(calls, size_t{1});
+  EXPECT_GT(psk_length, size_t{0});
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
+
+// 0-RTT resumption lists early_data among the extensions alongside the PSK.
+TEST_F(ECHGreaseHandshakeTest, EarlyDataAppearsInMetadata) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  SSL_CTX_set_early_data_enabled(client_ctx.get(), 1);
+  SSL_CTX_set_early_data_enabled(server_ctx.get(), 1);
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(Handshake());
+  EXPECT_FALSE(saw_early_data);
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_early_data_capable(session.get()));
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set_session(client.get(), session.get()));
+  // Enter 0-RTT, send one byte of early data, then finish the handshake.
+  ASSERT_EQ(SSL_do_handshake(client.get()), 1);
+  ASSERT_TRUE(SSL_in_early_data(client.get()));
+  ASSERT_EQ(SSL_write(client.get(), "e", 1), 1);
+  ASSERT_TRUE(Handshake());
+  EXPECT_TRUE(SSL_early_data_accepted(client.get()));
+  EXPECT_EQ(calls, size_t{1});
+  EXPECT_TRUE(saw_early_data);
+  EXPECT_GT(psk_length, size_t{0});
+  char early = 0;
+  ASSERT_EQ(SSL_read(server.get(), &early, 1), 1);
+  EXPECT_EQ(early, 'e');
+  // Reading past the early data completes the server's handshake.
+  EXPECT_EQ(SSL_read(server.get(), &early, 1), -1);
+  EXPECT_EQ(SSL_get_error(server.get(), -1), SSL_ERROR_WANT_READ);
+  EXPECT_FALSE(SSL_in_early_data(server.get()));
+  EXPECT_TRUE(SSL_early_data_accepted(server.get()));
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
