+static int FixedLength(const SSL_ECH_GREASE_SIZE_INFO *info,
+                       SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+  out->aead_id = info->default_aead_id;
+  out->payload_length = *static_cast<const size_t *>(arg);
+  return 1;
+}
+
+// Collect all records so near-limit ClientHellos may span record boundaries.
+static bool GetHello(SSL *ssl, Array<uint8_t> *out, int *reason = nullptr) {
+  UniquePtr<BIO> bio(BIO_new(BIO_s_mem()));
+  if (!bio || !BIO_up_ref(bio.get())) {
+    return false;
+  }
+  SSL_set_bio(ssl, nullptr, bio.get());
+  SSL_connect(ssl);
+  if (reason != nullptr) {
+    *reason = ERR_GET_REASON(ERR_peek_last_error());
+  }
+  ERR_clear_error();
+  const uint8_t *data;
+  size_t length;
+  if (!BIO_mem_contents(bio.get(), &data, &length) || length == 0) {
+    return false;
+  }
+  CBS records(Span(data, length)), record;
+  ScopedCBB hello;
+  if (!CBB_init(hello.get(), 256)) {
+    return false;
+  }
+  while (CBS_len(&records) != 0) {
+    uint8_t type;
+    if (!CBS_get_u8(&records, &type) || type != SSL3_RT_HANDSHAKE ||
+        !CBS_skip(&records, 2) ||
+        !CBS_get_u16_length_prefixed(&records, &record) ||
+        !CBB_add_bytes(hello.get(), CBS_data(&record), CBS_len(&record))) {
+      return false;
+    }
+  }
+  return CBBFinishArray(hello.get(), out);
+}
+
+TEST(ECHGreasePolicyTest, WireLengthAndTotalBudget) {
+  for (size_t requested : {size_t{239}}) {
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    ASSERT_TRUE(SSL_CTX_set1_curves_list(ctx.get(), "X25519"));
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    ASSERT_TRUE(
+        SSL_set_ech_grease_callback(ssl.get(), FixedLength, &requested));
+    Array<uint8_t> hello;
+    ASSERT_TRUE(GetHello(ssl.get(), &hello));
+    ASSERT_GE(hello.size(), size_t{4});
+    SSL_CLIENT_HELLO parsed;
+    ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed, hello.data() + 4,
+                                       hello.size() - 4));
+    const uint8_t *ech;
+    size_t length;
+    ASSERT_TRUE(SSL_early_callback_ctx_extension_get(
+        &parsed, TLSEXT_TYPE_encrypted_client_hello, &ech, &length));
+    ASSERT_EQ(length, requested + 42);
+    EXPECT_EQ((size_t{ech[40]} << 8) | ech[41], requested);
+    EXPECT_FALSE(SSL_set_ech_grease_callback(ssl.get(), nullptr, nullptr));
+    ERR_clear_error();
+  }
+}
+
+TEST(ECHGreasePolicyTest, RejectsCallbackOverflowAndFailure) {
+  for (int failure = 0; failure < 8; failure++) {
+    UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+    ASSERT_TRUE(ctx);
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    ASSERT_TRUE(SSL_set_ech_grease_callback(
+        ssl.get(),
+        [](const SSL_ECH_GREASE_SIZE_INFO *info, SSL_ECH_GREASE_PARAMETERS *out,
+           void *arg) {
+          EXPECT_GT(info->num_extensions, size_t{0});
+          EXPECT_GT(info->cipher_suites_length, size_t{0});
+          EXPECT_LT(info->max_payload_length, size_t{UINT16_MAX - 42});
+          out->aead_id = info->default_aead_id;
+          switch (*static_cast<int *>(arg)) {
+            case 0:
+              out->payload_length = info->max_payload_length + 1;
+              break;
+            case 1:
+              out->payload_length = 0;
+              break;
+            case 2:
+              out->payload_length = SIZE_MAX;
+              break;
+            case 3:
+              return 0;
+            case 4:
+              return 1;  // Success without writing a length is invalid.
+            case 5:
+              out->aead_id = 0;
+              out->payload_length = 239;
+              break;
+            case 6:
+              out->aead_id = 2;  // AES-256-GCM is not a supported GREASE AEAD.
+              out->payload_length = 239;
+              break;
+            case 7:
+              out->aead_id = UINT16_MAX;
+              out->payload_length = 239;
+              break;
+          }
+          return 1;
+        },
+        &failure));
+    Array<uint8_t> hello;
+    int reason = 0;
+    EXPECT_FALSE(GetHello(ssl.get(), &hello, &reason));
+    EXPECT_EQ(reason, failure == 3   ? SSL_R_BAD_DATA_RETURNED_BY_CALLBACK
+                      : failure >= 5 ? SSL_R_UNKNOWN_CIPHER_TYPE
+                                     : SSL_R_BAD_LENGTH);
+  }
+}
+
+TEST(ECHGreasePolicyTest, PreservesExplicitExtensionPosition) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  const auto capture = [&](std::vector<uint16_t> *order) {
+    UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+    ASSERT_TRUE(ssl);
+    SSL_set_enable_ech_grease(ssl.get(), 1);
+    size_t length = 239;
+    ASSERT_TRUE(SSL_set_ech_grease_callback(ssl.get(), FixedLength, &length));
+    Array<uint8_t> hello;
+    ASSERT_TRUE(GetHello(ssl.get(), &hello));
+    ASSERT_GE(hello.size(), size_t{4});
+    SSL_CLIENT_HELLO parsed;
+    ASSERT_TRUE(SSL_parse_client_hello(ssl.get(), &parsed, hello.data() + 4,
+                                       hello.size() - 4));
+    CBS extensions(Span(parsed.extensions, parsed.extensions_len)), body;
+    while (CBS_len(&extensions) != 0) {
+      uint16_t type;
+      ASSERT_TRUE(CBS_get_u16(&extensions, &type));
+      ASSERT_TRUE(CBS_get_u16_length_prefixed(&extensions, &body));
+      if (type != TLSEXT_TYPE_padding) {
+        order->push_back(type);
+      }
+    }
+  };
+  std::vector<uint16_t> others;
+  ASSERT_NO_FATAL_FAILURE(capture(&others));
+  const auto ech = std::find(others.begin(), others.end(),
+                             TLSEXT_TYPE_encrypted_client_hello);
+  ASSERT_NE(ech, others.end());
+  others.erase(ech);
+  // Derive the inventory from a real hello, not a copy of upstream's table.
+  for (size_t position : {size_t{0}, others.size() / 2, others.size()}) {
+    auto expected = others;
+    expected.insert(expected.begin() + position,
+                    TLSEXT_TYPE_encrypted_client_hello);
+    ASSERT_TRUE(SSL_CTX_set_extension_order(ctx.get(), expected.data(),
+                                            expected.size()));
+    std::vector<uint16_t> actual;
+    ASSERT_NO_FATAL_FAILURE(capture(&actual));
+    EXPECT_EQ(actual, expected);
+  }
+}
+
+class ECHGreaseHandshakeTest : public testing::Test {
+ protected:
+  void Init(bool dtls = false) {
+    client_ctx.reset(SSL_CTX_new(dtls ? DTLS_method() : TLS_method()));
+    server_ctx.reset(SSL_CTX_new(dtls ? DTLS_method() : TLS_method()));
+    ASSERT_TRUE(client_ctx);
+    ASSERT_TRUE(server_ctx);
+    const uint16_t version = dtls ? DTLS1_3_VERSION : TLS1_3_VERSION;
+    ASSERT_TRUE(SSL_CTX_set_min_proto_version(client_ctx.get(), version));
+    ASSERT_TRUE(SSL_CTX_set_min_proto_version(server_ctx.get(), version));
+    const uint16_t sigalg = SSL_SIGN_ED25519;
+    ASSERT_TRUE(SSL_CTX_set_verify_algorithm_prefs(client_ctx.get(), &sigalg, 1));
+    const uint8_t seed[32] = {};
+    UniquePtr<EVP_PKEY> key(EVP_PKEY_new_raw_private_key(
+        EVP_PKEY_ED25519, nullptr, seed, sizeof(seed)));
+    UniquePtr<X509> cert(X509_new());
+    ASSERT_TRUE(key);
+    ASSERT_TRUE(cert);
+    ASSERT_TRUE(X509_set_version(cert.get(), 2));
+    ASSERT_TRUE(ASN1_INTEGER_set(X509_get_serialNumber(cert.get()), 1));
+    ASSERT_TRUE(X509_gmtime_adj(X509_getm_notBefore(cert.get()), -60));
+    ASSERT_TRUE(X509_gmtime_adj(X509_getm_notAfter(cert.get()), 86400));
+    ASSERT_TRUE(X509_set_pubkey(cert.get(), key.get()));
+    ASSERT_TRUE(X509_sign(cert.get(), key.get(), nullptr));
+    ASSERT_TRUE(SSL_CTX_use_certificate(server_ctx.get(), cert.get()));
+    ASSERT_TRUE(SSL_CTX_use_PrivateKey(server_ctx.get(), key.get()));
+    SSL_CTX_set_session_cache_mode(client_ctx.get(), SSL_SESS_CACHE_CLIENT);
+    SSL_CTX_sess_set_new_cb(client_ctx.get(), [](SSL *ssl, SSL_SESSION *session) {
+      auto *self = static_cast<ECHGreaseHandshakeTest *>(SSL_get_app_data(ssl));
+      self->session.reset(session);
+      return 1;
+    });
+    SSL_CTX_set_ech_grease_callback(client_ctx.get(), Policy, this);
+  }
+
+  void NewPair() {
+    hellos.clear();
+    calls = 0;
+    psk_length = 0;
+    client.reset(SSL_new(client_ctx.get()));
+    server.reset(SSL_new(server_ctx.get()));
+    ASSERT_TRUE(client);
+    ASSERT_TRUE(server);
+    BIO *a, *b;
+    ASSERT_TRUE(BIO_new_bio_pair(&a, 0, &b, 0));
+    SSL_set_bio(client.get(), a, a);
+    SSL_set_bio(server.get(), b, b);
+    SSL_set_connect_state(client.get());
+    SSL_set_accept_state(server.get());
+    SSL_set_enable_ech_grease(client.get(), 1);
+    SSL_set_app_data(client.get(), this);
+    // DTLS receive callbacks expose complete messages, not outgoing fragments.
+    SSL_set_msg_callback(server.get(), CaptureHello);
+    SSL_set_msg_callback_arg(server.get(), this);
+  }
+
+  bool Handshake() {
+    for (size_t i = 0; i < 100; i++) {
+      bool done = true;
+      for (SSL *ssl : {client.get(), server.get()}) {
+        const int ret = SSL_do_handshake(ssl);
+        if (ret != 1) {
+          const int error = SSL_get_error(ssl, ret);
+          if (error != SSL_ERROR_WANT_READ && error != SSL_ERROR_WANT_WRITE) {
+            return false;
+          }
+          done = false;
+        }
+      }
+      if (done) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Exchange() {
+    // Reading application data also processes the TLS 1.3 session tickets.
+    ASSERT_EQ(SSL_write(server.get(), "test", 4), 4);
+    char received[4];
+    ASSERT_EQ(SSL_read(client.get(), received, sizeof(received)), 4);
+    EXPECT_EQ(std::string(received, sizeof(received)), "test");
+  }
+
+  static int Policy(const SSL_ECH_GREASE_SIZE_INFO *info,
+                    SSL_ECH_GREASE_PARAMETERS *out, void *arg) {
+    auto *self = static_cast<ECHGreaseHandshakeTest *>(arg);
+    EXPECT_EQ(info->ssl, self->client.get());
+    EXPECT_EQ(info->is_dtls, SSL_is_dtls(info->ssl));
+    EXPECT_GT(info->preamble_length, info->cipher_suites_length);
+    self->calls++;
+    self->psk_length = info->psk_extension_length;
+    out->aead_id = EVP_HPKE_CHACHA20_POLY1305;
+    out->payload_length = 4096;
+    return 1;
+  }
+
+  static void CaptureHello(int write, int, int content_type, const void *data,
+                           size_t len, SSL *ssl, void *arg) {
+    const auto bytes = Span(static_cast<const uint8_t *>(data), len);
+    if (write || content_type != SSL3_RT_HANDSHAKE || bytes.empty() ||
+        bytes[0] != SSL3_MT_CLIENT_HELLO) {
+      return;
+    }
+    auto *self = static_cast<ECHGreaseHandshakeTest *>(arg);
+    const size_t header =
+        SSL_is_dtls(ssl) ? DTLS1_HM_HEADER_LENGTH : SSL3_HM_HEADER_LENGTH;
+    ASSERT_GE(len, header);
+    SSL_CLIENT_HELLO hello;
+    ASSERT_TRUE(SSL_parse_client_hello(ssl, &hello, bytes.data() + header,
+                                       len - header));
+    const uint8_t *ech;
+    size_t ech_len;
+    if (SSL_early_callback_ctx_extension_get(
+            &hello, TLSEXT_TYPE_encrypted_client_hello, &ech, &ech_len)) {
+      self->hellos.emplace_back(ech, ech + ech_len);
+    } else {
+      self->hellos.emplace_back();
+    }
+  }
+
+  UniquePtr<SSL_CTX> client_ctx, server_ctx;
+  UniquePtr<SSL> client, server;
+  UniquePtr<SSL_SESSION> session;
+  std::vector<std::vector<uint8_t>> hellos;
+  size_t calls = 0, psk_length = 0;
+};
+
+TEST_F(ECHGreaseHandshakeTest, PracticalLengthSurvivesHRRAndDTLS) {
+  for (bool dtls : {false, true}) {
+    for (bool hrr : {false, true}) {
+      SCOPED_TRACE(dtls);
+      SCOPED_TRACE(hrr);
+      ASSERT_NO_FATAL_FAILURE(Init(dtls));
+      ASSERT_TRUE(SSL_CTX_set1_curves_list(client_ctx.get(), "X25519:P-384"));
+      ASSERT_TRUE(
+          SSL_CTX_set1_curves_list(server_ctx.get(), hrr ? "P-384" : "X25519"));
+      ASSERT_NO_FATAL_FAILURE(NewPair());
+      ASSERT_TRUE(Handshake());
+      EXPECT_EQ(calls, size_t{1});
+      ASSERT_EQ(hellos.size(), hrr ? size_t{2} : size_t{1});
+      ASSERT_EQ(hellos[0].size(), size_t{4096 + 42});
+      EXPECT_EQ(hellos[0][3], 0);
+      EXPECT_EQ(hellos[0][4], EVP_HPKE_CHACHA20_POLY1305);
+      if (hrr) {
+        EXPECT_EQ(hellos[0], hellos[1]);
+      }
+      ASSERT_NO_FATAL_FAILURE(Exchange());
+    }
+  }
+}
+
+TEST_F(ECHGreaseHandshakeTest, ResumptionKeepsBinderValid) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(Handshake());
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_is_resumable(session.get()));
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set_session(client.get(), session.get()));
+  ASSERT_TRUE(Handshake());
+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_EQ(calls, size_t{1});
+  EXPECT_GT(psk_length, size_t{0});
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
+
+TEST_F(ECHGreaseHandshakeTest, RealECHSkipsPolicy) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  ScopedEVP_HPKE_KEY key;
+  ASSERT_TRUE(EVP_HPKE_KEY_generate(key.get(), EVP_hpke_x25519_hkdf_sha256()));
+  uint8_t *config;
+  size_t config_len;
+  ASSERT_TRUE(SSL_marshal_ech_config(&config, &config_len, 1, key.get(),
+                                     "public.example", 16));
+  UniquePtr<uint8_t> free_config(config);
+  UniquePtr<SSL_ECH_KEYS> keys(SSL_ECH_KEYS_new());
+  ASSERT_TRUE(keys);
+  ASSERT_TRUE(SSL_ECH_KEYS_add(keys.get(), 1, config, config_len, key.get()));
