 // ECH extension when no supported ECHConfig is available.
 OPENSSL_EXPORT void SSL_set_enable_ech_grease(SSL *ssl, int enable);
 
+// SSL_ECH_GREASE_EXTENSION describes an extension in the first ClientHello.
+struct ssl_ech_grease_extension_st {
+  uint16_t type;
+  size_t length;  // Extension body length, excluding its four-byte header.
+};
+
+// SSL_ECH_GREASE_SIZE_INFO is borrowed for the duration of the callback.
+// `extensions` excludes ECH, padding, and pre_shared_key, but includes RFC 8701
+// GREASE extensions in wire order, after any permutation. Size policies must
+// account for these GREASE entries too. Extension lengths exclude their
+// four-byte headers. `preamble_length` includes the wire session ID and DTLS
+// cookie, but excludes handshake headers and the extensions length prefix.
+struct ssl_ech_grease_size_info_st {
+  const SSL *ssl;
+  const uint8_t *cipher_suites;
+  size_t cipher_suites_length;
+  const SSL_ECH_GREASE_EXTENSION *extensions;
+  size_t num_extensions;
+  size_t preamble_length;
+  size_t psk_extension_length;
+  size_t server_name_length;
+  int has_server_name;
+  int is_dtls;
+  int is_quic;
+  uint16_t default_aead_id;
+  size_t aead_overhead;
+  // CH1's extensions-vector frame budget, not the peer's handshake limit or a
+  // guarantee that CH2 will fit after HRR adds a cookie or a larger key share.
+  size_t max_payload_length;
+};
+
+// SSL_ECH_GREASE_PARAMETERS selects the advertised AEAD, the payload length
+// and the shape of `enc`. `payload_length` includes the simulated AEAD tag, but
+// excludes the encapsulated key and extension framing. A nonzero `random_enc`
+// sends 32 uniformly random bytes as `enc`, as NSS does, instead of the X25519
+// public key RFC 9849 section 6.2 asks for. A canonical X25519 key always has
+// bit 255 clear, so the choice is observable; X25519 accepts either encoding.
+struct ssl_ech_grease_parameters_st {
+  uint16_t aead_id;
+  size_t payload_length;
+  int random_enc;
+};
+
+// SSL_ech_grease_callback returns one on success, zero to fail the handshake.
+// It must set `out->aead_id` to `EVP_HPKE_AES_128_GCM` or
+// `EVP_HPKE_CHACHA20_POLY1305`, and `out->payload_length` to a nonzero value at
+// most `info->max_payload_length`. Both AEADs have the same overhead, exposed
+// in `info->aead_overhead`. `out->random_enc` starts at zero and is optional.
+// Invalid output fails the handshake, without truncation or fallback. Only
+// GREASE parameters change, not TLS cipher preferences or real ECH. BoringSSL
+// still generates the random payload bytes.
+// The callback must not mutate or reenter the SSL. It is called once for the
+// first GREASE ClientHello; HRR reuses the complete extension (RFC 9849 6.2.1).
+// Unlike NSS, this also applies to DTLS when ECH GREASE is enabled.
+typedef int (*SSL_ech_grease_callback)(const SSL_ECH_GREASE_SIZE_INFO *info,
+                                       SSL_ECH_GREASE_PARAMETERS *out,
+                                       void *arg);
+
+// SSL_set_ech_grease_callback sets or replaces the callback for `ssl`,
+// overriding the current SSL_CTX's callback. A null `callback` uses the current
+// context's callback, or upstream defaults if that context has no callback.
+// This does not enable GREASE. `arg` must remain valid until replacement or SSL
+// destruction. Returns one on success, or zero without changing the callback if
+// ClientHello has started, the handshake has finished, or the config has been
+// shed. After a successful `SSL_clear`, the callback may be set again before
+// ClientHello.
+OPENSSL_EXPORT int SSL_set_ech_grease_callback(SSL *ssl,
+                                               SSL_ech_grease_callback callback,
+                                               void *arg);
+
+// SSL_CTX_set_ech_grease_callback sets the default callback for connections
+// using `ctx`. A null callback restores upstream defaults. This does not enable
+// GREASE. `arg` must remain valid until replacement or `ctx` destruction.
+OPENSSL_EXPORT void SSL_CTX_set_ech_grease_callback(
+    SSL_CTX *ctx, SSL_ech_grease_callback callback, void *arg);
+
 // SSL_set1_ech_config_list configures `ssl` to, as a client, offer ECH with the
 // specified configuration. `ech_config_list` should contain a serialized
 // ECHConfigList structure. It returns one on success and zero on error.
diff --git a/ssl/ech_grease_policy_test.cc b/ssl/ech_grease_policy_test.cc
