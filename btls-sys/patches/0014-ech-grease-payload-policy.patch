+TEST_F(ECHGreaseHandshakeTest, PolicyRequiresHandshakeAndConfig) {
+  for (bool shed : {false, true}) {
+    SCOPED_TRACE(shed);
+    ASSERT_NO_FATAL_FAILURE(Init());
+    ASSERT_NO_FATAL_FAILURE(NewPair());
+    SSL_set_shed_handshake_config(client.get(), shed);
+    ASSERT_TRUE(Handshake());
+    auto *impl = FromOpaque(client.get());
+    ASSERT_FALSE(impl->s3->hs);
+    ASSERT_EQ(impl->config == nullptr, shed);
+    EXPECT_FALSE(SSL_set_ech_grease_callback(client.get(), nullptr, nullptr));
+    EXPECT_EQ(ERR_GET_REASON(ERR_peek_last_error()),
+              ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    ERR_clear_error();
+    if (!shed) {
+      ASSERT_TRUE(SSL_clear(client.get()));
+      EXPECT_TRUE(SSL_set_ech_grease_callback(client.get(), nullptr, nullptr));
+    }
+  }
+}
+
+TEST_F(ECHGreaseHandshakeTest, ServerAcceptsButIgnoresPolicy) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set_ech_grease_callback(
+      server.get(),
+      [](const SSL_ECH_GREASE_SIZE_INFO *, SSL_ECH_GREASE_PARAMETERS *,
+         void *) {
+        ADD_FAILURE() << "server ran the client policy";
+        return 0;
+      },
+      nullptr));
+  ASSERT_TRUE(Handshake());
+  EXPECT_EQ(calls, size_t{1});
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
+
+TEST_F(ECHGreaseHandshakeTest, RealECHSkipsPolicy) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  std::vector<uint8_t> retry_configs;
+  ASSERT_NO_FATAL_FAILURE(SetServerEchKeys(&retry_configs));
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set1_ech_config_list(client.get(), retry_configs.data(),
+                                       retry_configs.size()));
+  ASSERT_TRUE(Handshake());
+  EXPECT_TRUE(SSL_ech_accepted(client.get()));
+  EXPECT_EQ(calls, size_t{0});
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
+
+// An ECH server answers GREASE with retry configs in EncryptedExtensions. The
+// rotated extension must count as sent, or the client rejects that reply.
+TEST_F(ECHGreaseHandshakeTest, GreaseAcceptsRetryConfigs) {
+  for (bool permute : {false, true}) {
+    SCOPED_TRACE(permute);
+    ASSERT_NO_FATAL_FAILURE(Init());
+    std::vector<uint8_t> retry_configs;
+    ASSERT_NO_FATAL_FAILURE(SetServerEchKeys(&retry_configs));
+    SSL_CTX_set_permute_extensions(client_ctx.get(), permute);
+    ASSERT_NO_FATAL_FAILURE(NewPair());
+    SSL_set_msg_callback(client.get(), CaptureRetryConfigs);
+    SSL_set_msg_callback_arg(client.get(), this);
+    ASSERT_TRUE(Handshake());
+    EXPECT_EQ(calls, size_t{1});
+    EXPECT_FALSE(SSL_ech_accepted(client.get()));
+    EXPECT_TRUE(saw_retry_configs);
+    ASSERT_NO_FATAL_FAILURE(Exchange());
+  }
+}
