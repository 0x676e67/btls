+TEST_F(ECHGreaseHandshakeTest, PracticalLengthSurvivesHRRAndDTLS) {
+  for (bool dtls : {false, true}) {
+    for (bool hrr : {false, true}) {
+      SCOPED_TRACE(dtls);
+      SCOPED_TRACE(hrr);
+      ASSERT_NO_FATAL_FAILURE(Init(dtls));
+      ASSERT_TRUE(SSL_CTX_set1_curves_list(client_ctx.get(), "X25519:P-384"));
+      ASSERT_TRUE(
+          SSL_CTX_set1_curves_list(server_ctx.get(), hrr ? "P-384" : "X25519"));
+      ASSERT_NO_FATAL_FAILURE(NewPair());
+      ASSERT_TRUE(Handshake());
+      EXPECT_EQ(calls, size_t{1});
+      ASSERT_EQ(hellos.size(), hrr ? size_t{2} : size_t{1});
+      ASSERT_EQ(hellos[0].size(), 4096 + kEchBodyFramingLen);
+      EXPECT_EQ(hellos[0][kEchAeadOffset], 0);
+      EXPECT_EQ(hellos[0][kEchAeadOffset + 1], EVP_HPKE_CHACHA20_POLY1305);
+      if (hrr) {
+        EXPECT_EQ(hellos[0], hellos[1]);
+      }
+      ASSERT_NO_FATAL_FAILURE(Exchange());
+    }
+  }
+}
+
+TEST_F(ECHGreaseHandshakeTest, ResumptionKeepsBinderValid) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(Handshake());
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+  ASSERT_TRUE(session);
+  ASSERT_TRUE(SSL_SESSION_is_resumable(session.get()));
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set_session(client.get(), session.get()));
+  ASSERT_TRUE(Handshake());
+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_EQ(calls, size_t{1});
+  EXPECT_GT(psk_length, size_t{0});
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
+
+TEST_F(ECHGreaseHandshakeTest, PolicyRequiresHandshakeAndConfig) {
+  for (bool shed : {false, true}) {
+    SCOPED_TRACE(shed);
+    ASSERT_NO_FATAL_FAILURE(Init());
+    ASSERT_NO_FATAL_FAILURE(NewPair());
+    SSL_set_shed_handshake_config(client.get(), shed);
+    ASSERT_TRUE(Handshake());
+    auto *impl = FromOpaque(client.get());
+    ASSERT_FALSE(impl->s3->hs);
+    ASSERT_EQ(impl->config == nullptr, shed);
+    EXPECT_FALSE(SSL_set_ech_grease_callback(client.get(), nullptr, nullptr));
+    EXPECT_EQ(ERR_GET_REASON(ERR_peek_last_error()),
+              ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    ERR_clear_error();
+    if (!shed) {
+      ASSERT_TRUE(SSL_clear(client.get()));
+      EXPECT_TRUE(SSL_set_ech_grease_callback(client.get(), nullptr, nullptr));
+    }
+  }
+}
+
+TEST_F(ECHGreaseHandshakeTest, RealECHSkipsPolicy) {
+  ASSERT_NO_FATAL_FAILURE(Init());
+  std::vector<uint8_t> retry_configs;
+  ASSERT_NO_FATAL_FAILURE(SetServerEchKeys(&retry_configs));
+  ASSERT_NO_FATAL_FAILURE(NewPair());
+  ASSERT_TRUE(SSL_set1_ech_config_list(client.get(), retry_configs.data(),
+                                       retry_configs.size()));
+  ASSERT_TRUE(Handshake());
+  EXPECT_TRUE(SSL_ech_accepted(client.get()));
+  EXPECT_EQ(calls, size_t{0});
+  ASSERT_NO_FATAL_FAILURE(Exchange());
+}
+
+// An ECH server answers GREASE with retry configs in EncryptedExtensions. The
+// rotated extension must count as sent, or the client rejects that reply.
+TEST_F(ECHGreaseHandshakeTest, GreaseAcceptsRetryConfigs) {
+  for (bool permute : {false, true}) {
+    SCOPED_TRACE(permute);
+    ASSERT_NO_FATAL_FAILURE(Init());
+    std::vector<uint8_t> retry_configs;
+    ASSERT_NO_FATAL_FAILURE(SetServerEchKeys(&retry_configs));
+    SSL_CTX_set_permute_extensions(client_ctx.get(), permute);
+    ASSERT_NO_FATAL_FAILURE(NewPair());
+    SSL_set_msg_callback(client.get(), CaptureRetryConfigs);
+    SSL_set_msg_callback_arg(client.get(), this);
+    ASSERT_TRUE(Handshake());
+    EXPECT_EQ(calls, size_t{1});
+    EXPECT_FALSE(SSL_ech_accepted(client.get()));
+    EXPECT_TRUE(saw_retry_configs);
+    ASSERT_NO_FATAL_FAILURE(Exchange());
+  }
+}
+
+TEST(ECHGreasePolicyTest, RetryCannotEnablePendingPolicy) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(DTLS_method()));
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  size_t length = 239;
+  ASSERT_TRUE(SSL_set_ech_grease_callback(ssl.get(), FixedLength, &length));
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  auto *hs = FromOpaque(ssl.get())->s3->hs.get();
+  hs->max_version = TLS1_3_VERSION;
+  ASSERT_TRUE(ssl_ech_grease_pending(hs));
+  hs->received_hello_verify_request = true;
+  EXPECT_FALSE(ssl_ech_grease_pending(hs));
+  hs->received_hello_verify_request = false;
+  hs->ssl->s3->used_hello_retry_request = true;
+  EXPECT_FALSE(ssl_ech_grease_pending(hs));
+}
