Upgrade to BoringSSL 0.20260929.0: upstream now skips
`__clang_call_terminate` itself (d9cace2c9) and audits libssl
(e98a65645), so only the MSVC iterator rule remains.
---
 util/audit_symbols.go | 1 +
 1 file changed, 1 insertion(+)

diff --git a/util/audit_symbols.go b/util/audit_symbols.go
index bd066fa27..2825b351e 100644
--- a/util/audit_symbols.go
+++ b/util/audit_symbols.go
@@ -81,6 +81,7 @@ var skipWeakSymbols = []*regexp.Regexp{
 	regexp.MustCompile(`^\?\?_C\@_.*`),                                  // String literals
 	regexp.MustCompile(`^\?\?_R[0-4].*$`),                               // RTTI
 	regexp.MustCompile(`^\?__empty_global_delete(@.*)?$`),               // operator delete()
+	regexp.MustCompile(`^\?\?_[HIJLMN]@Y.*`),                            // Array ctor/dtor iterators
 	regexp.MustCompile(`^\?memchr(@.*)?$`),                              // memchr()
 	regexp.MustCompile(`^\?strchr(@.*)?$`),                              // strchr()
 	regexp.MustCompile(`^_Avx2WmemEnabledWeakValue$`),                   // MSVC 14.50+ CRT
