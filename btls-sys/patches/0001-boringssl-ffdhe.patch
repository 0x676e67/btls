+class FFDHEKeyShare : public SSLKeyShare {
+ public:
+  FFDHEKeyShare(UniquePtr<DH> dh, uint16_t group_id, unsigned private_bits)
+      : dh_(std::move(dh)),
+        group_id_(group_id),
+        private_bits_(private_bits) {}
+
+  uint16_t GroupID() const override { return group_id_; }
+
+  bool Generate(CBB *out) override {
+    assert(dh_);
+    assert(DH_get0_priv_key(dh_.get()) == nullptr);
+
+    // RFC 7919, Section 5.2 permits short exponents and gives the minimum
+    // length for each named group. Setting the top bit guarantees that the
+    // generated private value has the requested length.
+    UniquePtr<BIGNUM> private_key(BN_new());
+    if (!private_key ||
+        !BN_rand(private_key.get(), static_cast<int>(private_bits_),
+                 BN_RAND_TOP_ONE,
+                 BN_RAND_BOTTOM_ANY) ||
+        !DH_set0_key(dh_.get(), /*pub_key=*/nullptr, private_key.get())) {
+      return false;
+    }
+    // DH_set0_key takes ownership on success.
+    private_key.release();
+
+    const int public_key_len = DH_size(dh_.get());
+    return public_key_len > 0 && DH_generate_key(dh_.get()) &&
+           BN_bn2cbb_padded(out, public_key_len,
+                            DH_get0_pub_key(dh_.get()));
+  }
+
+  bool Encap(CBB *out_ciphertext, Array<uint8_t> *out_secret,
+             uint8_t *out_alert, Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return Generate(out_ciphertext) && Decap(out_secret, out_alert, peer_key);
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> ciphertext) override {
+    assert(dh_);
+    assert(DH_get0_priv_key(dh_.get()) != nullptr);
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+
+    const int dh_size_int = DH_size(dh_.get());
+    if (dh_size_int <= 0) {
+      return false;
+    }
+    const size_t dh_size = static_cast<size_t>(dh_size_int);
+    if (ciphertext.size() != dh_size) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_DH_PUBLIC_VALUE_LENGTH_IS_WRONG);
+      return false;
+    }
+
+    UniquePtr<BIGNUM> peer_key(
+        BN_bin2bn(ciphertext.data(), ciphertext.size(), nullptr));
+    if (!peer_key) {
+      return false;
+    }
+
+    int check_result;
+    if (!DH_check_pub_key(dh_.get(), peer_key.get(), &check_result)) {
+      return false;
+    }
+    if (check_result != 0) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(DH, DH_R_INVALID_PUBKEY);
+      return false;
+    }
+
+    Array<uint8_t> secret;
+    if (!secret.InitForOverwrite(dh_size) ||
+        DH_compute_key_padded(secret.data(), peer_key.get(), dh_.get()) !=
+            static_cast<int>(dh_size)) {
+      return false;
+    }
+
+    *out_secret = std::move(secret);
+    return true;
+  }
+
+  bool SerializePrivateKey(CBB *out) override {
+    assert(dh_);
+    const BIGNUM *private_key = DH_get0_priv_key(dh_.get());
+    assert(private_key);
+    return BN_bn2cbb_padded(out, PrivateKeyBytes(), private_key);
+  }
+
+  bool DeserializePrivateKey(CBS *in) override {
+    assert(dh_);
+    assert(DH_get0_priv_key(dh_.get()) == nullptr);
+    if (CBS_len(in) != PrivateKeyBytes()) {
+      return false;
+    }
+
+    UniquePtr<BIGNUM> private_key(
+        BN_bin2bn(CBS_data(in), CBS_len(in), nullptr));
+    if (!private_key || BN_num_bits(private_key.get()) != private_bits_ ||
+        !DH_set0_key(dh_.get(), /*pub_key=*/nullptr, private_key.get())) {
+      return false;
+    }
+    // DH_set0_key takes ownership on success.
+    private_key.release();
+    return true;
+  }
+
+ private:
+  size_t PrivateKeyBytes() const {
+    return static_cast<size_t>((private_bits_ + 7) / 8);
+  }
+
+  UniquePtr<DH> dh_;
+  uint16_t group_id_;
+  unsigned private_bits_;
+};
