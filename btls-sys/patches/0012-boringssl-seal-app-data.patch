+      size_t max_in;
+      switch (rand() % 3) {
+        case 0:
+          max_in = SIZE_MAX;
+          break;
+        case 1:
+          max_in = total;
+          break;
+        default:
+          max_in = rand() % (total + 1);
+          break;
+      }
+      const size_t n = std::min(max_in, total);
+      const size_t first = std::min(frag, n);
+      const size_t bound = n + (n + frag - 1) / frag * overhead;
+      size_t max_out;
+      switch (rand() % 4) {
+        case 0:
+          max_out = bound;
+          break;
+        case 1:
+          max_out = bound + rand() % 64;
+          break;
+        case 2:
+          max_out = rand() % (bound + 1);
+          break;
+        default:
+          max_out = first + overhead - 1 + rand() % 2;
+          break;
+      }
+
+      auto out = std::make_unique<uint8_t[]>(max_out);
+      std::vector<CRYPTO_IVEC> in =
+          SliceInput(data, lens, Span(out.get(), max_out));
