+bool tls_plan_seal_body(SealInput *input, size_t want, uint8_t *body,
+                        size_t budget, CRYPTO_IOVEC *out_iovecs,
+                        size_t *out_num, size_t *out_len) {
+  // Work on local copies, which `body` cannot alias.
+  const Span<const CRYPTO_IVEC> slices = input->slices_;
+  const Span<const uint8_t> out = input->out_;
+  size_t index = input->index_, offset = input->offset_;
+  const size_t limit = std::min(want, input->remaining_);
+  size_t n = 0, pos = 0, run = 0;  // body[run, pos) is the open copied run
+  while (pos < limit && index < slices.size()) {
+    const CRYPTO_IVEC &slice = slices[index];
+    if (offset == slice.len) {  // an empty slice; its pointer is not read
+      index++;
+      offset = 0;
+      continue;
+    }
+    if (slice.in == nullptr) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+      OPENSSL_memset(body, 0, pos);
+      return false;
+    }
+    const size_t len = std::min(slice.len - offset, limit - pos);
+    const uint8_t *piece = slice.in + offset;
+    if (buffers_alias(piece, len, out.data(), out.size())) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_OUTPUT_ALIASES_INPUT);
+      OPENSSL_memset(body, 0, pos);
+      return false;
+    }
+    offset += len;
+    if (offset == slice.len) {
+      index++;
+      offset = 0;
+    }
+
+    const bool whole = pos == 0 && len == want;
+    const bool last = pos + len == want;
+    const size_t open = pos > run ? 1 : 0;
+    // Gathering spends a slot on the open run, one on the piece and, unless
+    // the record ends here, keeps one for whatever follows.
+    if (whole || (len >= kSealGatherMin &&
+                  n + open + 1 + (last ? 0 : 1) <= budget)) {
+      if (open) {
+        BSSL_CHECK(n < budget);
+        out_iovecs[n++] = {body + run, body + run, pos - run};
+      }
+      BSSL_CHECK(n < budget);
+      out_iovecs[n++] = {body + pos, piece, len};
+      pos += len;
+      run = pos;
+    } else {
+      seal_copy(body + pos, piece, len);
+      pos += len;
+    }
+  }
+  if (pos > run) {
+    BSSL_CHECK(n < budget);
+    out_iovecs[n++] = {body + run, body + run, pos - run};
+  }
+  input->index_ = index;
+  input->offset_ = offset;
+  input->remaining_ -= pos;
+  *out_num = n;
+  *out_len = pos;
+  return true;
+}
+
+bool tls_seal_app_data_record(SSLImpl *ssl, Span<uint8_t> out,
+                              SealInput *input, size_t want,
+                              size_t prefix_len, size_t budget,
+                              size_t *out_len, size_t *out_consumed) {
+  // Fail before copying any plaintext.
+  if (ssl->s3->write_sequence + 1 == 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+    return false;
+  }
+  uint8_t *body = out.data() + prefix_len;
+  CRYPTO_IOVEC iovecs[CRYPTO_IOVEC_MAX];
+  size_t num, body_len;
+  if (!tls_plan_seal_body(input, want, body, budget, iovecs, &num,
+                          &body_len)) {
+    return false;
+  }
+  if (body_len == 0) {
+    *out_len = *out_consumed = 0;
+    return true;
+  }
+  size_t suffix_len;
+  if (!do_seal_record_iov(ssl, out.data(), Span(iovecs, num), body_len,
+                          body + body_len, SSL3_RT_APPLICATION_DATA,
+                          &suffix_len)) {
+    // `EVP_AEAD_CTX_sealv` zeroes its outputs, but a failure can come before
+    // it.
+    OPENSSL_memset(body, 0, body_len);
+    return false;
+  }
+  *out_len = prefix_len + body_len + suffix_len;
+  *out_consumed = body_len;
+  return true;
+}
