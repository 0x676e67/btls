+// SealAll is `WriteAll` through `SSL_seal_app_data`. Each call takes the input
+// as irregular slices and stops after three records and a byte, so most
+// calls are partial. What sealing declines goes through `SSL_write`.
+static int SealAll(SSL *ssl, const uint8_t *in, size_t in_len) {
+  static const size_t kSliceLens[] = {0, 1, 7, 0, 300, 4100, 2, 9000};
+  size_t next_slice = 0;
+  int ret;
+  do {
+    size_t frag, overhead, pending;
+    if (!SSL_seal_app_data_limits(ssl, &frag, &overhead, &pending)) {
+      do {
+        ret = SSL_write(ssl, in, in_len);
+      } while (RetryAsync(ssl, ret));
+      if (ret <= 0) {
+        return ret;
+      }
+      in += ret;
+      in_len -= ret;
+      continue;
+    }
+
+    // Cut a little past `max_in`, so it usually ends inside a slice.
+    const size_t max_in = std::min(in_len, 3 * frag + 1);
+    std::vector<CRYPTO_IVEC> slices;
+    for (size_t off = 0; off < std::min(in_len, max_in + 9000);) {
+      const size_t len = std::min(
+          kSliceLens[next_slice++ % std::size(kSliceLens)], in_len - off);
+      slices.push_back({in + off, len});
+      off += len;
+    }
+    const size_t max_out =
+        pending + max_in + (max_in + frag - 1) / frag * overhead;
+    auto out = std::make_unique<uint8_t[]>(max_out);
+    size_t out_len, consumed;
+    switch (SSL_seal_app_data(ssl, out.get(), &out_len, max_out, slices.data(),
+                              slices.size(), max_in, &consumed)) {
+      case ssl_seal_app_data_success:
+        break;
+      case ssl_seal_app_data_declined:
+        fprintf(stderr, "SSL_seal_app_data declined after its limits.\n");
+        return -1;
+      case ssl_seal_app_data_error:
+        return -1;
+    }
+    if (consumed == 0 && in_len != 0) {
+      fprintf(stderr, "SSL_seal_app_data consumed nothing.\n");
+      return -1;
+    }
+    if (!WriteSealed(ssl, out.get(), out_len)) {
+      return -1;
+    }
+    in += consumed;
+    in_len -= consumed;
+    ret = static_cast<int>(consumed);
+  } while (in_len > 0);
+  return ret;
+}
