+TEST(SealPlanTest, Properties) {
+  // xorshift64 with a fixed seed, so failures reproduce.
+  uint64_t state = 0x2545f4914f6cdd1d;
+  auto rand = [&]() -> size_t {
+    state ^= state << 13;
+    state ^= state >> 7;
+    state ^= state << 17;
+    return static_cast<size_t>(state);
+  };
+  // Short lengths come first, covering each size class of the inline copy.
+  // Most slices are drawn from those.
+  static const size_t kLens[] = {0,    1,    2,    3,    4,     7,    8,
+                                 9,    15,   16,   17,   31,    32,   33,
+                                 1024, 4095, 4096, 4097, 16384, 40960};
+  static const size_t kNumShort = 14;
+  static const size_t kWants[] = {1, 512, 16384};
+  static const size_t kBudgets[] = {1, 2, 15, 16};
+
+  for (int iter = 0; iter < 1000; iter++) {
+    SCOPED_TRACE(iter);
+    const size_t num_lens = rand() % 4 == 0 ? std::size(kLens) : kNumShort;
+    std::vector<size_t> lens(rand() % 601);
+    size_t total = 0;
+    for (size_t &len : lens) {
+      len = kLens[rand() % num_lens];
+      total += len;
+    }
+    std::vector<uint8_t> data(total);
+    for (uint8_t &b : data) {
+      b = static_cast<uint8_t>(rand());
+    }
+    const size_t want = kWants[rand() % std::size(kWants)];
+    const size_t budget = kBudgets[rand() % std::size(kBudgets)];
+    const size_t max_in = rand() % 2 == 0 ? SIZE_MAX : rand() % (total + 1);
+    SCOPED_TRACE(want);
+    SCOPED_TRACE(budget);
+
+    std::vector<uint8_t> body(want);
+    // Empty slices carry pointers that must not be read, including one
+    // inside the output.
+    std::vector<CRYPTO_IVEC> slices;
+    size_t pos = 0;
+    for (size_t len : lens) {
+      slices.push_back({len == 0 ? body.data() + body.size() / 2
+                                 : data.data() + pos,
+                        len});
+      pos += len;
+    }
+
+    SealInput input(slices, max_in, body);
+    const size_t n = std::min(max_in, total);
+    size_t offset = 0;
+    // Plan up to 64 records; with `want` of one byte, the rest adds nothing.
+    for (int record = 0; record < 64 && offset < n; record++) {
+      const size_t expected_len = std::min(want, n - offset);
+      ASSERT_EQ(input.Available(want), expected_len);
+      ASSERT_EQ(input.Available(1), std::min(size_t{1}, expected_len));
+
+      CRYPTO_IOVEC iovecs[CRYPTO_IOVEC_MAX];
+      size_t num, len;
+      ASSERT_TRUE(tls_plan_seal_body(&input, want, body.data(), budget, iovecs,
+                                     &num, &len));
+      ASSERT_EQ(len, expected_len);
+      ASSERT_GE(num, 1u);
+      ASSERT_LE(num, budget);
+      size_t done = 0;
+      for (size_t i = 0; i < num; i++) {
+        SCOPED_TRACE(i);
+        const CRYPTO_IOVEC &v = iovecs[i];
+        ASSERT_EQ(v.out, body.data() + done);
+        ASSERT_GT(v.len, 0u);
+        ASSERT_LE(done + v.len, len);
+        const uint8_t *src = data.data() + offset + done;
+        if (v.in == v.out) {
+          // A copied run.
+          EXPECT_EQ(Bytes(v.out, v.len), Bytes(src, v.len));
+        } else {
+          // A gathered piece is read from where it is.
+          EXPECT_EQ(v.in, src);
+          EXPECT_TRUE(v.len >= kSealGatherMin || (num == 1 && v.len == want));
+        }
+        done += v.len;
+      }
+      EXPECT_EQ(done, len);
+      offset += len;
+    }
+    if (offset == n) {
+      CRYPTO_IOVEC iovecs[CRYPTO_IOVEC_MAX];
+      size_t num, len;
+      ASSERT_TRUE(tls_plan_seal_body(&input, want, body.data(), budget, iovecs,
+                                     &num, &len));
+      EXPECT_EQ(len, 0u);
+      EXPECT_EQ(num, 0u);
+    }
+  }
+
+  // A NULL or overlapping slice fails the plan and zeroes what was copied.
+  uint8_t data[100];
+  OPENSSL_memset(data, 0x42, sizeof(data));
+  std::vector<uint8_t> body(512);
+  const CRYPTO_IVEC null_slice[] = {{data, sizeof(data)}, {nullptr, 1}};
+  const CRYPTO_IVEC aliasing[] = {{data, sizeof(data)},
+                                  {body.data() + 300, 1}};
+  for (const auto &[slices, reason] :
+       {std::pair(Span(null_slice), ERR_R_PASSED_NULL_PARAMETER),
+        std::pair(Span(aliasing), SSL_R_OUTPUT_ALIASES_INPUT)}) {
+    SCOPED_TRACE(reason);
+    OPENSSL_memset(body.data(), 0xaa, body.size());
+    SealInput input(slices, SIZE_MAX, body);
+    CRYPTO_IOVEC iovecs[CRYPTO_IOVEC_MAX];
+    size_t num, len;
+    EXPECT_FALSE(tls_plan_seal_body(&input, body.size(), body.data(),
+                                    CRYPTO_IOVEC_MAX, iovecs, &num, &len));
+    EXPECT_TRUE(ErrorEquals(ERR_get_error(), ERR_LIB_SSL, reason));
+    std::vector<uint8_t> expected(body.size(), 0xaa);
+    OPENSSL_memset(expected.data(), 0, sizeof(data));
+    EXPECT_EQ(Bytes(body), Bytes(expected));
+  }
+}
+
+TEST(SealScatterTest, GatherMatchesContiguous) {
+  struct Case {
+    uint16_t cipher;
+    uint16_t version;
+    // deterministic is false if each record has a random explicit IV.
+    bool deterministic;
+  };
+  const Case kCases[] = {
+      {SSL_CIPHER_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS1_2_VERSION, true},
+      {SSL_CIPHER_AES_256_GCM_SHA384, TLS1_3_VERSION, true},
+      {SSL_CIPHER_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, TLS1_2_VERSION,
+       true},
+      {SSL_CIPHER_CHACHA20_POLY1305_SHA256, TLS1_3_VERSION, true},
+      // TLS 1.0 CBC chains each record's IV from the previous record.
+      {SSL_CIPHER_ECDHE_RSA_WITH_AES_128_CBC_SHA, TLS1_VERSION, true},
+      {SSL_CIPHER_ECDHE_RSA_WITH_AES_128_CBC_SHA, TLS1_2_VERSION, false},
+      {SSL_CIPHER_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA, TLS1_2_VERSION, false},
+  };
+  static const size_t kCuts[] = {0, 1, 15, 16, 17, 4095, 4096, 4097};
+  std::vector<uint8_t> plaintext(9000);
+  RAND_bytes(plaintext.data(), plaintext.size());
+
+  for (const Case &t : kCases) {
+    const SSL_CIPHER *cipher = SSL_get_cipher_by_value(t.cipher);
+    ASSERT_TRUE(cipher);
+    SCOPED_TRACE(SSL_CIPHER_standard_name(cipher));
+    SCOPED_TRACE(t.version);
+
+    const EVP_AEAD *aead;
+    size_t mac_key_len, fixed_iv_len;
+    ASSERT_TRUE(ssl_cipher_get_evp_aead(&aead, &mac_key_len, &fixed_iv_len,
+                                        cipher, t.version));
+    // CBC ciphers pass the MAC key and IV inside the `EVP_AEAD` key.
+    const size_t enc_key_len =
+        EVP_AEAD_key_length(aead) -
+        (mac_key_len == 0 ? 0 : mac_key_len + fixed_iv_len);
+    uint8_t keys[3][EVP_AEAD_MAX_KEY_LENGTH];
+    RAND_bytes(&keys[0][0], sizeof(keys));
+    auto make = [&](evp_aead_direction_t direction) {
+      return SSLAEADContext::Create(
+          direction, t.version, cipher, Span(keys[0]).first(enc_key_len),
+          Span(keys[1]).first(mac_key_len), Span(keys[2]).first(fixed_iv_len));
+    };
+    UniquePtr<SSLAEADContext> contiguous = make(evp_aead_seal),
+                              gathered = make(evp_aead_seal),
+                              open_contiguous = make(evp_aead_open),
+                              open_gathered = make(evp_aead_open);
+    ASSERT_TRUE(contiguous && gathered && open_contiguous && open_gathered);
+
+    const bool tls13 = t.version >= TLS1_3_VERSION;
+    const uint8_t inner_type = SSL3_RT_APPLICATION_DATA;
+    const size_t extra_in_len = tls13 ? 1 : 0;
+    const uint16_t record_version = tls13 ? TLS1_2_VERSION : t.version;
+    const size_t len = plaintext.size();
+    const size_t prefix_len = contiguous->ExplicitNonceLen();
+    size_t suffix_len;
+    ASSERT_TRUE(contiguous->SuffixLen(&suffix_len, len, extra_in_len));
+    const size_t record_len = prefix_len + len + suffix_len;
+    const uint8_t header[SSL3_RT_HEADER_LENGTH] = {
+        SSL3_RT_APPLICATION_DATA, static_cast<uint8_t>(record_version >> 8),
+        static_cast<uint8_t>(record_version), static_cast<uint8_t>(record_len >> 8),
+        static_cast<uint8_t>(record_len)};
+
+    uint64_t seq = 0;
+    for (size_t cut : kCuts) {
+      for (bool gather_first : {false, true}) {
+        SCOPED_TRACE(cut);
+        SCOPED_TRACE(gather_first);
+        std::vector<uint8_t> a(record_len), b(record_len);
+        ASSERT_TRUE(contiguous->SealScatter(
+            a.data(), a.data() + prefix_len, a.data() + prefix_len + len,
+            SSL3_RT_APPLICATION_DATA, record_version, seq, header,
+            plaintext.data(), len, &inner_type, extra_in_len));
+
+        // Alternate copied and gathered entries at `cut` and `cut + 100`.
+        uint8_t *body = b.data() + prefix_len;
+        std::vector<CRYPTO_IOVEC> entries;
+        const size_t bounds[] = {0, cut, cut + 100, len};
+        bool gather = gather_first;
+        for (size_t i = 0; i + 1 < std::size(bounds); i++, gather = !gather) {
+          const size_t start = bounds[i], n = bounds[i + 1] - start;
+          if (n == 0) {
+            continue;
+          }
+          if (gather) {
+            entries.push_back({body + start, plaintext.data() + start, n});
+          } else {
+            OPENSSL_memcpy(body + start, plaintext.data() + start, n);
+            entries.push_back({body + start, body + start, n});
+          }
+        }
+        ASSERT_TRUE(gathered->SealScatterv(
+            b.data(), entries, body + len, SSL3_RT_APPLICATION_DATA,
+            record_version, seq, header, &inner_type, extra_in_len));
+
+        if (t.deterministic) {
+          EXPECT_EQ(Bytes(a), Bytes(b));
+        } else {
+          // A random explicit IV makes the bytes differ. Both must open.
+          for (auto &[record, opener] :
+               {std::pair(&a, open_contiguous.get()),
+                std::pair(&b, open_gathered.get())}) {
+            Span<uint8_t> opened;
+            ASSERT_TRUE(opener->Open(&opened, SSL3_RT_APPLICATION_DATA,
+                                     record_version, seq, header,
+                                     Span(*record)));
+            EXPECT_EQ(Bytes(opened), Bytes(plaintext));
+          }
+        }
+        seq++;
+      }
+    }
+
+    // One entry more than `CRYPTO_IOVEC_MAX` allows is rejected.
+    std::vector<uint8_t> out(record_len);
+    std::vector<CRYPTO_IOVEC> too_many;
+    for (size_t i = 0; i < CRYPTO_IOVEC_MAX + 1 - extra_in_len; i++) {
+      too_many.push_back({out.data() + prefix_len + i, plaintext.data() + i, 1});
+    }
+    EXPECT_FALSE(gathered->SealScatterv(
+        out.data(), too_many, out.data() + prefix_len + too_many.size(),
+        SSL3_RT_APPLICATION_DATA, record_version, seq, header, &inner_type,
+        extra_in_len));
+    EXPECT_TRUE(ErrorEquals(ERR_get_error(), ERR_LIB_SSL, ERR_R_INTERNAL_ERROR));
+  }
+}
