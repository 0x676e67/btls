+TEST_P(SSLVersionTest, SealAppDataSendsFlightFirst) {
+  if (is_dtls() || !is_tls13()) {
+    return;
+  }
+
+  SSL_CTX_set_session_cache_mode(client_ctx_.get(), SSL_SESS_CACHE_BOTH);
+  SSL_CTX_sess_set_new_cb(client_ctx_.get(), SaveLastSession);
+  g_last_session = nullptr;
+  ASSERT_TRUE(Connect());
+  static const uint8_t kData[] = "hello";
+
+  // The server defers its tickets to its first write. They go out first, and
+  // the client reads them before the data.
+  SSLImpl *server = FromOpaque(server_.get());
+  ASSERT_TRUE(server->s3->pending_hs_data);
+  ASSERT_NE(server->s3->pending_hs_data->length, 0u);
+  size_t pending, records;
+  ASSERT_NO_FATAL_FAILURE(SealToPeer(server_.get(), client_.get(), kData,
+                                     &pending, &records));
+  EXPECT_GT(pending, 0u);
+  EXPECT_EQ(records, 2u);
+  EXPECT_TRUE(g_last_session);
+  EXPECT_FALSE(server->s3->pending_hs_data);
+  EXPECT_FALSE(server->s3->pending_flight);
+
+  // A local KeyUpdate is sealed under the old key and sent first.
+  SSLImpl *client = FromOpaque(client_.get());
+  ASSERT_TRUE(SSL_key_update(client_.get(), SSL_KEY_UPDATE_REQUESTED));
+  EXPECT_TRUE(client->s3->key_update_pending);
+  ASSERT_NO_FATAL_FAILURE(
+      SealToPeer(client_.get(), server_.get(), kData, &pending, &records));
+  EXPECT_GT(pending, 0u);
+  EXPECT_EQ(records, 2u);
+  EXPECT_FALSE(client->s3->key_update_pending);
+
+  // Reading the request queued the server's acknowledgement under its old
+  // key. It precedes the data, which uses the new key.
+  ASSERT_TRUE(server->s3->pending_flight);
+  ASSERT_NO_FATAL_FAILURE(
+      SealToPeer(server_.get(), client_.get(), kData, &pending, &records));
+  EXPECT_GT(pending, 0u);
+  EXPECT_EQ(records, 2u);
+  EXPECT_FALSE(server->s3->pending_flight);
+
+  // Both directions still work with `SSL_write`.
+  uint8_t buf[sizeof(kData)];
+  ASSERT_EQ(SSL_write(client_.get(), kData, sizeof(kData)), int{sizeof(kData)});
+  ASSERT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), int{sizeof(buf)});
+  ASSERT_EQ(SSL_write(server_.get(), kData, sizeof(kData)), int{sizeof(kData)});
+  ASSERT_EQ(SSL_read(client_.get(), buf, sizeof(buf)), int{sizeof(buf)});
+}
