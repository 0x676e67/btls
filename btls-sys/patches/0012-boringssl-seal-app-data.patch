+TEST_P(SSLVersionTest, SealAppDataErrors) {
+  if (is_dtls()) {
+    return;
+  }
+
+  // Seal on the server, which has tickets pending in TLS 1.3.
+  ASSERT_TRUE(Connect());
+  SSLImpl *server = FromOpaque(server_.get());
+  size_t frag, overhead, pending;
+  ASSERT_TRUE(SSL_seal_app_data_limits(server_.get(), &frag, &overhead,
+                                       &pending));
+  const size_t max_out = pending + 3 * (frag + overhead);
+  auto out = std::make_unique<uint8_t[]>(max_out);
+  std::vector<uint8_t> data(3 * frag);
+  RAND_bytes(data.data(), data.size());
+  size_t out_len, consumed;
+  auto expect_error = [&](Span<const CRYPTO_IVEC> in, int lib, int reason) {
+    EXPECT_EQ(SealNoIO(server_.get(), Span(out.get(), max_out), &out_len, in,
+                       SIZE_MAX, &consumed),
+              ssl_seal_app_data_error);
+    EXPECT_EQ(out_len, 0u);
+    EXPECT_EQ(consumed, 0u);
+    EXPECT_EQ(SSL_get_error(server_.get(), -1), SSL_ERROR_SSL);
+    EXPECT_TRUE(ExpectSingleError(lib, reason));
+  };
+
+  // A slice array inside `out` is rejected before anything changes.
+  auto *in_out = reinterpret_cast<CRYPTO_IVEC *>(out.get());
+  in_out[0] = {data.data(), data.size()};
+  expect_error(Span(in_out, 1), ERR_LIB_SSL, SSL_R_OUTPUT_ALIASES_INPUT);
+  EXPECT_EQ(!!server->s3->pending_hs_data, is_tls13());
+  EXPECT_FALSE(server->s3->pending_flight);
+
+  // A slice that overlaps `out`, after a valid one.
+  const CRYPTO_IVEC aliasing[] = {{data.data(), 10},
+                                  {out.get() + max_out - 1, 1}};
+  expect_error(aliasing, ERR_LIB_SSL, SSL_R_OUTPUT_ALIASES_INPUT);
+  // The tickets were sealed, but stay queued.
+  EXPECT_FALSE(server->s3->pending_hs_data);
+  EXPECT_EQ(!!server->s3->pending_flight, is_tls13());
+
+  const CRYPTO_IVEC null_slice[] = {{nullptr, 0}, {nullptr, 1}};
+  expect_error(null_slice, ERR_LIB_SSL, ERR_R_PASSED_NULL_PARAMETER);
+
+  // A valid call sends the queued tickets, then the data, and does not
+  // leave an earlier error behind.
+  OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+  const CRYPTO_IVEC in = {data.data(), data.size()};
+  ASSERT_EQ(SealNoIO(server_.get(), Span(out.get(), max_out), &out_len,
+                     Span(&in, 1), SIZE_MAX, &consumed),
+            ssl_seal_app_data_success);
+  EXPECT_EQ(ERR_peek_error(), 0u);
+  EXPECT_EQ(consumed, data.size());
+  EXPECT_FALSE(server->s3->pending_flight);
+  std::vector<uint8_t> received;
+  ASSERT_TRUE(SendToPeer(server_.get(), client_.get(),
+                         Span(out.get(), out_len), &received));
+  EXPECT_TRUE(Bytes(received) == Bytes(data));
+
+  // An invalid piece in a later record keeps the records before it. They are
+  // reported, the error is cleared, and the next call reports it.
+  for (bool null_piece : {false, true}) {
+    SCOPED_TRACE(null_piece);
+    const CRYPTO_IVEC bad = null_piece
+                                ? CRYPTO_IVEC{nullptr, 1}
+                                : CRYPTO_IVEC{out.get() + max_out - 1, 1};
+    const CRYPTO_IVEC later[] = {{data.data(), 2 * frag}, bad};
+    ASSERT_EQ(SealNoIO(server_.get(), Span(out.get(), max_out), &out_len,
+                       later, SIZE_MAX, &consumed),
+              ssl_seal_app_data_success);
+    EXPECT_EQ(consumed, 2 * frag);
+    EXPECT_EQ(ERR_peek_error(), 0u);
+    received.clear();
+    ASSERT_TRUE(SendToPeer(server_.get(), client_.get(),
+                           Span(out.get(), out_len), &received));
+    EXPECT_TRUE(Bytes(received) == Bytes(Span(data).first(2 * frag)));
+    expect_error(Span(&bad, 1), ERR_LIB_SSL,
+                 null_piece ? ERR_R_PASSED_NULL_PARAMETER
+                            : SSL_R_OUTPUT_ALIASES_INPUT);
+  }
+
+  // The sequence number runs out after two more records. The records already
+  // sealed must be reported; the next call reports the failure.
+  server->s3->write_sequence = UINT64_MAX - 2;
+  ASSERT_EQ(SealNoIO(server_.get(), Span(out.get(), max_out), &out_len,
+                     Span(&in, 1), SIZE_MAX, &consumed),
+            ssl_seal_app_data_success);
+  EXPECT_EQ(consumed, 2 * frag);
+  EXPECT_EQ(ERR_peek_error(), 0u);
+  EXPECT_EQ(server->s3->write_sequence, UINT64_MAX);
+  const CRYPTO_IVEC rest = {data.data() + consumed, data.size() - consumed};
+  expect_error(Span(&rest, 1), ERR_LIB_SSL, ERR_R_OVERFLOW);
+
+  // The same with a flight: the tickets take the last sequence number, so
+  // the first record fails. Nothing reaches `out`, and the flight stays
+  // queued.
+  if (is_tls13()) {
+    ASSERT_TRUE(Connect());
+    server = FromOpaque(server_.get());
+    ASSERT_TRUE(server->s3->pending_hs_data);
+    server->s3->write_sequence = UINT64_MAX - 1;
+    OPENSSL_memset(out.get(), 0xaa, max_out);
+    expect_error(Span(&in, 1), ERR_LIB_SSL, ERR_R_OVERFLOW);
+    EXPECT_TRUE(server->s3->pending_flight);
+    for (size_t i = 0; i < max_out; i++) {
+      ASSERT_EQ(out[i], 0xaa) << i;
+    }
+  }
+}
