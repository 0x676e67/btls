+int SSL_seal_app_data_limits(const SSL *ssl, size_t *out_max_fragment,
+                             size_t *out_record_overhead,
+                             size_t *out_pending_len) {
+  const auto *ssl_impl = FromOpaque(ssl);
+  size_t pending;
+  if (!tls_can_seal_app_data(ssl_impl) ||
+      !tls_seal_app_data_pending_len(ssl_impl, &pending)) {
+    return 0;
+  }
+  *out_max_fragment = tls_app_data_fragment(ssl_impl);
+  *out_record_overhead = SSL_max_seal_overhead(ssl);
+  *out_pending_len = pending;
+  return 1;
+}
+
+enum ssl_seal_app_data_result_t SSL_seal_app_data(
+    SSL *ssl, uint8_t *out, size_t *out_len, size_t max_out,
+    const CRYPTO_IVEC *in, size_t num_in, size_t max_in, size_t *out_consumed) {
+  auto *ssl_impl = FromOpaque(ssl);
+  ssl_reset_error_state(ssl_impl);
+  return tls_seal_app_data(ssl_impl, Span(out, max_out), out_len,
+                           Span(in, num_in), max_in, out_consumed);
+}
