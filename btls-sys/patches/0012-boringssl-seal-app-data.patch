+TEST_P(SSLVersionTest, SealAppDataDeclines) {
+  static const uint8_t kData[100] = {1};
+  const CRYPTO_IVEC in = {kData, sizeof(kData)};
+  uint8_t out[1024];
+  size_t frag, overhead, pending, out_len, consumed;
+  auto expect_declined = [&](SSL *ssl) {
+    EXPECT_FALSE(SSL_seal_app_data_limits(ssl, &frag, &overhead, &pending));
+    const uint64_t seq = SSL_get_write_sequence(ssl);
+    EXPECT_EQ(SealNoIO(ssl, out, &out_len, Span(&in, 1), SIZE_MAX, &consumed),
+              ssl_seal_app_data_declined);
+    EXPECT_EQ(out_len, 0u);
+    EXPECT_EQ(consumed, 0u);
+    EXPECT_EQ(SSL_get_write_sequence(ssl), seq);
+    EXPECT_EQ(ERR_peek_error(), 0u);
+  };
+
+  // DTLS is never sealed into caller memory.
+  if (is_dtls()) {
+    ASSERT_TRUE(Connect());
+    expect_declined(client_.get());
+    expect_declined(server_.get());
+    return;
+  }
+
+  // Neither a client nor a server yet.
+  UniquePtr<SSL> ssl(SSL_new(client_ctx_.get()));
+  ASSERT_TRUE(ssl);
+  expect_declined(ssl.get());
+  EXPECT_EQ(SSL_write(ssl.get(), kData, sizeof(kData)), -1);
+  EXPECT_TRUE(ExpectSingleError(ERR_LIB_SSL, SSL_R_UNINITIALIZED));
+
+  // Before and during the handshake.
+  ASSERT_TRUE(CreateClientAndServer(&client_, &server_, client_ctx_.get(),
+                                    server_ctx_.get()));
+  expect_declined(client_.get());
+  EXPECT_EQ(SSL_write(client_.get(), kData, sizeof(kData)), -1);
+  EXPECT_EQ(SSL_get_error(client_.get(), -1), SSL_ERROR_WANT_READ);
+  expect_declined(client_.get());
+  ASSERT_TRUE(CompleteHandshakes(client_.get(), server_.get()));
+  EXPECT_TRUE(SSL_seal_app_data_limits(client_.get(), &frag, &overhead,
+                                       &pending));
+
+  // With an unfinished write.
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  unsigned count = 0;
+  for (;;) {
+    int ret = SSL_write(client_.get(), kData, sizeof(kData));
+    if (ret <= 0) {
+      ASSERT_EQ(SSL_get_error(client_.get(), ret), SSL_ERROR_WANT_WRITE);
+      break;
+    }
+    count++;
+  }
+  expect_declined(client_.get());
+  uint8_t buf[sizeof(kData)];
+  for (unsigned i = 0; i < count; i++) {
+    ASSERT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), int{sizeof(buf)});
+  }
+  ASSERT_EQ(SSL_write(client_.get(), kData, sizeof(kData)), int{sizeof(kData)});
+  ASSERT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), int{sizeof(buf)});
+  ASSERT_NO_FATAL_FAILURE(SealToPeer(client_.get(), server_.get(), kData));
+
+  // TLS 1.0 CBC record splitting stays in `SSL_write`.
+  if (version() == TLS1_VERSION) {
+    ASSERT_TRUE(Connect());
+    SSL_set_mode(client_.get(), SSL_MODE_CBC_RECORD_SPLITTING);
+    ASSERT_TRUE(SSL_CIPHER_is_block_cipher(SSL_get_current_cipher(client_.get())));
+    expect_declined(client_.get());
+    ASSERT_EQ(SSL_write(client_.get(), kData, sizeof(kData)), int{sizeof(kData)});
+    ASSERT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), 1);
+    ASSERT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), int{sizeof(buf) - 1});
+  }
+
+  // `out` one byte too short for the pending records and the first record.
+  // The server's tickets stay queued until a call has room for them.
+  ASSERT_TRUE(Connect());
+  SSLImpl *server = FromOpaque(server_.get());
+  ASSERT_TRUE(SSL_seal_app_data_limits(server_.get(), &frag, &overhead,
+                                       &pending));
+  EXPECT_EQ(pending != 0, is_tls13());
+  const size_t hs_len =
+      server->s3->pending_hs_data ? server->s3->pending_hs_data->length : 0;
+  const uint64_t seq = SSL_get_write_sequence(server_.get());
+  auto exact = std::make_unique<uint8_t[]>(pending + sizeof(kData) + overhead);
+  EXPECT_EQ(SealNoIO(server_.get(),
+                     Span(exact.get(), pending + sizeof(kData) + overhead - 1),
+                     &out_len, Span(&in, 1), SIZE_MAX, &consumed),
+            ssl_seal_app_data_declined);
+  EXPECT_EQ(server->s3->pending_hs_data ? server->s3->pending_hs_data->length
+                                        : 0,
+            hs_len);
+  EXPECT_FALSE(server->s3->pending_flight);
+  EXPECT_EQ(SSL_get_write_sequence(server_.get()), seq);
+  // An exact `out` with `max_in` well past the input works.
+  ASSERT_EQ(SealNoIO(server_.get(),
+                     Span(exact.get(), pending + sizeof(kData) + overhead),
+                     &out_len, Span(&in, 1), SIZE_MAX, &consumed),
+            ssl_seal_app_data_success);
+  EXPECT_EQ(consumed, sizeof(kData));
+  std::vector<uint8_t> received;
+  ASSERT_TRUE(SendToPeer(server_.get(), client_.get(),
+                         Span(exact.get(), out_len), &received));
+  EXPECT_EQ(Bytes(received), Bytes(kData));
+
+  // After the connection is shut down or failed.
+  ASSERT_TRUE(Connect());
+  EXPECT_EQ(SSL_shutdown(client_.get()), 0);
+  expect_declined(client_.get());
+  EXPECT_EQ(SSL_write(client_.get(), kData, sizeof(kData)), -1);
+  EXPECT_TRUE(ExpectSingleError(ERR_LIB_SSL, SSL_R_PROTOCOL_IS_SHUTDOWN));
+
+  ASSERT_TRUE(Connect());
+  SSL_set_quiet_shutdown(client_.get(), 1);
+  EXPECT_EQ(SSL_shutdown(client_.get()), 1);
+  expect_declined(client_.get());
+
+  ASSERT_TRUE(Connect());
+  EXPECT_EQ(SSL_send_fatal_alert(client_.get(), SSL_AD_INTERNAL_ERROR), 1);
+  expect_declined(client_.get());
+  EXPECT_EQ(SSL_write(client_.get(), kData, sizeof(kData)), -1);
+  EXPECT_TRUE(ExpectSingleError(ERR_LIB_SSL, SSL_R_PROTOCOL_IS_SHUTDOWN));
+}
