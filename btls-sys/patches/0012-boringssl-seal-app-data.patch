+// Sealing reports the same messages to the message callback, in the same
+// order, as `SSL_write` does for the same data.
+TEST_P(SSLVersionTest, SealAppDataMsgCallbackMatchesSSLWrite) {
+  if (is_dtls()) {
+    return;
+  }
+
+  using Event = std::tuple<int, int, size_t>;
+  auto run = [&](bool seal, std::vector<Event> *events) {
+    // In TLS 1.3, the server's tickets go out with its first write.
+    ASSERT_TRUE(Connect());
+    ASSERT_TRUE(SSL_set_max_send_fragment(server_.get(), 512));
+    SSL_set_msg_callback(
+        server_.get(), [](int write_p, int version, int content_type,
+                          const void *buf, size_t len, SSL *ssl, void *arg) {
+          static_cast<std::vector<Event> *>(arg)->emplace_back(
+              write_p, content_type, len);
+        });
+    SSL_set_msg_callback_arg(server_.get(), events);
+    std::vector<uint8_t> data(1100);
+    RAND_bytes(data.data(), data.size());
+    if (seal) {
+      ASSERT_NO_FATAL_FAILURE(SealToPeer(server_.get(), client_.get(), data));
+    } else {
+      ASSERT_EQ(SSL_write(server_.get(), data.data(), data.size()),
+                static_cast<int>(data.size()));
+      std::vector<uint8_t> received;
+      ASSERT_TRUE(ReadAvailable(client_.get(), &received));
+      EXPECT_TRUE(Bytes(received) == Bytes(data));
+    }
+    SSL_set_msg_callback(server_.get(), nullptr);
+  };
+
+  std::vector<Event> written, sealed;
+  ASSERT_NO_FATAL_FAILURE(run(/*seal=*/false, &written));
+  ASSERT_NO_FATAL_FAILURE(run(/*seal=*/true, &sealed));
+  EXPECT_GE(written.size(), 3u);
+  EXPECT_EQ(written, sealed);
+}
