diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -306,6 +306,68 @@ OPENSSL_EXPORT int SSL_has_pending(const SSL *ssl);
 // https://crbug.com/466303.
 OPENSSL_EXPORT int SSL_write(SSL *ssl, const void *buf, int num);
 
+// Sealing application data into caller memory.
+//
+// These functions are a btls extension. A caller that owns the transport's
+// output buffer can seal application data records straight into it, which
+// skips the write buffer, the `BIO` and a copy per record. They never read
+// from or write to the transport. Whenever they decline, write with
+// `SSL_write`, which handles every other state of the connection.
+
+// ssl_seal_app_data_result_t is the result of `SSL_seal_app_data`.
+enum ssl_seal_app_data_result_t BORINGSSL_ENUM_INT {
+  // ssl_seal_app_data_success means `*out_len` bytes were written to `out`
+  // and `*out_consumed` bytes of input were sealed.
+  ssl_seal_app_data_success,
+  // ssl_seal_app_data_declined means nothing was changed. Either the
+  // connection is in a state only `SSL_write` handles, or `out` cannot hold
+  // the pending handshake records and the first record.
+  // `SSL_seal_app_data_limits` tells the two apart.
+  ssl_seal_app_data_declined,
+  // ssl_seal_app_data_error means nothing was handed to the caller. Queued
+  // handshake messages may have been sealed into the pending flight, which
+  // stays queued for the next write. The error queue describes the failure,
+  // and `SSL_get_error` returns `SSL_ERROR_SSL` for it.
+  ssl_seal_app_data_error,
+};
+
+// SSL_seal_app_data_limits returns one if `SSL_seal_app_data` can seal
+// application data on `ssl` now, and zero otherwise. On success it sets
+// `*out_max_fragment` to the most plaintext bytes in one record,
+// `*out_record_overhead` to the most bytes one record adds to its plaintext,
+// and `*out_pending_len` to the most bytes of pending handshake records, such
+// as a KeyUpdate or NewSessionTicket, written before the data. Sealing `n`
+// bytes needs at most `*out_pending_len + n + ceil(n / *out_max_fragment) *
+// *out_record_overhead` bytes of output. The values hold until `ssl` is next
+// used. This function has no side effects.
+OPENSSL_EXPORT int SSL_seal_app_data_limits(const SSL *ssl,
+                                            size_t *out_max_fragment,
+                                            size_t *out_record_overhead,
+                                            size_t *out_pending_len);
+
+// SSL_seal_app_data seals up to `max_in` bytes, taken in order from the
+// `num_in` slices at `in`, as TLS application data records into `out`, which
+// has room for `max_out` bytes. It performs no transport I/O.
+//
+// Handshake records that `SSL_write` would send before the data are written
+// first. Each record then carries the maximum fragment, the last possibly
+// fewer, regardless of slice boundaries. Only whole records are written, and
+// sealing stops before a record that does not fit. Empty slices are skipped
+// without reading their pointers. Neither the slices nor the `in` array may
+// overlap `out`.
+//
+// On `ssl_seal_app_data_success`, `out[0, *out_len)` must reach the peer
+// before any later output of `ssl`, including what `SSL_write`,
+// `SSL_shutdown` or an alert hands to the `BIO`. If `max_in` is zero or the
+// slices hold no bytes, only the pending handshake records are written and
+// `*out_consumed` is zero. Otherwise `*out_consumed` is at least one. It is
+// less than the input if `out` filled up or a later record could not be
+// sealed; in the latter case the error is cleared and the next call reports
+// it if it recurs.
+OPENSSL_EXPORT enum ssl_seal_app_data_result_t SSL_seal_app_data(
+    SSL *ssl, uint8_t *out, size_t *out_len, size_t max_out,
+    const CRYPTO_IVEC *in, size_t num_in, size_t max_in, size_t *out_consumed);
+
 // SSL_KEY_UPDATE_REQUESTED indicates that the peer should reply to a KeyUpdate
 // message with its own, thus updating traffic secrets for both directions on
 // the connection.
diff --git a/ssl/internal.h b/ssl/internal.h
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -567,6 +567,15 @@ class SSLAEADContext {
                    Span<const uint8_t> header, const uint8_t *in, size_t in_len,
                    const uint8_t *extra_in, size_t extra_in_len);
 
+  // SealScatterv is `SealScatter` with the record body given as `body`. The
+  // entries' `out` ranges tile one contiguous region in order. Each entry's
+  // `in` equals its `out` or overlaps no output. `body.size()`, plus one if
+  // `extra_in_len` is non-zero, is at most `CRYPTO_IOVEC_MAX`.
+  bool SealScatterv(uint8_t *out_prefix, Span<const CRYPTO_IOVEC> body,
+                    uint8_t *out_suffix, uint8_t type, uint16_t record_version,
+                    uint64_t seqnum, Span<const uint8_t> header,
+                    const uint8_t *extra_in, size_t extra_in_len);
+
   bool GetIV(const uint8_t **out_iv, size_t *out_iv_len) const;
 
  private:
@@ -3813,6 +3822,81 @@ ssl_open_record_t tls_open_change_cipher_spec(SSLImpl *ssl,
 int tls_write_app_data(SSLImpl *ssl, bool *out_needs_handshake,
                        size_t *out_bytes_written, Span<const uint8_t> in);
 
+// tls_app_data_fragment returns the most plaintext in one application data
+// record, before any 0-RTT budget. `tls_write_app_data` and
+// `tls_seal_app_data` both use it, so both honor the peer's
+// `record_size_limit` (RFC 8449).
+size_t tls_app_data_fragment(const SSLImpl *ssl);
+
+// tls_can_seal_app_data returns whether `tls_seal_app_data` can seal now
+// without transport I/O or the handshake.
+bool tls_can_seal_app_data(const SSLImpl *ssl);
+
+// tls_seal_app_data_pending_len sets `*out_len` to an upper bound on the
+// handshake bytes that must precede new application data. It returns false on
+// overflow.
+bool tls_seal_app_data_pending_len(const SSLImpl *ssl, size_t *out_len);
+
+// tls_seal_app_data implements `SSL_seal_app_data` after the error state is
+// reset.
+enum ssl_seal_app_data_result_t tls_seal_app_data(
+    SSLImpl *ssl, Span<uint8_t> out, size_t *out_len,
+    Span<const CRYPTO_IVEC> in, size_t max_in, size_t *out_consumed);
+
+// SealInput reads the caller's slices for `tls_seal_app_data`, at most
+// `max_in` bytes. `tls_plan_seal_body` consumes it and rejects pieces that
+// overlap `out`.
+class SealInput {
+ public:
+  SealInput(Span<const CRYPTO_IVEC> slices, size_t max_in,
+            Span<const uint8_t> out)
+      : slices_(slices), remaining_(max_in), out_(out) {}
+
+  // Available returns how many of the next `limit` bytes exist, without
+  // consuming or validating them.
+  size_t Available(size_t limit) const;
+
+ private:
+  // The planner walks the slices itself, so the cursor stays in registers
+  // while it copies short pieces.
+  friend bool tls_plan_seal_body(SealInput *input, size_t want, uint8_t *body,
+                                 size_t budget, CRYPTO_IOVEC *out_iovecs,
+                                 size_t *out_num, size_t *out_len);
+
+  Span<const CRYPTO_IVEC> slices_;
+  size_t index_ = 0, offset_ = 0, remaining_;
+  Span<const uint8_t> out_;
+};
+
+// kSealGatherMin is the shortest piece encrypted straight from the caller's
+// slice when a record mixes pieces; a record filled by a single piece is always
+// encrypted from it. Each gathered piece is one more CRYPTO_gcm128_encrypt
+// call, which costs about as much as copying a few KiB, so shorter pieces are
+// copied into the record and encrypted there. 1, 2 and 8 KiB measured no
+// better.
+inline constexpr size_t kSealGatherMin = 4096;
+
+// tls_plan_seal_body lays out the next record body of at most `want` bytes at
+// `body` and writes its pieces to `out_iovecs`, at most `budget` of them, in
+// order. Pieces it does not gather are copied to `body`. On failure it zeroes
+// what it copied.
+bool tls_plan_seal_body(SealInput *input, size_t want, uint8_t *body,
+                        size_t budget, CRYPTO_IOVEC *out_iovecs,
+                        size_t *out_num, size_t *out_len);
+
+// tls_seal_body_iovec_budget returns how many body pieces one record may use
+// with the current write cipher.
+size_t tls_seal_body_iovec_budget(const SSLImpl *ssl);
+
+// tls_seal_app_data_record seals the next record of at most `want` input
+// bytes at the start of `out`, which has room for `want` plus
+// `SSL_max_seal_overhead`. `*out_consumed` is zero once the input is
+// exhausted.
+bool tls_seal_app_data_record(SSLImpl *ssl, Span<uint8_t> out,
+                              SealInput *input, size_t want,
+                              size_t prefix_len, size_t budget,
+                              size_t *out_len, size_t *out_consumed);
+
 bool tls_new(SSLImpl *ssl);
 void tls_free(SSLImpl *ssl);
 
diff --git a/ssl/s3_pkt.cc b/ssl/s3_pkt.cc
--- a/ssl/s3_pkt.cc
+++ b/ssl/s3_pkt.cc
@@ -64,7 +64,7 @@ int tls_write_app_data(SSLImpl *ssl, bool *out_needs_handshake,
   const bool is_early_data_write =
       !ssl->server && SSL_in_early_data(ssl) && ssl->s3->hs->can_early_write;
   for (;;) {
-    size_t max_send_fragment = tls_max_send_fragment(ssl);
+    size_t max_send_fragment = tls_app_data_fragment(ssl);
     if (is_early_data_write) {
       SSL_HANDSHAKE *hs = ssl->s3->hs.get();
       if (hs->early_data_written >= hs->early_session->ticket_max_early_data) {
@@ -112,6 +112,152 @@ int tls_write_app_data(SSLImpl *ssl, bool *out_needs_handshake,
   }
 }
 
+size_t tls_app_data_fragment(const SSLImpl *ssl) {
+  return tls_max_send_fragment(ssl);
+}
+
+bool tls_can_seal_app_data(const SSLImpl *ssl) {
+  return !SSL_is_dtls(ssl) && !SSL_is_quic(ssl) &&
+         ssl->do_handshake != nullptr &&
+         // Handshake, 0-RTT, False Start, half-RTT and renegotiation need
+         // `SSL_write`.
+         !SSL_in_init(ssl) &&
+         // close_notify or a fatal alert was sent, or one is being dispatched
+         // (`ssl_send_alert_impl` sets both).
+         ssl->s3->write_shutdown == ssl_shutdown_none &&
+         ssl->s3->aead_write_ctx != nullptr &&
+         !ssl->s3->aead_write_ctx->is_null_cipher() &&
+         // Unflushed records and owed retries go through the `BIO` first.
+         ssl->s3->write_buffer.empty() && ssl->s3->pending_write.empty() &&
+         ssl->s3->unreported_bytes_written == 0 &&
+         // TLS 1.0 CBC 1/n-1 splitting stays in `tls_seal_scatter_record`.
+         !ssl_needs_record_splitting(ssl);
+}
+
+bool tls_seal_app_data_pending_len(const SSLImpl *ssl, size_t *out_len) {
+  size_t len = 0;
+  if (ssl->s3->pending_flight != nullptr) {
+    len = ssl->s3->pending_flight->length - ssl->s3->pending_flight_offset;
+  }
+  if (ssl->s3->pending_hs_data != nullptr &&
+      ssl->s3->pending_hs_data->length != 0) {
+    // `tls_flush_pending_hs_data` seals it as one record.
+    const size_t sealed =
+        ssl->s3->pending_hs_data->length + SSL_max_seal_overhead(ssl);
+    if (sealed < ssl->s3->pending_hs_data->length || len + sealed < len) {
+      return false;
+    }
+    len += sealed;
+  }
+  *out_len = len;
+  return true;
+}
+
+// seal_fits returns whether `room` holds `pending` bytes and one record of `n`
+// plaintext bytes.
+static bool seal_fits(size_t room, size_t pending, size_t n, size_t overhead) {
+  return room >= pending && room - pending >= (n == 0 ? 0 : n + overhead);
+}
+
+enum ssl_seal_app_data_result_t tls_seal_app_data(
+    SSLImpl *ssl, Span<uint8_t> out, size_t *out_len,
+    Span<const CRYPTO_IVEC> in, size_t max_in, size_t *out_consumed) {
+  *out_len = 0;
+  *out_consumed = 0;
+  // The slices are read record by record while `out` is written.
+  if (buffers_alias(in.data(), in.size() * sizeof(CRYPTO_IVEC), out.data(),
+                    out.size())) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_OUTPUT_ALIASES_INPUT);
+    return ssl_seal_app_data_error;
+  }
+  size_t pending;
+  if (!tls_can_seal_app_data(ssl) ||
+      !tls_seal_app_data_pending_len(ssl, &pending)) {
+    return ssl_seal_app_data_declined;
+  }
+  const size_t frag = tls_app_data_fragment(ssl);
+  const size_t overhead = SSL_max_seal_overhead(ssl);
+  SealInput input(in, max_in, out);
+
+  // Decline before changing anything if `out` cannot hold the pending records
+  // and the first record. `Available` walks the slices only when the room is
+  // tight and `max_in` may overstate the input.
+  size_t first = std::min(frag, max_in);
+  if (!seal_fits(out.size(), pending, first, overhead)) {
+    first = input.Available(first);
+    if (!seal_fits(out.size(), pending, first, overhead)) {
+      return ssl_seal_app_data_declined;
+    }
+  }
+
+  // As in `do_tls_write`, seal queued handshake messages into the flight. For
+  // TLS this does no I/O.
+  if (!tls_flush_pending_hs_data(ssl)) {
+    return ssl_seal_app_data_error;
+  }
+  Span<const uint8_t> flight;
+  if (ssl->s3->pending_flight != nullptr) {
+    flight =
+        Span(reinterpret_cast<const uint8_t *>(ssl->s3->pending_flight->data),
+             ssl->s3->pending_flight->length)
+            .subspan(ssl->s3->pending_flight_offset);
+  }
+  if (flight.size() > pending) {
+    // The bound above is wrong. Never write past it.
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return ssl_seal_app_data_error;
+  }
+
+  // Records go after the flight. The flight is copied in front only once a
+  // record is sealed, so an error never hands anything over.
+  const size_t prefix_len =
+      SSL3_RT_HEADER_LENGTH + ssl->s3->aead_write_ctx->ExplicitNonceLen();
+  const size_t budget = tls_seal_body_iovec_budget(ssl);
+  size_t pos = flight.size(), consumed = 0;
+  bool failed = false;
+  while (consumed < max_in) {
+    size_t want = std::min(frag, max_in - consumed);
+    if (out.size() - pos < want + overhead) {
+      want = input.Available(want);
+      if (want == 0 || out.size() - pos < want + overhead) {
+        break;  // whole records only
+      }
+    }
+    size_t record_len, record_in;
+    if (!tls_seal_app_data_record(ssl, out.subspan(pos), &input, want,
+                                  prefix_len, budget, &record_len,
+                                  &record_in)) {
+      failed = true;
+      break;
+    }
+    if (record_in == 0) {
+      break;  // the input ended before `max_in`
+    }
+    pos += record_len;
+    consumed += record_in;
+  }
+  if (failed && consumed == 0) {
+    return ssl_seal_app_data_error;  // the flight stays queued
+  }
+  if (failed) {
+    // The sealed records advanced the sequence number and must be sent. The
+    // cause recurs on the next call, which reports it.
+    ERR_clear_error();
+  }
+  if (!flight.empty()) {
+    OPENSSL_memcpy(out.data(), flight.data(), flight.size());
+    ssl->s3->pending_flight.reset();
+    ssl->s3->pending_flight_offset = 0;
+  }
+  if (pos != 0) {
+    // As in `do_tls_write`, progress uncorks KeyUpdate acknowledgments.
+    ssl->s3->key_update_pending = false;
+  }
+  *out_len = pos;
+  *out_consumed = consumed;
+  return ssl_seal_app_data_success;
+}
+
 // tls_seal_align_prefix_len returns the length of the prefix before the start
 // of the bulk of the ciphertext when sealing a record with `ssl`. Callers may
 // use this to align buffers.
diff --git a/ssl/ssl_aead_ctx.cc b/ssl/ssl_aead_ctx.cc
--- a/ssl/ssl_aead_ctx.cc
+++ b/ssl/ssl_aead_ctx.cc
@@ -296,28 +296,45 @@ bool SSLAEADContext::Open(Span<uint8_t> *out, uint8_t type,
