+size_t SealInput::Available(size_t limit) const {
+  limit = std::min(limit, remaining_);
+  size_t n = 0;
+  for (size_t i = index_, off = offset_; i < slices_.size() && n < limit;
+       i++, off = 0) {
+    n += std::min(slices_[i].len - off, limit - n);
+  }
+  return n;
