+      ASSERT_EQ(pending, 0u);
+
+      // Up to 600 slices of up to 20,000 bytes, about 200 KB at most.
+      static const size_t kMaxLens[] = {0, 16, 300, 4100, 20000};
+      const size_t max_len = kMaxLens[rand() % std::size(kMaxLens)];
+      const size_t num = rand() % 601;
+      std::vector<size_t> lens;
+      size_t total = 0;
+      while (lens.size() < num && total < 200000) {
+        lens.push_back(rand() % (max_len + 1));
+        total += lens.back();
+      }
+      std::vector<uint8_t> data(total);
+      for (uint8_t &b : data) {
+        b = static_cast<uint8_t>(rand());
+      }
