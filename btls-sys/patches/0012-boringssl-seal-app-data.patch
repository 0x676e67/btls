+          SealNoIO(client_.get(), Span(out.get(), max_out), &out_len, in,
+                   max_in, &consumed);
+      if (first != 0 && max_out < first + overhead) {
+        EXPECT_EQ(ret, ssl_seal_app_data_declined);
+        EXPECT_EQ(out_len, 0u);
+        EXPECT_EQ(consumed, 0u);
+        EXPECT_EQ(SSL_get_write_sequence(client_.get()), seq);
+        continue;
+      }
+      ASSERT_EQ(ret, ssl_seal_app_data_success);
+      EXPECT_LE(out_len, max_out);
+      EXPECT_LE(consumed, n);
+      EXPECT_EQ(consumed == 0, n == 0);
+      if (consumed < n) {
