+size_t tls_seal_body_iovec_budget(const SSLImpl *ssl) {
+  // Every cipher encrypts a record filled by a single piece straight from the
+  // caller's slice. Only AES-GCM gathers several pieces into one record:
+  // ChaCha20-Poly1305's one-pass assembly takes at most two entries, and TLS
+  // 1.3 spends one on the content type. CBC stays at one entry too:
+  // SealScatterTest shows mixed entries seal correctly, but gathering them is
+  // unmeasured for CBC.
+  const SSL_CIPHER *cipher = ssl->s3->aead_write_ctx->cipher();
+  if ((cipher->algorithm_enc & (SSL_AES128GCM | SSL_AES256GCM)) == 0) {
+    return 1;
+  }
+  return size_t{CRYPTO_IOVEC_MAX} -
+         (ssl_protocol_version(ssl) >= TLS1_3_VERSION ? 1 : 0);
+}
+
+// seal_copy copies `len` bytes of a piece into the record body. Pieces of at
+// most 32 bytes, as from many small slices, are copied with fixed-size moves
+// rather than a call.
+static void seal_copy(uint8_t *dst, const uint8_t *src, size_t len) {
+  if (len > 32) {
+    OPENSSL_memcpy(dst, src, len);
+  } else if (len >= 16) {
+    OPENSSL_memcpy(dst, src, 16);
+    OPENSSL_memcpy(dst + len - 16, src + len - 16, 16);
+  } else if (len >= 8) {
+    OPENSSL_memcpy(dst, src, 8);
+    OPENSSL_memcpy(dst + len - 8, src + len - 8, 8);
+  } else if (len >= 4) {
+    OPENSSL_memcpy(dst, src, 4);
+    OPENSSL_memcpy(dst + len - 4, src + len - 4, 4);
+  } else if (len > 0) {
+    dst[0] = src[0];
+    dst[len / 2] = src[len / 2];
+    dst[len - 1] = src[len - 1];
+  }
+}
