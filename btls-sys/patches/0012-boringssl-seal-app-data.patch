+TEST_P(SSLVersionTest, SealAppDataSendsRestOfFlight) {
+  if (is_dtls() || !is_tls13()) {
+    return;
+  }
+
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  // Reading a KeyUpdate request queues the server's acknowledgement.
+  ASSERT_TRUE(SSL_key_update(client_.get(), SSL_KEY_UPDATE_REQUESTED));
+  ASSERT_EQ(SSL_write(client_.get(), "x", 1), 1);
+  uint8_t byte;
+  ASSERT_EQ(SSL_read(server_.get(), &byte, 1), 1);
+  SSLImpl *server = FromOpaque(server_.get());
+  ASSERT_TRUE(server->s3->pending_flight);
+
+  // As if `tls_flush` had written part of the flight before blocking.
+  const size_t flight_len = server->s3->pending_flight->length;
+  const size_t sent = flight_len / 2;
+  ASSERT_GT(sent, 0u);
+  ASSERT_EQ(BIO_write(SSL_get_wbio(server_.get()),
+                      server->s3->pending_flight->data, static_cast<int>(sent)),
+            static_cast<int>(sent));
+  server->s3->pending_flight_offset = sent;
+
+  size_t frag, overhead, pending;
+  ASSERT_TRUE(SSL_seal_app_data_limits(server_.get(), &frag, &overhead,
+                                       &pending));
+  EXPECT_EQ(pending, flight_len - sent);
+  static const uint8_t kData[] = "hello";
+  std::vector<uint8_t> out(pending + sizeof(kData) + overhead);
+  const CRYPTO_IVEC in = {kData, sizeof(kData)};
+  size_t out_len, consumed;
+  ASSERT_EQ(SealNoIO(server_.get(), Span(out), &out_len, Span(&in, 1),
+                     sizeof(kData), &consumed),
+            ssl_seal_app_data_success);
+  EXPECT_EQ(consumed, sizeof(kData));
+  EXPECT_FALSE(server->s3->pending_flight);
+  EXPECT_EQ(server->s3->pending_flight_offset, 0u);
+
+  // The client reads the rest of the acknowledgement, then the data.
+  std::vector<uint8_t> received;
+  ASSERT_TRUE(SendToPeer(server_.get(), client_.get(),
+                         Span(out.data(), out_len), &received));
+  EXPECT_TRUE(Bytes(received) == Bytes(kData));
+}
