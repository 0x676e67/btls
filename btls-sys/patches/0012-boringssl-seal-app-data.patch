-                                 Span<const uint8_t> header, const uint8_t *in,
-                                 size_t in_len, const uint8_t *extra_in,
-                                 size_t extra_in_len) {
+bool SSLAEADContext::SealScatterv(uint8_t *out_prefix,
+                                  Span<const CRYPTO_IOVEC> body,
+                                  uint8_t *out_suffix, uint8_t type,
+                                  uint16_t record_version, uint64_t seqnum,
+                                  Span<const uint8_t> header,
+                                  const uint8_t *extra_in,
+                                  size_t extra_in_len) {
+  if (body.size() + (extra_in_len != 0 ? 1 : 0) > CRYPTO_IOVEC_MAX) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+  // The body is one record, so its length cannot overflow.
+  size_t in_len = 0;
+  for (const CRYPTO_IOVEC &v : body) {
+    in_len += v.len;
+  }
   const size_t prefix_len = ExplicitNonceLen();
   size_t suffix_len;
   if (!SuffixLen(&suffix_len, in_len, extra_in_len)) {
     OPENSSL_PUT_ERROR(SSL, SSL_R_RECORD_TOO_LARGE);
     return false;
   }
-  if ((in != out && buffers_alias(in, in_len, out, in_len)) ||
-      buffers_alias(in, in_len, out_prefix, prefix_len) ||
-      buffers_alias(in, in_len, out_suffix, suffix_len)) {
-    OPENSSL_PUT_ERROR(SSL, SSL_R_OUTPUT_ALIASES_INPUT);
-    return false;
+  // Each entry is in place or reads from outside the record. This also covers
+  // the explicit nonce, which is `prefix_len` bytes when it is in the record.
+  const uint8_t *body_out = body.empty() ? nullptr : body[0].out;
+  for (const CRYPTO_IOVEC &v : body) {
+    if ((v.in != v.out && buffers_alias(v.in, v.len, body_out, in_len)) ||
+        buffers_alias(v.in, v.len, out_prefix, prefix_len) ||
+        buffers_alias(v.in, v.len, out_suffix, suffix_len)) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_OUTPUT_ALIASES_INPUT);
+      return false;
+    }
   }
 
   if (is_null_cipher() || CRYPTO_fuzzer_mode_enabled()) {
     // Handle the initial NULL cipher.
-    OPENSSL_memmove(out, in, in_len);
+    for (const CRYPTO_IOVEC &v : body) {
+      OPENSSL_memmove(v.out, v.in, v.len);
+    }
     OPENSSL_memmove(out_suffix, extra_in, extra_in_len);
     return true;
   }
@@ -356,10 +373,7 @@ bool SSLAEADContext::SealScatter(uint8_t *out_prefix, uint8_t *out,
   // Emit the variable nonce if included in the record.
   if (variable_nonce_included_in_record_) {
     assert(!xor_fixed_nonce_);
-    if (buffers_alias(in, in_len, out_prefix, variable_nonce_len_)) {
-      OPENSSL_PUT_ERROR(SSL, SSL_R_OUTPUT_ALIASES_INPUT);
-      return false;
-    }
+    assert(prefix_len == variable_nonce_len_);
     OPENSSL_memcpy(out_prefix, nonce + fixed_nonce_.size(),
                    variable_nonce_len_);
   }
@@ -372,12 +386,38 @@ bool SSLAEADContext::SealScatter(uint8_t *out_prefix, uint8_t *out,
     }
   }
 
-  size_t written_suffix_len;
-  bool result = !!EVP_AEAD_CTX_seal_scatter(
-      ctx_.get(), out, out_suffix, &written_suffix_len, suffix_len, nonce,
-      nonce_len, in, in_len, extra_in, extra_in_len, ad.data(), ad.size());
-  assert(!result || written_suffix_len == suffix_len);
-  return result;
+  // This is `EVP_AEAD_CTX_seal_scatter` with the body split into entries:
+  // `extra_in` is encrypted to the start of the suffix and the tag follows.
+  CRYPTO_IOVEC iovecs[CRYPTO_IOVEC_MAX];
+  size_t num_iovecs = 0;
+  for (const CRYPTO_IOVEC &v : body) {
+    iovecs[num_iovecs++] = v;
+  }
+  if (extra_in_len != 0) {
+    iovecs[num_iovecs++] = {out_suffix, extra_in, extra_in_len};
+  }
+  const CRYPTO_IVEC aad = {ad.data(), ad.size()};
+  size_t tag_len;
+  // On failure, `EVP_AEAD_CTX_sealv` zeroes every output and the tag.
+  if (!EVP_AEAD_CTX_sealv(ctx_.get(), iovecs, num_iovecs,
+                          out_suffix + extra_in_len, &tag_len,
+                          suffix_len - extra_in_len, nonce, nonce_len, &aad,
+                          1)) {
+    return false;
+  }
+  assert(tag_len + extra_in_len == suffix_len);
+  return true;
+}
+
+bool SSLAEADContext::SealScatter(uint8_t *out_prefix, uint8_t *out,
+                                 uint8_t *out_suffix, uint8_t type,
+                                 uint16_t record_version, uint64_t seqnum,
+                                 Span<const uint8_t> header, const uint8_t *in,
+                                 size_t in_len, const uint8_t *extra_in,
+                                 size_t extra_in_len) {
+  const CRYPTO_IOVEC body = {out, in, in_len};
+  return SealScatterv(out_prefix, Span(&body, 1), out_suffix, type,
+                      record_version, seqnum, header, extra_in, extra_in_len);
 }
 
 bool SSLAEADContext::Seal(uint8_t *out, size_t *out_len, size_t max_out_len,
diff --git a/ssl/ssl_internal_test.cc b/ssl/ssl_internal_test.cc
