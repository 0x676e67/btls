+TEST_P(SSLVersionTest, SealAppDataRoundTrip) {
+  if (is_dtls()) {
+    return;
+  }
+
+  struct Shape {
+    std::vector<size_t> lens;
+    size_t max_in = SIZE_MAX;
+  };
+  const Shape kShapes[] = {
+      {{100}},
+      {std::vector<size_t>(64, 64)},
+      {std::vector<size_t>(512, 32)},
+      {std::vector<size_t>(16, 1024)},
+      {std::vector<size_t>(4, 4096)},
+      {std::vector<size_t>(8, 2048)},
+      {{10000, 7000}},
+      {{9, 16384, 9, 16384, 9, 16384, 9, 16384}},
+      {{16384 * 4}},
+      {{1, 16383, 16385}},
+      {{0, 3, 16384, 0, 40965, 1, 0, 32771}},
+      {std::vector<size_t>(20000, 1)},
+      // `max_in` ends inside a slice.
+      {{10000, 7000}, 12345},
+  };
+
+  for (const SealCipher &cipher : kSealCiphers) {
+    if (!SealCipherApplies(cipher, version())) {
+      continue;
+    }
+    SCOPED_TRACE(SSL_CIPHER_standard_name(SSL_get_cipher_by_value(cipher.id)));
+    ASSERT_NO_FATAL_FAILURE(ResetContexts());
+    ASSERT_TRUE(ConfigureSealCipher(client_ctx_.get(), server_ctx_.get(),
+                                    cipher, version()));
+    ASSERT_TRUE(Connect());
+    ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+    ASSERT_EQ(SSL_CIPHER_get_protocol_id(SSL_get_current_cipher(client_.get())),
+              cipher.id);
+
+    for (size_t max_frag : {size_t{16384}, size_t{512}}) {
+      SCOPED_TRACE(max_frag);
+      ASSERT_TRUE(SSL_set_max_send_fragment(client_.get(), max_frag));
+      for (const Shape &shape : kShapes) {
+        SCOPED_TRACE(shape.lens.size());
+        size_t total = 0;
+        for (size_t len : shape.lens) {
+          total += len;
+        }
+        std::vector<uint8_t> data(total);
+        RAND_bytes(data.data(), data.size());
+
+        size_t frag, overhead, pending;
+        ASSERT_TRUE(SSL_seal_app_data_limits(client_.get(), &frag, &overhead,
+                                             &pending));
+        EXPECT_EQ(frag, max_frag);
+        EXPECT_EQ(overhead, SSL_max_seal_overhead(client_.get()));
+        EXPECT_EQ(pending, 0u);
+
+        const size_t n = std::min(shape.max_in, total);
+        const size_t max_out = n + (n + frag - 1) / frag * overhead;
+        auto out = std::make_unique<uint8_t[]>(max_out);
+        std::vector<CRYPTO_IVEC> in =
+            SliceInput(data, shape.lens, Span(out.get(), max_out));
+        const uint64_t seq = SSL_get_write_sequence(client_.get());
+        size_t out_len, consumed;
+        ASSERT_EQ(SealNoIO(client_.get(), Span(out.get(), max_out), &out_len,
+                           in, shape.max_in, &consumed),
+                  ssl_seal_app_data_success);
+        EXPECT_EQ(consumed, n);
+        EXPECT_LE(out_len, max_out);
+        ASSERT_NO_FATAL_FAILURE(CheckSealedRecords(
+            client_.get(), Span(out.get(), out_len), consumed, frag, overhead));
+        EXPECT_EQ(SSL_get_write_sequence(client_.get()) - seq,
+                  (consumed + frag - 1) / frag);
+
+        std::vector<uint8_t> received;
+        ASSERT_TRUE(SendToPeer(client_.get(), server_.get(),
+                               Span(out.get(), out_len), &received));
+        EXPECT_TRUE(Bytes(received) == Bytes(Span(data).first(n)));
+
+        // `SSL_write` continues where sealing stopped.
+        ASSERT_EQ(SSL_write(client_.get(), "x", 1), 1);
+        uint8_t byte;
+        ASSERT_EQ(SSL_read(server_.get(), &byte, 1), 1);
+        EXPECT_EQ(byte, 'x');
+      }
+    }
+  }
+}
