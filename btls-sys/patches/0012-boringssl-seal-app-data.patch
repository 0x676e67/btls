+// SealCipher is a cipher suite `SSL_seal_app_data` is tested with. TLS 1.3
+// suites are selected through the server's AES hardware override and policy.
+struct SealCipher {
+  uint16_t id;
+  bool aes_hw = true;
+  bool cnsa = false;
+};
+
+static const SealCipher kSealCiphers[] = {
+    {SSL_CIPHER_AES_128_GCM_SHA256},
+    {SSL_CIPHER_AES_256_GCM_SHA384, /*aes_hw=*/true, /*cnsa=*/true},
+    {SSL_CIPHER_CHACHA20_POLY1305_SHA256, /*aes_hw=*/false},
+    {SSL_CIPHER_ECDHE_RSA_WITH_AES_128_GCM_SHA256},
+    {SSL_CIPHER_ECDHE_RSA_WITH_AES_256_GCM_SHA384},
+    {SSL_CIPHER_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256},
+    {SSL_CIPHER_ECDHE_RSA_WITH_AES_128_CBC_SHA},
+    {SSL_CIPHER_ECDHE_RSA_WITH_AES_256_CBC_SHA384},
+    {SSL_CIPHER_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA},
+};
+
+static bool SealCipherApplies(const SealCipher &cipher, uint16_t version) {
+  const SSL_CIPHER *c = SSL_get_cipher_by_value(cipher.id);
+  return c != nullptr && SSL_CIPHER_get_min_version(c) <= version &&
+         version <= SSL_CIPHER_get_max_version(c);
+}
+
+// ConfigureSealCipher makes `client_ctx` and `server_ctx` negotiate `cipher`.
+static bool ConfigureSealCipher(SSL_CTX *client_ctx, SSL_CTX *server_ctx,
+                                const SealCipher &cipher, uint16_t version) {
+  if (version >= TLS1_3_VERSION) {
+    SSL_CTX_set_aes_hw_override_for_testing(server_ctx, cipher.aes_hw);
+    return !cipher.cnsa ||
+           SSL_CTX_set_compliance_policy(server_ctx,
+                                         ssl_compliance_policy_cnsa_202407);
+  }
+  const char *name =
+      SSL_CIPHER_standard_name(SSL_get_cipher_by_value(cipher.id));
+  return SSL_CTX_set_strict_cipher_list(client_ctx, name) &&
+         SSL_CTX_set_strict_cipher_list(server_ctx, name);
+}
+
+// SealNoIO calls `SSL_seal_app_data` with `ssl`'s write `BIO` replaced by one
+// that fails the test when written to or flushed.
+static ssl_seal_app_data_result_t SealNoIO(SSL *ssl, Span<uint8_t> out,
+                                           size_t *out_len,
+                                           Span<const CRYPTO_IVEC> in,
+                                           size_t max_in,
+                                           size_t *out_consumed) {
+  UniquePtr<BIO_METHOD> method(BIO_meth_new(0, "tripwire"));
+  BSSL_CHECK(method);
+  BSSL_CHECK(BIO_meth_set_write(
+      method.get(), [](BIO *bio, const char *in_, int len) -> int {
+        ADD_FAILURE() << "SSL_seal_app_data wrote to the BIO";
+        return -1;
+      }));
+  BSSL_CHECK(BIO_meth_set_ctrl(
+      method.get(), [](BIO *bio, int cmd, long larg, void *parg) -> long {
+        if (cmd == BIO_CTRL_FLUSH) {
+          ADD_FAILURE() << "SSL_seal_app_data flushed the BIO";
+        }
+        return 0;
+      }));
+  UniquePtr<BIO> tripwire(BIO_new(method.get()));
+  BSSL_CHECK(tripwire);
+  BIO_set_init(tripwire.get(), 1);
+
+  BIO *wbio = SSL_get_wbio(ssl);
+  if (wbio != nullptr) {
+    BIO_up_ref(wbio);
+  }
+  SSL_set0_wbio(ssl, tripwire.release());
+  ssl_seal_app_data_result_t ret =
+      SSL_seal_app_data(ssl, out.data(), out_len, out.size(), in.data(),
+                        in.size(), max_in, out_consumed);
+  SSL_set0_wbio(ssl, wbio);
+  return ret;
+}
+
+// ReadAvailable appends what `ssl` reads, until it would block, to `out`.
+static bool ReadAvailable(SSL *ssl, std::vector<uint8_t> *out) {
+  uint8_t buf[4096];
+  for (;;) {
+    int ret = SSL_read(ssl, buf, sizeof(buf));
+    if (ret <= 0) {
+      return SSL_get_error(ssl, ret) == SSL_ERROR_WANT_READ;
+    }
+    out->insert(out->end(), buf, buf + ret);
+  }
+}
+
+// SendToPeer writes `data`, which `ssl` sealed, to `ssl`'s transport and
+// appends what `peer` then reads to `out`.
+static bool SendToPeer(SSL *ssl, SSL *peer, Span<const uint8_t> data,
+                       std::vector<uint8_t> *out) {
+  BIO *bio = SSL_get_wbio(ssl);
+  while (!data.empty()) {
+    int ret = BIO_write(bio, data.data(),
+                        static_cast<int>(std::min(data.size(), size_t{1024})));
+    if (ret > 0) {
+      data = data.subspan(static_cast<size_t>(ret));
+      continue;
+    }
+    // The transport is full. Let the peer drain it.
+    if (!ReadAvailable(peer, out) || BIO_ctrl_get_write_guarantee(bio) == 0) {
+      return false;
+    }
+  }
+  return ReadAvailable(peer, out);
+}
+
+// SliceInput returns slices of `data` with lengths `lens`, in order. Empty
+// slices get bogus pointers, which must not be read: one inside `out`, one
+// that points nowhere, and NULL.
+static std::vector<CRYPTO_IVEC> SliceInput(Span<const uint8_t> data,
+                                           Span<const size_t> lens,
+                                           Span<const uint8_t> out) {
+  const uint8_t *bogus[] = {out.size() > 1 ? out.data() + 1 : nullptr,
+                            reinterpret_cast<const uint8_t *>(uintptr_t{1}),
+                            nullptr};
+  std::vector<CRYPTO_IVEC> ret;
+  size_t num_empty = 0;
+  for (size_t len : lens) {
+    if (len == 0) {
+      ret.push_back({bogus[num_empty++ % std::size(bogus)], 0});
+      continue;
+    }
+    ret.push_back({data.data(), len});
+    data = data.subspan(len);
+  }
+  return ret;
+}
+
+// RecordLengths sets `*out` to the lengths, with headers, of the application
+// data records that make up `in`.
+static bool RecordLengths(Span<const uint8_t> in, std::vector<size_t> *out) {
+  out->clear();
+  CBS cbs(in);
+  while (CBS_len(&cbs) != 0) {
+    uint8_t type;
+    uint16_t record_version;
+    CBS body;
+    if (!CBS_get_u8(&cbs, &type) || type != SSL3_RT_APPLICATION_DATA ||
+        !CBS_get_u16(&cbs, &record_version) ||
+        !CBS_get_u16_length_prefixed(&cbs, &body)) {
+      return false;
+    }
+    out->push_back(SSL3_RT_HEADER_LENGTH + CBS_len(&body));
+  }
+  return true;
+}
+
+// CheckSealedRecords checks that `records`, sealed by `ssl` from `consumed`
+// bytes, is the fewest records of at most `frag` bytes, and that every record
+// but the last carries `frag` bytes. The record sizes are exact only for AEAD
+// ciphers, whose overhead is fixed.
+static void CheckSealedRecords(const SSL *ssl, Span<const uint8_t> records,
+                               size_t consumed, size_t frag, size_t overhead) {
+  std::vector<size_t> lens;
+  ASSERT_TRUE(RecordLengths(records, &lens));
+  ASSERT_EQ(lens.size(), (consumed + frag - 1) / frag);
+  if (!SSL_CIPHER_is_aead(SSL_get_current_cipher(ssl)) || lens.empty()) {
+    return;
+  }
+  for (size_t i = 0; i + 1 < lens.size(); i++) {
+    EXPECT_EQ(lens[i], frag + overhead) << "record " << i;
+  }
+  EXPECT_EQ(lens.back(), consumed - (lens.size() - 1) * frag + overhead);
+}
+
+// SealToPeer seals `data` on `ssl` in one call, with `out` sized exactly by
+// `SSL_seal_app_data_limits`, and checks that `peer` reads back `data`. It
+// sets `*out_pending` to the pending length the limits reported and
+// `*out_records` to the number of records written, including pending ones.
+static void SealToPeer(SSL *ssl, SSL *peer, Span<const uint8_t> data,
+                       size_t *out_pending = nullptr,
+                       size_t *out_records = nullptr) {
+  size_t frag, overhead, pending;
+  ASSERT_TRUE(SSL_seal_app_data_limits(ssl, &frag, &overhead, &pending));
+  const size_t max_out =
+      pending + data.size() + (data.size() + frag - 1) / frag * overhead;
+  auto out = std::make_unique<uint8_t[]>(max_out);
+  const CRYPTO_IVEC in = {data.data(), data.size()};
+  // Queued handshake messages are sealed as one record now. A pending flight
+  // was sealed earlier, possibly under the previous key.
+  const BUF_MEM *hs_data = FromOpaque(ssl)->s3->pending_hs_data.get();
+  const uint64_t new_records =
+      (hs_data != nullptr && hs_data->length != 0 ? 1 : 0) +
+      (data.size() + frag - 1) / frag;
+  const uint64_t seq = SSL_get_write_sequence(ssl);
+  size_t out_len, consumed;
+  ASSERT_EQ(SealNoIO(ssl, Span(out.get(), max_out), &out_len, Span(&in, 1),
+                     data.size(), &consumed),
+            ssl_seal_app_data_success);
+  EXPECT_EQ(consumed, data.size());
+  EXPECT_LE(out_len, max_out);
+  std::vector<size_t> lens;
+  ASSERT_TRUE(RecordLengths(Span(out.get(), out_len), &lens));
+  EXPECT_EQ(SSL_get_write_sequence(ssl) - seq, new_records);
+
+  std::vector<uint8_t> received;
+  ASSERT_TRUE(SendToPeer(ssl, peer, Span(out.get(), out_len), &received));
+  EXPECT_TRUE(Bytes(received) == Bytes(data));
+  if (out_pending != nullptr) {
+    *out_pending = pending;
+  }
+  if (out_records != nullptr) {
+    *out_records = lens.size();
+  }
+}
