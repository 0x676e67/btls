 }
 
+// ReadTransport appends the bytes `ssl`'s peer sent it, and it has not read,
+// to `out`.
+static bool ReadTransport(SSL *ssl, std::vector<uint8_t> *out) {
+  BIO *bio = SSL_get_rbio(ssl);
+  uint8_t buf[4096];
+  for (;;) {
+    int ret = BIO_read(bio, buf, sizeof(buf));
+    if (ret <= 0) {
+      return BIO_should_read(bio);
+    }
+    out->insert(out->end(), buf, buf + ret);
+  }
+}
+
+// WriteToWire writes `data` on `ssl` and moves the records it sent `peer` from
+// the transport to `wire`.
+static bool WriteToWire(SSL *ssl, SSL *peer, Span<const uint8_t> data,
+                        std::vector<uint8_t> *wire) {
+  for (;;) {
+    int ret = SSL_write(ssl, data.data(), static_cast<int>(data.size()));
+    if (!ReadTransport(peer, wire)) {
+      return false;
+    }
+    if (ret > 0) {
+      return static_cast<size_t>(ret) == data.size();
+    }
+    if (SSL_get_error(ssl, ret) != SSL_ERROR_WANT_WRITE) {
+      return false;
+    }
+  }
+}
+
+// WireRecordLen returns the length, with its header, of the record `wire`
+// starts with.
+static size_t WireRecordLen(Span<const uint8_t> wire) {
+  BSSL_CHECK(wire.size() >= SSL3_RT_HEADER_LENGTH);
+  return SSL3_RT_HEADER_LENGTH + ((size_t{wire[3]} << 8) | wire[4]);
+}
+
+// OpenNoIO calls `SSL_open_app_data` with `ssl`'s `BIO`s replaced by one that
+// fails the test when read, written to or flushed.
+static ssl_open_app_data_result_t OpenNoIO(SSL *ssl, Span<uint8_t> in,
+                                           size_t *out_consumed,
+                                           Span<uint8_t> *out) {
+  UniquePtr<BIO_METHOD> method(BIO_meth_new(0, "tripwire"));
+  BSSL_CHECK(method);
+  BSSL_CHECK(
+      BIO_meth_set_read(method.get(), [](BIO *bio, char *out_, int len) -> int {
+        ADD_FAILURE() << "SSL_open_app_data read from the BIO";
+        return -1;
+      }));
+  BSSL_CHECK(BIO_meth_set_write(
+      method.get(), [](BIO *bio, const char *in_, int len) -> int {
+        ADD_FAILURE() << "SSL_open_app_data wrote to the BIO";
+        return -1;
+      }));
+  BSSL_CHECK(BIO_meth_set_ctrl(
+      method.get(), [](BIO *bio, int cmd, long larg, void *parg) -> long {
+        if (cmd == BIO_CTRL_FLUSH) {
+          ADD_FAILURE() << "SSL_open_app_data flushed the BIO";
+        }
+        return 0;
+      }));
+  UniquePtr<BIO> tripwire(BIO_new(method.get()));
+  BSSL_CHECK(tripwire);
+  BIO_set_init(tripwire.get(), 1);
+
+  BIO *rbio = SSL_get_rbio(ssl);
+  BIO *wbio = SSL_get_wbio(ssl);
+  if (rbio != nullptr) {
+    BIO_up_ref(rbio);
+  }
+  if (wbio != nullptr) {
+    BIO_up_ref(wbio);
+  }
+  SSL_set0_rbio(ssl, UpRef(tripwire).release());
+  SSL_set0_wbio(ssl, tripwire.release());
+  uint8_t *data = in.data();
+  size_t len = 1;
+  ssl_open_app_data_result_t ret = SSL_open_app_data(
+      ssl, in.data(), in.size(), out_consumed, &data, &len);
+  if (len == 0) {
+    EXPECT_EQ(data, nullptr);
+  }
+  *out = Span(data, len);
+  SSL_set0_rbio(ssl, rbio);
+  SSL_set0_wbio(ssl, wbio);
+  return ret;
+}
+
+// OpenWire opens the records `wire` holds on `ssl`. It appends their plaintext
+// to `out` and sets `*out_empty` to the number of records without any.
+static void OpenWire(SSL *ssl, Span<uint8_t> wire, std::vector<uint8_t> *out,
+                     size_t *out_empty) {
+  *out_empty = 0;
+  while (!wire.empty()) {
+    size_t consumed;
+    Span<uint8_t> plaintext;
+    ASSERT_EQ(OpenNoIO(ssl, wire, &consumed, &plaintext),
+              ssl_open_app_data_success);
+    ASSERT_EQ(consumed, WireRecordLen(wire));
+    if (plaintext.empty()) {
+      (*out_empty)++;
+    }
+    out->insert(out->end(), plaintext.begin(), plaintext.end());
+    wire = wire.subspan(consumed);
+  }
+  EXPECT_EQ(ERR_peek_error(), 0u);
+}
+
+TEST_P(SSLVersionTest, OpenAppDataRoundTrip) {
+  if (is_dtls()) {
+    return;
+  }
+
+  // Records of one byte, of a full fragment, and in between.
+  static const size_t kLens[] = {1, 100, 16384, 16383};
+  std::vector<uint8_t> data(1 + 100 + 16384 + 16383);
+  RAND_bytes(data.data(), data.size());
+
+  for (const SealCipher &cipher : kSealCiphers) {
+    if (!SealCipherApplies(cipher, version())) {
+      continue;
+    }
+    SCOPED_TRACE(SSL_CIPHER_standard_name(SSL_get_cipher_by_value(cipher.id)));
+    ASSERT_NO_FATAL_FAILURE(ResetContexts());
+    ASSERT_TRUE(ConfigureSealCipher(client_ctx_.get(), server_ctx_.get(),
+                                    cipher, version()));
+    ASSERT_TRUE(Connect());
+    ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+
+    for (bool from_server : {true, false}) {
+      SCOPED_TRACE(from_server);
+      SSL *writer = from_server ? server_.get() : client_.get();
+      SSL *reader = from_server ? client_.get() : server_.get();
+      std::vector<uint8_t> wire;
+      size_t offset = 0;
+      for (size_t len : kLens) {
+        ASSERT_TRUE(WriteToWire(writer, reader,
+                                Span(data).subspan(offset, len), &wire));
+        offset += len;
+      }
+
+      const uint64_t seq = SSL_get_read_sequence(reader);
+      std::vector<uint8_t> received;
+      Span<uint8_t> rest(wire);
+      size_t records = 0;
+      while (!rest.empty()) {
+        const size_t record_len = WireRecordLen(rest);
+        ASSERT_LE(record_len, rest.size());
+        const std::vector<uint8_t> before(rest.begin(), rest.end());
+        size_t consumed;
+        Span<uint8_t> plaintext;
+
+        // A record cut short needs its header, then its whole length, and
+        // changes nothing.
+        for (size_t prefix : {size_t{0}, size_t{4}, size_t{5}, record_len - 1}) {
+          ASSERT_EQ(OpenNoIO(reader, rest.first(prefix), &consumed, &plaintext),
+                    ssl_open_app_data_partial);
+          EXPECT_EQ(consumed,
+                    prefix < SSL3_RT_HEADER_LENGTH ? size_t{SSL3_RT_HEADER_LENGTH}
+                                                   : record_len);
+          EXPECT_TRUE(plaintext.empty());
+        }
+        EXPECT_EQ(Bytes(rest), Bytes(before));
+        EXPECT_EQ(SSL_get_read_sequence(reader), seq + records);
+
+        // One record opens in place, and the input after it is not touched.
+        ASSERT_EQ(OpenNoIO(reader, rest, &consumed, &plaintext),
+                  ssl_open_app_data_success);
+        ASSERT_EQ(consumed, record_len);
+        ASSERT_FALSE(plaintext.empty());
+        EXPECT_GE(plaintext.data(), rest.data() + SSL3_RT_HEADER_LENGTH);
+        EXPECT_LE(plaintext.data() + plaintext.size(),
+                  rest.data() + record_len);
+        EXPECT_EQ(Bytes(rest.subspan(record_len)),
+                  Bytes(Span(before).subspan(record_len)));
+        received.insert(received.end(), plaintext.begin(), plaintext.end());
+        rest = rest.subspan(record_len);
+        records++;
+        EXPECT_EQ(ERR_peek_error(), 0u);
+      }
+      EXPECT_EQ(records, std::size(kLens));
+      EXPECT_EQ(Bytes(received), Bytes(data));
+
+      // Nothing is left for `SSL_read`.
+      uint8_t byte;
+      EXPECT_EQ(SSL_pending(reader), 0);
+      EXPECT_EQ(SSL_read(reader, &byte, 1), -1);
+      EXPECT_EQ(SSL_get_error(reader, -1), SSL_ERROR_WANT_READ);
+    }
+  }
+}
+
+// Records that carry post-handshake messages open as records without
+// application data, once the messages are processed.
+TEST_P(SSLVersionTest, OpenAppDataPostHandshake) {
+  if (is_dtls() || !is_tls13()) {
+    return;
+  }
+
+  static int sessions;
+  sessions = 0;
+  SSL_CTX_set_session_cache_mode(client_ctx_.get(), SSL_SESS_CACHE_CLIENT);
+  SSL_CTX_sess_set_new_cb(client_ctx_.get(), [](SSL *, SSL_SESSION *) -> int {
+    sessions++;
+    return 0;
+  });
+  ASSERT_TRUE(Connect());
+  SSLImpl *client = FromOpaque(client_.get());
+
+  // The server's first write carries its tickets.
+  static const uint8_t kData[] = "data";
+  std::vector<uint8_t> wire, received;
+  size_t empty;
+  ASSERT_TRUE(WriteToWire(server_.get(), client_.get(), kData, &wire));
+  ASSERT_NO_FATAL_FAILURE(OpenWire(client_.get(), Span(wire), &received, &empty));
+  EXPECT_GT(empty, 0u);
+  EXPECT_GT(sessions, 0);
+  EXPECT_EQ(Bytes(received), Bytes(kData));
+
+  // A KeyUpdate changes the key for the records after it, and queues the
+  // response it requests for the next write.
+  for (int request : {SSL_KEY_UPDATE_NOT_REQUESTED, SSL_KEY_UPDATE_REQUESTED}) {
+    SCOPED_TRACE(request);
+    wire.clear();
+    received.clear();
+    ASSERT_TRUE(SSL_key_update(server_.get(), request));
+    ASSERT_TRUE(WriteToWire(server_.get(), client_.get(), kData, &wire));
+    ASSERT_NO_FATAL_FAILURE(OpenWire(client_.get(), Span(wire), &received, &empty));
+    EXPECT_EQ(empty, 1u);
+    EXPECT_EQ(Bytes(received), Bytes(kData));
+    EXPECT_EQ(bool{client->s3->key_update_pending},
+              request == SSL_KEY_UPDATE_REQUESTED);
+
+    uint8_t buf[sizeof(kData)];
+    ASSERT_EQ(SSL_write(client_.get(), kData, sizeof(kData)),
+              int{sizeof(kData)});
+    ASSERT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), int{sizeof(buf)});
+    EXPECT_EQ(Bytes(buf), Bytes(kData));
+    EXPECT_FALSE(client->s3->key_update_pending);
+  }
+}
+
+TEST_P(SSLVersionTest, OpenAppDataDeclines) {
+  static const uint8_t kData[100] = {1};
+  uint8_t buf[sizeof(kData)];
+  auto expect_declined = [&](SSL *ssl, Span<const uint8_t> wire) {
+    std::vector<uint8_t> in(wire.begin(), wire.end());
+    size_t consumed = 1;
+    Span<uint8_t> plaintext;
+    EXPECT_EQ(OpenNoIO(ssl, Span(in), &consumed, &plaintext),
+              ssl_open_app_data_declined);
+    EXPECT_EQ(consumed, 0u);
+    EXPECT_TRUE(plaintext.empty());
+    EXPECT_EQ(Bytes(in), Bytes(wire));
+    EXPECT_EQ(ERR_peek_error(), 0u);
+  };
+
+  // DTLS records are never opened in caller memory.
+  if (is_dtls()) {
+    ASSERT_TRUE(Connect());
+    expect_declined(client_.get(), kData);
+    expect_declined(server_.get(), kData);
+    return;
+  }
+
+  // Neither a client nor a server yet.
+  UniquePtr<SSL> ssl(SSL_new(client_ctx_.get()));
+  ASSERT_TRUE(ssl);
+  expect_declined(ssl.get(), kData);
+
+  // Before and during the handshake.
+  ASSERT_TRUE(CreateClientAndServer(&client_, &server_, client_ctx_.get(),
+                                    server_ctx_.get()));
+  expect_declined(client_.get(), kData);
+  EXPECT_EQ(SSL_read(client_.get(), buf, sizeof(buf)), -1);
+  EXPECT_EQ(SSL_get_error(client_.get(), -1), SSL_ERROR_WANT_READ);
+  expect_declined(client_.get(), kData);
+  ASSERT_TRUE(CompleteHandshakes(client_.get(), server_.get()));
+
+  // While `SSL_read` holds part of a record, or plaintext it has not returned.
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  std::vector<uint8_t> wire;
+  ASSERT_TRUE(WriteToWire(server_.get(), client_.get(), kData, &wire));
+  const size_t record_len = wire.size();
+  ASSERT_TRUE(WriteToWire(server_.get(), client_.get(), kData, &wire));
+  BIO *transport = SSL_get_wbio(server_.get());
+  ASSERT_EQ(BIO_write(transport, wire.data(), 3), 3);
+  EXPECT_EQ(SSL_read(client_.get(), buf, sizeof(buf)), -1);
+  EXPECT_EQ(SSL_get_error(client_.get(), -1), SSL_ERROR_WANT_READ);
+  expect_declined(client_.get(), Span(wire).subspan(3));
+  ASSERT_EQ(BIO_write(transport, wire.data() + 3,
+                      static_cast<int>(record_len - 3)),
+            static_cast<int>(record_len - 3));
+  ASSERT_EQ(SSL_read(client_.get(), buf, 1), 1);
+  expect_declined(client_.get(), Span(wire).subspan(record_len));
+  ASSERT_EQ(SSL_read(client_.get(), buf, sizeof(buf)), int{sizeof(buf) - 1});
+  // Once it holds nothing, the next record opens.
+  std::vector<uint8_t> received;
+  size_t empty;
+  ASSERT_NO_FATAL_FAILURE(OpenWire(
+      client_.get(), Span(wire).subspan(record_len), &received, &empty));
+  EXPECT_EQ(Bytes(received), Bytes(kData));
+
+  // A close_notify is consumed, and `SSL_read` reports it without input.
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  wire.clear();
+  ASSERT_EQ(SSL_shutdown(server_.get()), 0);
+  ASSERT_TRUE(ReadTransport(client_.get(), &wire));
+  size_t consumed;
+  Span<uint8_t> plaintext;
+  EXPECT_EQ(OpenNoIO(client_.get(), Span(wire), &consumed, &plaintext),
+            ssl_open_app_data_declined);
+  EXPECT_EQ(consumed, wire.size());
+  EXPECT_TRUE(plaintext.empty());
+  EXPECT_EQ(ERR_peek_error(), 0u);
+  EXPECT_EQ(SSL_read(client_.get(), buf, sizeof(buf)), 0);
+  EXPECT_EQ(SSL_get_error(client_.get(), 0), SSL_ERROR_ZERO_RETURN);
+  expect_declined(client_.get(), kData);
+
+  // After the read side was shut down some other way.
+  ASSERT_TRUE(Connect());
+  SSL_set_shutdown(client_.get(), SSL_RECEIVED_SHUTDOWN);
+  expect_declined(client_.get(), kData);
+
+  ASSERT_TRUE(Connect());
+  SSL_set_quiet_shutdown(client_.get(), 1);
+  EXPECT_EQ(SSL_shutdown(client_.get()), 1);
+  expect_declined(client_.get(), kData);
+}
+
+TEST_P(SSLVersionTest, OpenAppDataErrors) {
+  if (is_dtls()) {
+    return;
+  }
+
+  static const uint8_t kData[100] = {1};
+  uint8_t buf[sizeof(kData)];
+  // expect_error opens `wire` on `ssl`, which fails after `expected_consumed`
+  // bytes. `SSL_read` then reports `reason`, and both keep failing.
+  auto expect_error = [&](SSL *ssl, Span<uint8_t> wire,
+                          size_t expected_consumed, int reason) {
+    size_t consumed, len;
+    uint8_t *data;
+    EXPECT_EQ(SSL_open_app_data(ssl, wire.data(), wire.size(), &consumed,
+                                &data, &len),
+              ssl_open_app_data_declined);
+    EXPECT_EQ(consumed, expected_consumed);
+    EXPECT_EQ(data, nullptr);
+    EXPECT_EQ(len, 0u);
+    EXPECT_EQ(ERR_peek_error(), 0u);
+    for (int i = 0; i < 2; i++) {
+      EXPECT_EQ(SSL_read(ssl, buf, sizeof(buf)), -1);
+      EXPECT_EQ(SSL_get_error(ssl, -1), SSL_ERROR_SSL);
+      EXPECT_TRUE(ERR_equals(ERR_peek_last_error(), ERR_LIB_SSL, reason));
+      ERR_clear_error();
+      EXPECT_EQ(SSL_open_app_data(ssl, wire.data(), wire.size(), &consumed,
+                                  &data, &len),
+                ssl_open_app_data_declined);
+      EXPECT_EQ(consumed, 0u);
+      EXPECT_EQ(ERR_peek_error(), 0u);
+    }
+  };
+
+  // A record that fails to open is answered with a fatal alert.
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  std::vector<uint8_t> wire;
+  ASSERT_TRUE(WriteToWire(server_.get(), client_.get(), kData, &wire));
+  wire.back() ^= 1;
+  expect_error(client_.get(), Span(wire), wire.size(),
+               SSL_R_DECRYPTION_FAILED_OR_BAD_RECORD_MAC);
+  EXPECT_EQ(SSL_read(server_.get(), buf, sizeof(buf)), -1);
+  EXPECT_EQ(SSL_get_error(server_.get(), -1), SSL_ERROR_SSL);
+  EXPECT_TRUE(ExpectSingleError(ERR_LIB_SSL, SSL_R_SSLV3_ALERT_BAD_RECORD_MAC));
+
+  // The peer's fatal alert is not answered.
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  wire.clear();
+  ASSERT_TRUE(SSL_send_fatal_alert(server_.get(), SSL_AD_INTERNAL_ERROR));
+  ASSERT_TRUE(ReadTransport(client_.get(), &wire));
+  expect_error(client_.get(), Span(wire), wire.size(),
+               SSL_R_TLSV1_ALERT_INTERNAL_ERROR);
+  std::vector<uint8_t> answer;
+  ASSERT_TRUE(ReadTransport(server_.get(), &answer));
+  EXPECT_TRUE(answer.empty());
+
+  // A header that announces an oversized record fails before its body.
+  ASSERT_TRUE(Connect());
+  ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+  wire.clear();
+  ASSERT_TRUE(WriteToWire(server_.get(), client_.get(), kData, &wire));
+  wire.resize(SSL3_RT_HEADER_LENGTH);
+  wire[3] = wire[4] = 0xff;
+  expect_error(client_.get(), Span(wire), 0,
+               SSL_R_ENCRYPTED_LENGTH_TOO_LONG);
+
+  // A post-handshake message that fails is consumed with its record.
+  if (is_tls13()) {
+    static const int kMaxKeyUpdates = 32;
+    ASSERT_TRUE(Connect());
+    ASSERT_TRUE(FlushNewSessionTickets(client_.get(), server_.get()));
+    wire.clear();
+    for (int i = 0; i <= kMaxKeyUpdates; i++) {
+      ASSERT_TRUE(SSL_key_update(server_.get(), SSL_KEY_UPDATE_NOT_REQUESTED));
+      ASSERT_EQ(SSL_write(server_.get(), nullptr, 0), 0);
+      ASSERT_TRUE(ReadTransport(client_.get(), &wire));
+    }
+    Span<uint8_t> rest(wire);
+    for (int i = 0; i < kMaxKeyUpdates; i++) {
+      size_t consumed;
+      Span<uint8_t> plaintext;
+      ASSERT_EQ(OpenNoIO(client_.get(), rest, &consumed, &plaintext),
+                ssl_open_app_data_success);
+      EXPECT_TRUE(plaintext.empty());
+      rest = rest.subspan(consumed);
+    }
+    expect_error(client_.get(), rest, rest.size(), SSL_R_TOO_MANY_KEY_UPDATES);
+  }
+}
