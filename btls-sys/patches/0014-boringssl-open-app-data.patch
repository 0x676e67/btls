+// OpenInput is the transport input `ReadOpened` pulled ahead of BoringSSL, and
+// plaintext it opened but has not returned yet.
+struct OpenInput {
+  std::vector<uint8_t> in;
+  std::vector<uint8_t> plain;
+  size_t reads = 0;
+};
+
+static int OpenBioMethodType() {
+  static int type = [] {
+    int idx = BIO_get_new_index();
+    BSSL_CHECK(idx > 0);
+    return idx | BIO_TYPE_FILTER;
+  }();
+  return type;
+}
+
+static OpenInput *GetOpenInput(BIO *bio) {
+  if (bio == nullptr || BIO_method_type(bio) != OpenBioMethodType()) {
+    return nullptr;
+  }
+  return static_cast<OpenInput *>(BIO_get_data(bio));
+}
+
+static int OpenBioWriteEx(BIO *bio, const char *in, size_t inl,
+                          size_t *out_written) {
+  BIO *next = BIO_next(bio);
+  if (next == nullptr) {
+    return 0;
+  }
+  BIO_clear_retry_flags(bio);
+  int ret = BIO_write_ex(next, in, inl, out_written);
+  if (!ret) {
+    BIO_copy_next_retry(bio);
+  }
+  return ret;
+}
+
+// OpenBioRead serves the input `ReadOpened` left behind before reading more,
+// so `SSL_read` continues where `SSL_open_app_data` stopped.
+static int OpenBioRead(BIO *bio, char *out, int outl) {
+  OpenInput *input = GetOpenInput(bio);
+  BIO *next = BIO_next(bio);
+  if (input == nullptr || next == nullptr || outl < 0) {
+    return 0;
+  }
+  BIO_clear_retry_flags(bio);
+  if (!input->in.empty()) {
+    const size_t len = std::min(input->in.size(), static_cast<size_t>(outl));
+    OPENSSL_memcpy(out, input->in.data(), len);
+    input->in.erase(input->in.begin(), input->in.begin() + len);
+    return static_cast<int>(len);
+  }
+  int ret = BIO_read(next, out, outl);
+  if (ret <= 0) {
+    BIO_copy_next_retry(bio);
+  }
+  return ret;
+}
+
+static long OpenBioCtrl(BIO *bio, int cmd, long num, void *ptr) {
+  BIO *next = BIO_next(bio);
+  if (next == nullptr) {
+    return 0;
+  }
+  BIO_clear_retry_flags(bio);
+  long ret = BIO_ctrl(next, cmd, num, ptr);
+  BIO_copy_next_retry(bio);
+  return ret;
+}
+
+static long OpenBioCallbackCtrl(BIO *bio, int cmd, BIO_info_cb *fp) {
+  BIO *next = BIO_next(bio);
+  if (next == nullptr) {
+    return 0;
+  }
+  return BIO_callback_ctrl(next, cmd, fp);
+}
+
+static int OpenBioNew(BIO *bio) {
+  BIO_set_data(bio, new OpenInput);
+  BIO_set_init(bio, 1);
+  return 1;
+}
+
+static int OpenBioFree(BIO *bio) {
+  if (bio == nullptr) {
+    return 0;
+  }
+  delete GetOpenInput(bio);
+  BIO_set_data(bio, nullptr);
+  BIO_set_init(bio, 0);
+  return 1;
+}
+
+// OpenBioCreate returns a filter `BIO` that holds an `OpenInput`.
+static bssl::UniquePtr<BIO> OpenBioCreate() {
+  static const BIO_METHOD *method = [] {
+    BIO_METHOD *ret = BIO_meth_new(OpenBioMethodType(), "open bio");
+    BSSL_CHECK(ret);
+    BSSL_CHECK(BIO_meth_set_write_ex(ret, OpenBioWriteEx));
+    BSSL_CHECK(BIO_meth_set_read(ret, OpenBioRead));
+    BSSL_CHECK(BIO_meth_set_ctrl(ret, OpenBioCtrl));
+    BSSL_CHECK(BIO_meth_set_create(ret, OpenBioNew));
+    BSSL_CHECK(BIO_meth_set_destroy(ret, OpenBioFree));
+    BSSL_CHECK(BIO_meth_set_callback_ctrl(ret, OpenBioCallbackCtrl));
+    return ret;
+  }();
+  return bssl::UniquePtr<BIO>(BIO_new(method));
+}
+
+// ReadOpened is `DoRead` through `SSL_open_app_data`. It pulls input from the
+// transport in irregular amounts, ahead of BoringSSL, and checks that opening
+// only touches the record it opened. It returns zero for `DoRead` to continue
+// with `SSL_read` where opening declines or the transport ends.
+static int ReadOpened(SSL *ssl, uint8_t *out, size_t max_out) {
+  static const size_t kReadLens[] = {1, 4, 17, 1024, 20000};
+  const TestConfig *config = GetTestConfig(ssl);
+  TestState *test_state = GetTestState(ssl);
+  BIO *bio = SSL_get_rbio(ssl);
+  OpenInput *input = GetOpenInput(bio);
+  if (input == nullptr) {
+    return 0;
+  }
+  for (;;) {
+    if (!input->plain.empty()) {
+      const size_t len = std::min(input->plain.size(), max_out);
+      OPENSSL_memcpy(out, input->plain.data(), len);
+      input->plain.erase(input->plain.begin(), input->plain.begin() + len);
+      return static_cast<int>(len);
+    }
+
+    const std::vector<uint8_t> before = input->in;
+    size_t consumed, len;
+    uint8_t *data;
+    const auto result = SSL_open_app_data(
+        ssl, input->in.data(), input->in.size(), &consumed, &data, &len);
+    if (ERR_peek_error() != 0) {
+      fprintf(stderr, "SSL_open_app_data left an error queued.\n");
+      return -1;
+    }
+    switch (result) {
+      case ssl_open_app_data_success:
+        if (consumed == 0 || consumed > input->in.size() ||
+            (len != 0 && (data < input->in.data() ||
+                          len > consumed ||
+                          data > input->in.data() + consumed - len)) ||
+            !std::equal(before.begin() + consumed, before.end(),
+                        input->in.begin() + consumed)) {
+          fprintf(stderr, "SSL_open_app_data opened outside its record.\n");
+          return -1;
+        }
+        input->plain.assign(data, data + len);
+        input->in.erase(input->in.begin(), input->in.begin() + consumed);
+        break;
+
+      case ssl_open_app_data_partial: {
+        if (consumed <= input->in.size() || data != nullptr || len != 0 ||
+            input->in != before) {
+          fprintf(stderr, "SSL_open_app_data changed a partial record.\n");
+          return -1;
+        }
+        uint8_t buf[20000];
+        const size_t want = kReadLens[input->reads++ % std::size(kReadLens)];
+        const int ret = BIO_read(BIO_next(bio), buf, static_cast<int>(want));
+        if (ret > 0) {
+          input->in.insert(input->in.end(), buf, buf + ret);
+        } else if (config->async && BIO_should_read(BIO_next(bio))) {
+          AsyncBioAllowRead(test_state->async_bio, 1);
+        } else {
+          // `SSL_read` meets the end or the error itself.
+          return 0;
+        }
+        break;
+      }
+
+      case ssl_open_app_data_declined:
+        if (consumed > input->in.size() || data != nullptr || len != 0) {
+          fprintf(stderr, "SSL_open_app_data declined with bad output.\n");
+          return -1;
+        }
+        input->in.erase(input->in.begin(), input->in.begin() + consumed);
+        return 0;
+    }
+  }
+}
