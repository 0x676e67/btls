+  ASSERT_EQ(SSL_do_handshake(server.get()), 1);
+  ASSERT_TRUE(SSL_in_early_data(server.get()));
+  EXPECT_EQ(FromOpaque(server.get())->s3->read_record_size_limit, 128);
+
+  std::array<uint8_t, 100> sent = {};
+  std::array<uint8_t, 100> received = {};
+  for (size_t i = 0; i < sent.size(); i++) {
+    sent[i] = static_cast<uint8_t>(i);
+  }
+  ASSERT_EQ(SSL_write(client.get(), sent.data(), sent.size()),
+            static_cast<int>(sent.size()));
+  ASSERT_TRUE(ReadExact(server.get(), received));
+  EXPECT_EQ(received, sent);
+
+  const int client_finish = SSL_do_handshake(client.get());
+  ASSERT_TRUE(
+      IsRetryableHandshakeError(SSL_get_error(client.get(), client_finish)));
+  uint8_t unused;
+  const int server_finish = SSL_read(server.get(), &unused, sizeof(unused));
+  ASSERT_EQ(server_finish, -1);
+  ASSERT_EQ(SSL_get_error(server.get(), server_finish), SSL_ERROR_WANT_READ);
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+  EXPECT_TRUE(SSL_session_reused(client.get()));
+  EXPECT_TRUE(SSL_session_reused(server.get()));
+  EXPECT_EQ(FromOpaque(client.get())->s3->read_record_size_limit, 80);
+  EXPECT_EQ(FromOpaque(client.get())->s3->write_record_size_limit, 64);
+  EXPECT_EQ(FromOpaque(server.get())->s3->read_record_size_limit, 64);
+  EXPECT_EQ(FromOpaque(server.get())->s3->write_record_size_limit, 80);
+}
+
+TEST(RecordSizeLimitTest, Tls12CbcMaximumAllowsLegalExtraPadding) {
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(false, TLS1_2_VERSION);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(true, TLS1_2_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  ASSERT_TRUE(SSL_CTX_set_strict_cipher_list(client_ctx.get(), "AES128-SHA"));
+  ASSERT_TRUE(SSL_CTX_set_strict_cipher_list(server_ctx.get(), "AES128-SHA"));
+  SSL_CTX_set_record_size_limit(client_ctx.get(), SSL3_RT_MAX_PLAIN_LENGTH);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), SSL3_RT_MAX_PLAIN_LENGTH);
+
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  ASSERT_TRUE(CompleteHandshakes(client.get(), server.get()));
+
+  SSLImpl *client_impl = FromOpaque(client.get());
+  size_t minimum_ciphertext_len = 0;
+  ASSERT_TRUE(client_impl->s3->aead_read_ctx->CiphertextLen(
+      &minimum_ciphertext_len, SSL3_RT_MAX_PLAIN_LENGTH, 0));
+  const size_t padded_ciphertext_len = minimum_ciphertext_len + 16;
+  ASSERT_LE(padded_ciphertext_len,
+            static_cast<size_t>(SSL3_RT_MAX_ENCRYPTED_LENGTH));
+  uint8_t alert = 0;
+  EXPECT_TRUE(ssl_record_size_limit_check_ciphertext(
+      client_impl, padded_ciphertext_len, &alert));
+
+  client_impl->s3->read_record_size_limit = SSL3_RT_MAX_PLAIN_LENGTH - 1;
+  EXPECT_FALSE(ssl_record_size_limit_check_ciphertext(
+      client_impl, padded_ciphertext_len, &alert));
+  EXPECT_EQ(alert, SSL_AD_RECORD_OVERFLOW);
+  ERR_clear_error();
+}
+
+TEST(RecordSizeLimitTest, SplitHandshakeFailsBeforeDroppingState) {
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(false, TLS1_3_VERSION);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(true, TLS1_3_VERSION);
+  ASSERT_TRUE(client_ctx);
+  ASSERT_TRUE(server_ctx);
+  SSL_CTX_set_record_size_limit(client_ctx.get(), 64);
+  SSL_CTX_set_record_size_limit(server_ctx.get(), 96);
+  SSL_CTX_set_handoff_mode(server_ctx.get(), true);
+
+  UniquePtr<SSL> client, server;
+  ASSERT_TRUE(CreatePair(&client, &server, client_ctx.get(), server_ctx.get()));
+  int ret = SSL_do_handshake(client.get());
+  ASSERT_EQ(SSL_get_error(client.get(), ret), SSL_ERROR_WANT_READ);
+  ret = SSL_do_handshake(server.get());
+  ASSERT_EQ(SSL_get_error(server.get(), ret), SSL_ERROR_HANDOFF);
+
+  ScopedCBB cbb;
+  SSL_CLIENT_HELLO client_hello;
+  ASSERT_TRUE(CBB_init(cbb.get(), 256));
+  EXPECT_FALSE(SSL_serialize_handoff(server.get(), cbb.get(), &client_hello));
+}
