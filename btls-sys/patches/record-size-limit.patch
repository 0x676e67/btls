+struct ClientHelloObservation {
+  bool called = false;
+  bool present = false;
+  uint16_t value = 0;
+  uint16_t mutate_server_limit_to = 0;
+};
+
+static ClientHelloObservation *g_client_hello_observation = nullptr;
+
+class ScopedClientHelloObservation {
+ public:
+  explicit ScopedClientHelloObservation(ClientHelloObservation *observation) {
+    EXPECT_EQ(g_client_hello_observation, nullptr);
+    g_client_hello_observation = observation;
+  }
+
+  ~ScopedClientHelloObservation() { g_client_hello_observation = nullptr; }
+};
+
+static ssl_select_cert_result_t ObserveClientHello(
+    const SSL_CLIENT_HELLO *client_hello) {
+  ClientHelloObservation *observation = g_client_hello_observation;
+  if (observation == nullptr) {
+    return ssl_select_cert_error;
+  }
+  observation->called = true;
+  const uint8_t *data = nullptr;
+  size_t len = 0;
+  observation->present = SSL_early_callback_ctx_extension_get(
+      client_hello, TLSEXT_TYPE_record_size_limit, &data, &len);
+  if (observation->present && len == 2) {
+    observation->value = (static_cast<uint16_t>(data[0]) << 8) | data[1];
+  }
+  if (observation->mutate_server_limit_to != 0) {
+    SSL_set_record_size_limit(client_hello->ssl,
+                              observation->mutate_server_limit_to);
+  }
+  return ssl_select_cert_success;
+}
