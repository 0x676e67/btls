+      "moZWgjHvB2W9Ckn7sDqsPB+U2tyX0joDdQEyuiMECDY8oQ==\n"
+      "-----END RSA PRIVATE KEY-----\n";
+
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  if (!ctx || !SSL_CTX_set_min_proto_version(ctx.get(), version) ||
+      !SSL_CTX_set_max_proto_version(ctx.get(), version)) {
+    return nullptr;
+  }
+  if (!server) {
+    return ctx;
+  }
+
+  UniquePtr<X509> cert = CertFromPEM(kCertPEM);
+  UniquePtr<EVP_PKEY> key = KeyFromPEM(kKeyPEM);
+  if (!cert || !key || !SSL_CTX_use_certificate(ctx.get(), cert.get()) ||
+      !SSL_CTX_use_PrivateKey(ctx.get(), key.get())) {
+    return nullptr;
+  }
+  return ctx;
+}
+
+static bool CreatePair(UniquePtr<SSL> *out_client, UniquePtr<SSL> *out_server,
+                       SSL_CTX *client_ctx, SSL_CTX *server_ctx) {
+  UniquePtr<SSL> client(SSL_new(client_ctx));
+  UniquePtr<SSL> server(SSL_new(server_ctx));
+  if (!client || !server) {
+    return false;
+  }
+  SSL_set_connect_state(client.get());
+  SSL_set_accept_state(server.get());
+
+  BIO *client_bio = nullptr;
+  BIO *server_bio = nullptr;
+  if (!BIO_new_bio_pair(&client_bio, 0, &server_bio, 0)) {
+    return false;
+  }
+  SSL_set_bio(client.get(), client_bio, client_bio);
+  SSL_set_bio(server.get(), server_bio, server_bio);
+  *out_client = std::move(client);
+  *out_server = std::move(server);
+  return true;
+}
+
+static bool ConfigureECH(SSL *client, SSL_CTX *server_ctx) {
+  ScopedEVP_HPKE_KEY key;
+  uint8_t *ech_config = nullptr;
+  size_t ech_config_len = 0;
+  if (!EVP_HPKE_KEY_generate(key.get(), EVP_hpke_x25519_hkdf_sha256()) ||
+      !SSL_marshal_ech_config(&ech_config, &ech_config_len,
+                              /*config_id=*/1, key.get(), "public.example",
+                              /*max_name_len=*/16)) {
+    return false;
+  }
+  UniquePtr<uint8_t> ech_config_storage(ech_config);
+
+  UniquePtr<SSL_ECH_KEYS> keys(SSL_ECH_KEYS_new());
+  if (!keys ||
+      !SSL_ECH_KEYS_add(keys.get(), /*is_retry_config=*/1, ech_config,
+                        ech_config_len, key.get()) ||
+      !SSL_CTX_set1_ech_keys(server_ctx, keys.get())) {
+    return false;
+  }
+
+  uint8_t *ech_config_list = nullptr;
+  size_t ech_config_list_len = 0;
+  if (!SSL_ECH_KEYS_marshal_retry_configs(keys.get(), &ech_config_list,
+                                          &ech_config_list_len)) {
+    return false;
+  }
+  UniquePtr<uint8_t> ech_config_list_storage(ech_config_list);
+  return SSL_set_tlsext_host_name(client, "secret.example") &&
+         SSL_set1_ech_config_list(client, ech_config_list, ech_config_list_len);
+}
