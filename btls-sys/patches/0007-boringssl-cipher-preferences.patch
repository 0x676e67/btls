                                 true /* strict */);
 }
@@ -2331,6 +2363,45 @@ void SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit) {
   FromOpaque(ctx)->record_size_limit = limit;
 }
 
+void SSL_CTX_set_preserve_tls13_cipher_list(SSL_CTX *ctx,
+                                            int preserve_tls13_cipher_list) {
+  if (!ctx) {
+    return;
+  }
+
+  FromOpaque(ctx)->preserve_tls13_cipher_list = !!preserve_tls13_cipher_list;
+}
+
+void SSL_set_preserve_tls13_cipher_list(SSL *ssl,
+                                        int preserve_tls13_cipher_list) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return;
+  }
+
+  ssl_impl->config->preserve_tls13_cipher_list = !!preserve_tls13_cipher_list;
+}
+
+void SSL_CTX_set_aes_hw_override(SSL_CTX *ctx, int override_value) {
+  if (!ctx) {
+    return;
+  }
+
+  auto *ctx_impl = FromOpaque(ctx);
+  ctx_impl->aes_hw_override = true;
+  ctx_impl->aes_hw_override_value = !!override_value;
+}
+
+void SSL_set_aes_hw_override(SSL *ssl, int override_value) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return;
+  }
+
+  ssl_impl->config->aes_hw_override = true;
+  ssl_impl->config->aes_hw_override_value = !!override_value;
+}
