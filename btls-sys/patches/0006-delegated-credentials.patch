+// SSL_CTX_set_delegated_credentials configures the exact signature algorithm
+// list advertised for a server delegated credential's public key and
+// CertificateVerify signature. Advertised values remain subject to TLS version
+// and key compatibility checks. This setting is independent of
+// |SSL_CTX_set_verify_algorithm_prefs|, which controls the signature over the
+// delegated credential itself. Delegated credentials are disabled by default
+// and only apply to TLS 1.3 and later.
+OPENSSL_EXPORT int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx,
+                                                     const char *str);
+
