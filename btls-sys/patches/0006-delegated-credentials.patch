---
 include/openssl/ssl.h |  6 ++++++
 ssl/extensions.cc     | 24 ++++++++++++++++++++++++
 ssl/internal.h        |  8 ++++++++
 ssl/ssl_lib.cc        |  2 ++
 ssl/ssl_privkey.cc    | 15 +++++++++++++++
 5 files changed, 55 insertions(+)

diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 82f582547..8eb4d2945 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -1254,6 +1254,12 @@ OPENSSL_EXPORT int SSL_set_signing_algorithm_prefs(SSL *ssl,
                                                    size_t num_prefs);
 
 
+// SSL_CTX_set_delegated_credentials sets the set of signature algorithms
+// supported by the client.
+OPENSSL_EXPORT int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx,
+                                                     const char *str);
+
+
 // Certificate and private key convenience functions.
 
 // SSL_CTX_set_chain_and_key sets the certificate chain and private key for a
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index cf6a3c35c..35483c129 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -3320,6 +3320,30 @@ static bool ext_quic_transport_params_add_serverhello_legacy(SSL_HANDSHAKE *hs,
 static bool ext_delegated_credential_add_clienthello(
     const SSL_HANDSHAKE *hs, CBB *out, CBB *out_compressible,
     ssl_client_hello_type_t type) {
+  if (hs->config->delegated_credentials.empty()) {
+    return true;
+  }
+
+  CBB contents, data;
+  const Array<uint16_t> &signature_hash_algorithms =
+      hs->config->delegated_credentials;
+
+  if (!CBB_add_u16(out, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out, &contents) ||
+      !CBB_add_u16_length_prefixed(&contents, &data)) {
+    return false;
+  }
+
+  for (const uint16_t alg : signature_hash_algorithms) {
+    if (!CBB_add_u16(&data, alg)) {
+      return false;
+    }
+  }
+
+  if (!CBB_flush(out)) {
+    return false;
+  }
+
   return true;
 }
 
diff --git a/ssl/internal.h b/ssl/internal.h
index a76cd41a8..036af1422 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3619,6 +3619,10 @@ struct SSL_CONFIG {
   // record_size_limit is the protected-record plaintext limit to advertise.
   uint16_t record_size_limit = 0;
 
+  // delegated_credentials, if not empty, is the set of signature algorithms
+  // supported by the client.
+  Array<uint16_t> delegated_credentials;
+
   // server_padding_enabled is true iff the server is willing to send additional
   // padding to clients that request it through the server padding extension.
   bool server_padding_enabled : 1;
@@ -4305,6 +4309,10 @@ class SSLContext : public ssl_ctx_st, public RefCounted<SSLContext> {
   // record_size_limit is the protected-record plaintext limit to advertise.
   uint16_t record_size_limit = 0;
 
+  // delegated_credentials, if not empty, is the set of signature algorithms
+  // supported by the client.
+  bssl::Array<uint16_t> delegated_credentials;
+
   // extension_order stores wire extension IDs in the order requested by
   // SSL_CTX_set_extension_order. An empty array leaves the order unset.
   bssl::Array<uint16_t> extension_order;
diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index fdc49eff6..faba44366 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -540,6 +540,8 @@ SSL *SSL_new(SSL_CTX *ctx) {
       !ssl->config->alpn_client_proto_list.CopyFrom(
           ctx_impl->alpn_client_proto_list) ||
       !ssl->config->verify_sigalgs.CopyFrom(ctx_impl->verify_sigalgs) ||
+      !ssl->config->delegated_credentials.CopyFrom(
+          ctx_impl->delegated_credentials) ||
       !ssl->config->accepted_peer_cert_types.TryCopyFrom(
           ctx_impl->accepted_peer_cert_types) ||
       !ssl->config->available_client_cert_types.TryCopyFrom(
diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
index ae7c9bbd5..2e04fa4a5 100644
--- a/ssl/ssl_privkey.cc
+++ b/ssl/ssl_privkey.cc
@@ -971,3 +971,18 @@ int SSL_set_verify_algorithm_prefs(SSL *ssl, const uint16_t *prefs,
   return set_sigalg_prefs(&ssl_impl->config->verify_sigalgs,
                           Span(prefs, num_prefs));
 }
+
+int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx, const char *str) {
+  if (!ctx) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+
+  Array<uint16_t> sigalgs;
+  if (!parse_sigalgs_list(&sigalgs, str)) {
+    return 0;
+  }
+
+  return set_sigalg_prefs(&FromOpaque(ctx)->delegated_credentials,
+                          MakeConstSpan(sigalgs.data(), sigalgs.size()));
+}
