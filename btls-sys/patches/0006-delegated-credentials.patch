+
+namespace {
+
+constexpr int64_t kCurrentTime = 2000000000;
+
+struct CredentialOptions {
+  bool delegation_usage = true;
+  bool delegation_usage_critical = false;
+  bool digital_signature_key_usage = true;
+  bool corrupt_signature = false;
+  bool legacy_signature_order = false;
+  bool rsa_delegated_key = false;
+  uint16_t cert_verify_algorithm = SSL_SIGN_ECDSA_SECP256R1_SHA256;
+  int64_t expires_from_now = 60 * 60;
+  int64_t certificate_expires_from_now = 30 * 24 * 60 * 60;
+};
+
+struct TestCredential {
+  UniquePtr<EVP_PKEY> certificate_key;
+  UniquePtr<EVP_PKEY> delegated_key;
+  UniquePtr<X509> certificate;
+  UniquePtr<CRYPTO_BUFFER> certificate_der;
+  UniquePtr<CRYPTO_BUFFER> delegated_credential;
+};
+
+static UniquePtr<EVP_PKEY> GenerateRsaKey() {
+  UniquePtr<RSA> rsa(RSA_new());
+  UniquePtr<BIGNUM> exponent(BN_new());
+  UniquePtr<EVP_PKEY> key(EVP_PKEY_new());
+  if (!rsa || !exponent || !key || !BN_set_word(exponent.get(), RSA_F4) ||
+      !RSA_generate_key_ex(rsa.get(), 2048, exponent.get(), nullptr) ||
+      !EVP_PKEY_assign_RSA(key.get(), rsa.release())) {
+    return nullptr;
+  }
+  return key;
+}
+
+static UniquePtr<EVP_PKEY> GenerateP256Key() {
+  UniquePtr<EC_KEY> ec(EC_KEY_new_by_curve_name(NID_X9_62_prime256v1));
+  UniquePtr<EVP_PKEY> key(EVP_PKEY_new());
+  if (!ec || !key || !EC_KEY_generate_key(ec.get()) ||
+      !EVP_PKEY_assign_EC_KEY(key.get(), ec.release())) {
+    return nullptr;
+  }
+  return key;
+}
+
+static bool AddDelegationUsage(X509 *certificate, bool critical) {
+  static const uint8_t kDelegationUsageOid[] = {
+      0x2b, 0x06, 0x01, 0x04, 0x01, 0x82, 0xda, 0x4b, 0x2c,
+  };
+  static const uint8_t kNull[] = {0x05, 0x00};
+  UniquePtr<ASN1_OBJECT> oid(ASN1_OBJECT_create(NID_undef, kDelegationUsageOid,
+                                                sizeof(kDelegationUsageOid),
+                                                nullptr, nullptr));
+  UniquePtr<ASN1_OCTET_STRING> value(ASN1_OCTET_STRING_new());
+  if (!oid || !value ||
+      !ASN1_OCTET_STRING_set(value.get(), kNull, sizeof(kNull))) {
+    return false;
+  }
+  UniquePtr<X509_EXTENSION> extension(
+      X509_EXTENSION_create_by_OBJ(nullptr, oid.get(), critical, value.get()));
+  return extension != nullptr &&
+         X509_add_ext(certificate, extension.get(), -1) != 0;
+}
+
+static bool AddDigitalSignatureKeyUsage(X509 *certificate) {
+  UniquePtr<ASN1_BIT_STRING> usage(ASN1_BIT_STRING_new());
+  if (!usage || !ASN1_BIT_STRING_set_bit(usage.get(), 0, 1)) {
+    return false;
+  }
+  UniquePtr<X509_EXTENSION> extension(
+      X509V3_EXT_i2d(NID_key_usage, /*critical=*/1, usage.get()));
+  return extension != nullptr &&
+         X509_add_ext(certificate, extension.get(), -1) != 0;
+}
+
+static bool MarshalCertificate(X509 *certificate, Array<uint8_t> *out) {
+  const int len = i2d_X509(certificate, nullptr);
+  if (len <= 0 || !out->InitForOverwrite(static_cast<size_t>(len))) {
+    return false;
+  }
+  uint8_t *ptr = out->data();
+  return i2d_X509(certificate, &ptr) == len && ptr == out->end();
+}
+
+static bool Sign(Span<const uint8_t> input, EVP_PKEY *key,
+                 std::vector<uint8_t> *out) {
+  ScopedEVP_MD_CTX ctx;
+  EVP_PKEY_CTX *pkey_ctx = nullptr;
+  if (!EVP_DigestSignInit(ctx.get(), &pkey_ctx, EVP_sha256(), nullptr, key) ||
+      !EVP_PKEY_CTX_set_rsa_padding(pkey_ctx, RSA_PKCS1_PSS_PADDING) ||
+      !EVP_PKEY_CTX_set_rsa_pss_saltlen(pkey_ctx, RSA_PSS_SALTLEN_DIGEST)) {
+    return false;
+  }
+  out->resize(EVP_PKEY_size(key));
+  size_t len = out->size();
+  if (!EVP_DigestSign(ctx.get(), out->data(), &len, input.data(),
+                      input.size())) {
+    return false;
+  }
+  out->resize(len);
+  return true;
+}
+
+static bool BuildSignatureInput(Array<uint8_t> *out,
+                                Span<const uint8_t> certificate,
+                                Span<const uint8_t> credential,
+                                uint16_t algorithm, bool legacy_order) {
+  static constexpr char kContext[] = "TLS, server delegated credentials";
+  uint8_t spaces[64];
+  OPENSSL_memset(spaces, 0x20, sizeof(spaces));
+  ScopedCBB cbb;
+  if (!CBB_init(cbb.get(), 256 + certificate.size() + credential.size()) ||
+      !CBB_add_bytes(cbb.get(), spaces, sizeof(spaces)) ||
+      !CBB_add_bytes(cbb.get(), reinterpret_cast<const uint8_t *>(kContext),
+                     sizeof(kContext)) ||
+      !CBB_add_bytes(cbb.get(), certificate.data(), certificate.size())) {
+    return false;
+  }
+  if (legacy_order) {
+    if (!CBB_add_u16(cbb.get(), algorithm) ||
+        !CBB_add_bytes(cbb.get(), credential.data(), credential.size())) {
+      return false;
+    }
+  } else if (!CBB_add_bytes(cbb.get(), credential.data(), credential.size()) ||
+             !CBB_add_u16(cbb.get(), algorithm)) {
+    return false;
+  }
+  return CBBFinishArray(cbb.get(), out);
+}
+
+static bool MakeTestCredential(const CredentialOptions &options,
+                               TestCredential *out) {
+  out->certificate_key = GenerateRsaKey();
+  out->delegated_key =
+      options.rsa_delegated_key ? GenerateRsaKey() : GenerateP256Key();
+  out->certificate.reset(X509_new());
+  if (!out->certificate_key || !out->delegated_key || !out->certificate ||
+      !X509_set_version(out->certificate.get(), X509_VERSION_3) ||
+      !ASN1_INTEGER_set(X509_get_serialNumber(out->certificate.get()), 1) ||
+      !ASN1_TIME_set_posix(X509_getm_notBefore(out->certificate.get()),
+                           kCurrentTime - 3600) ||
+      !ASN1_TIME_set_posix(
+          X509_getm_notAfter(out->certificate.get()),
+          kCurrentTime + options.certificate_expires_from_now) ||
+      !X509_set_pubkey(out->certificate.get(), out->certificate_key.get())) {
+    return false;
+  }
+
+  X509_NAME *name = X509_get_subject_name(out->certificate.get());
+  static const uint8_t kCommonName[] = "delegated-credential.test";
+  if (name == nullptr ||
+      !X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC, kCommonName, -1, -1,
+                                  0) ||
+      !X509_set_issuer_name(out->certificate.get(), name) ||
+      (options.delegation_usage &&
+       !AddDelegationUsage(out->certificate.get(),
+                           options.delegation_usage_critical)) ||
+      (options.digital_signature_key_usage &&
+       !AddDigitalSignatureKeyUsage(out->certificate.get())) ||
+      !X509_sign(out->certificate.get(), out->certificate_key.get(),
+                 EVP_sha256())) {
+    return false;
+  }
+
+  Array<uint8_t> certificate_der;
+  if (!MarshalCertificate(out->certificate.get(), &certificate_der)) {
+    return false;
+  }
+  out->certificate_der.reset(CRYPTO_BUFFER_new(
+      certificate_der.data(), certificate_der.size(), nullptr));
+  if (!out->certificate_der) {
+    return false;
+  }
+
+  int64_t not_before;
+  if (!ASN1_TIME_to_posix(X509_get0_notBefore(out->certificate.get()),
+                          &not_before) ||
+      options.expires_from_now >
+          std::numeric_limits<int64_t>::max() - kCurrentTime ||
+      kCurrentTime + options.expires_from_now < not_before ||
+      kCurrentTime + options.expires_from_now - not_before > UINT32_MAX) {
+    return false;
+  }
+  const uint32_t valid_time = static_cast<uint32_t>(
+      kCurrentTime + options.expires_from_now - not_before);
+
+  ScopedCBB spki_cbb;
+  Array<uint8_t> spki;
+  if (!CBB_init(spki_cbb.get(), 128) ||
+      !EVP_marshal_public_key(spki_cbb.get(), out->delegated_key.get()) ||
+      !CBBFinishArray(spki_cbb.get(), &spki)) {
+    return false;
+  }
+
+  ScopedCBB credential_cbb;
+  CBB spki_child;
+  Array<uint8_t> credential;
+  if (!CBB_init(credential_cbb.get(), 128) ||
+      !CBB_add_u32(credential_cbb.get(), valid_time) ||
+      !CBB_add_u16(credential_cbb.get(), options.cert_verify_algorithm) ||
+      !CBB_add_u24_length_prefixed(credential_cbb.get(), &spki_child) ||
+      !CBB_add_bytes(&spki_child, spki.data(), spki.size()) ||
+      !CBBFinishArray(credential_cbb.get(), &credential)) {
+    return false;
+  }
+
+  Array<uint8_t> signature_input;
+  if (!BuildSignatureInput(&signature_input, certificate_der, credential,
+                           SSL_SIGN_RSA_PSS_RSAE_SHA256,
+                           options.legacy_signature_order)) {
+    return false;
+  }
+  std::vector<uint8_t> signature;
+  if (!Sign(signature_input, out->certificate_key.get(), &signature)) {
+    return false;
+  }
+  if (options.corrupt_signature) {
+    signature.back() ^= 1;
+  }
+
+  ScopedCBB dc_cbb;
+  CBB signature_child;
+  Array<uint8_t> delegated_credential;
+  if (!CBB_init(dc_cbb.get(), credential.size() + signature.size() + 4) ||
+      !CBB_add_bytes(dc_cbb.get(), credential.data(), credential.size()) ||
+      !CBB_add_u16(dc_cbb.get(), SSL_SIGN_RSA_PSS_RSAE_SHA256) ||
+      !CBB_add_u16_length_prefixed(dc_cbb.get(), &signature_child) ||
+      !CBB_add_bytes(&signature_child, signature.data(), signature.size()) ||
+      !CBBFinishArray(dc_cbb.get(), &delegated_credential)) {
+    return false;
+  }
+  out->delegated_credential.reset(CRYPTO_BUFFER_new(
+      delegated_credential.data(), delegated_credential.size(), nullptr));
+  return out->delegated_credential != nullptr;
+}
+
+static void CurrentTimeCallback(const SSL *, timeval *out_clock) {
+  out_clock->tv_sec = kCurrentTime;
+  out_clock->tv_usec = 0;
+}
+
+static ssl_verify_result_t AcceptAnyCertificate(SSL *, uint8_t *) {
+  return ssl_verify_ok;
+}
+
+static UniquePtr<SSL_CTX> CreateContext(
+    bool server, bool use_buffer_method = false,
+    const char *delegated_algorithms = "ecdsa_secp256r1_sha256",
+    uint16_t verify_algorithm = SSL_SIGN_RSA_PSS_RSAE_SHA256,
+    bool is_dtls = false) {
+  const SSL_METHOD *method = use_buffer_method
+                                 ? TLS_with_buffers_method()
+                                 : (is_dtls ? DTLS_method() : TLS_method());
+  const uint16_t version = is_dtls ? DTLS1_3_VERSION : TLS1_3_VERSION;
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(method));
+  if (!ctx || !SSL_CTX_set_min_proto_version(ctx.get(), version) ||
+      !SSL_CTX_set_max_proto_version(ctx.get(), version)) {
+    return nullptr;
+  }
+  SSL_CTX_set_current_time_cb(ctx.get(), CurrentTimeCallback);
+  if (!server) {
+    if (use_buffer_method) {
+      SSL_CTX_set_custom_verify(ctx.get(), SSL_VERIFY_PEER,
+                                AcceptAnyCertificate);
+    } else {
+      SSL_CTX_set_verify(ctx.get(), SSL_VERIFY_NONE, nullptr);
+    }
+    const uint16_t algorithms[] = {verify_algorithm};
+    if (!SSL_CTX_set_verify_algorithm_prefs(ctx.get(), algorithms,
+                                            std::size(algorithms)) ||
+        (delegated_algorithms != nullptr &&
+         !SSL_CTX_set_delegated_credentials(ctx.get(), delegated_algorithms))) {
+      return nullptr;
+    }
+  }
+  return ctx;
+}
+
+static bool ConfigureServerCredential(SSL_CTX *ctx,
+                                      const TestCredential &test_credential) {
+  UniquePtr<SSL_CREDENTIAL> credential(SSL_CREDENTIAL_new_delegated());
+  CRYPTO_BUFFER *chain[] = {test_credential.certificate_der.get()};
+  return credential != nullptr &&
+         SSL_CREDENTIAL_set1_private_key(credential.get(),
+                                         test_credential.delegated_key.get()) &&
+         SSL_CREDENTIAL_set1_cert_chain(credential.get(), chain,
+                                        std::size(chain)) &&
+         SSL_CREDENTIAL_set1_delegated_credential(
+             credential.get(), test_credential.delegated_credential.get()) &&
+         SSL_CTX_add1_credential(ctx, credential.get());
+}
+
+static bool ConfigureNormalServerCredential(
+    SSL_CTX *ctx, const TestCredential &test_credential) {
+  UniquePtr<SSL_CREDENTIAL> credential(SSL_CREDENTIAL_new_x509());
+  CRYPTO_BUFFER *chain[] = {test_credential.certificate_der.get()};
+  return credential != nullptr &&
+         SSL_CREDENTIAL_set1_private_key(
+             credential.get(), test_credential.certificate_key.get()) &&
+         SSL_CREDENTIAL_set1_cert_chain(credential.get(), chain,
+                                        std::size(chain)) &&
+         SSL_CTX_add1_credential(ctx, credential.get());
+}
+
+static bool CreatePair(UniquePtr<SSL> *out_client, UniquePtr<SSL> *out_server,
+                       SSL_CTX *client_ctx, SSL_CTX *server_ctx) {
+  UniquePtr<SSL> client(SSL_new(client_ctx));
+  UniquePtr<SSL> server(SSL_new(server_ctx));
+  if (!client || !server) {
+    return false;
+  }
+  SSL_set_connect_state(client.get());
+  SSL_set_accept_state(server.get());
+  BIO *client_bio = nullptr;
+  BIO *server_bio = nullptr;
+  if (!BIO_new_bio_pair(&client_bio, 0, &server_bio, 0)) {
+    return false;
+  }
+  SSL_set_bio(client.get(), client_bio, client_bio);
+  SSL_set_bio(server.get(), server_bio, server_bio);
+  *out_client = std::move(client);
+  *out_server = std::move(server);
+  return true;
+}
+
+static bool Retryable(SSL *ssl, int ret) {
+  const int error = SSL_get_error(ssl, ret);
+  return error == SSL_ERROR_WANT_READ || error == SSL_ERROR_WANT_WRITE;
+}
+
+static bool CompleteHandshakes(SSL *client, SSL *server) {
+  bool client_done = false;
+  bool server_done = false;
+  for (size_t i = 0; i < 100 && (!client_done || !server_done); i++) {
+    if (!client_done) {
+      const int ret = SSL_do_handshake(client);
+      client_done = ret == 1;
+      if (!client_done && !Retryable(client, ret)) {
+        return false;
+      }
+    }
+    if (!server_done) {
+      const int ret = SSL_do_handshake(server);
+      server_done = ret == 1;
+      if (!server_done && !Retryable(server, ret)) {
+        return false;
+      }
+    }
+  }
+  return client_done && server_done;
+}
+
+static bool ErrorQueueContains(int reason) {
+  bool found = false;
+  while (const uint32_t error = ERR_get_error()) {
+    found |= ERR_GET_REASON(error) == reason;
+  }
+  return found;
+}
+
+static bool ParseCredential(const TestCredential &test_credential,
+                            const char *delegated_algorithms,
+                            uint8_t *out_alert) {
+  UniquePtr<SSL_CTX> ctx =
+      CreateContext(false, /*use_buffer_method=*/false, delegated_algorithms);
+  UniquePtr<SSL> ssl(ctx != nullptr ? SSL_new(ctx.get()) : nullptr);
+  if (!ssl) {
+    return false;
+  }
+  SSL_set_connect_state(ssl.get());
+  SSLImpl *ssl_impl = FromOpaque(ssl.get());
+  ssl_impl->s3->version = TLS1_3_VERSION;
+  SSL_HANDSHAKE hs(ssl_impl);
+  hs.config = ssl_impl->config.get();
+  hs.extensions.sent = UINT32_MAX;
+
+  CBS contents;
+  CRYPTO_BUFFER_init_CBS(test_credential.delegated_credential.get(), &contents);
+  return ssl_delegated_credential_parse(&hs, out_alert, &contents);
+}
+
+static bool VerifyCredential(const TestCredential &test_credential,
+                             uint16_t verify_algorithm, uint8_t *out_alert) {
+  UniquePtr<SSL_CTX> ctx = CreateContext(
+      false, /*use_buffer_method=*/false,
+      /*delegated_algorithms=*/"ecdsa_secp256r1_sha256", verify_algorithm);
+  UniquePtr<SSL> ssl(ctx != nullptr ? SSL_new(ctx.get()) : nullptr);
+  if (!ssl) {
+    return false;
+  }
+  SSL_set_connect_state(ssl.get());
+  SSLImpl *ssl_impl = FromOpaque(ssl.get());
+  ssl_impl->s3->version = TLS1_3_VERSION;
+  SSL_HANDSHAKE hs(ssl_impl);
+  hs.config = ssl_impl->config.get();
+  hs.extensions.sent = UINT32_MAX;
+  hs.new_session = ssl_session_new(ssl_impl->ctx->x509_method);
+  if (hs.new_session == nullptr) {
+    return false;
+  }
+  hs.new_session->time = kCurrentTime;
+  hs.new_session->certs.reset(sk_CRYPTO_BUFFER_new_null());
+  if (hs.new_session->certs == nullptr ||
+      !PushToStack(hs.new_session->certs.get(),
+                   UpRef(test_credential.certificate_der)) ||
+      !(hs.peer_pubkey = UpRef(test_credential.certificate_key))) {
+    return false;
+  }
+
+  CBS contents;
+  CRYPTO_BUFFER_init_CBS(test_credential.delegated_credential.get(), &contents);
+  return ssl_delegated_credential_parse(&hs, out_alert, &contents) &&
+         ssl_delegated_credential_verify(&hs, out_alert,
+                                         SSL_SIGN_ECDSA_SECP256R1_SHA256);
+}
+
+static bool RunHandshake(const CredentialOptions &options,
+                         UniquePtr<SSL> *out_client = nullptr,
+                         bool use_buffer_method = false, bool is_dtls = false) {
+  TestCredential test_credential;
+  if (!MakeTestCredential(options, &test_credential)) {
+    return false;
+  }
+  UniquePtr<SSL_CTX> client_ctx =
+      CreateContext(false, use_buffer_method,
+                    /*delegated_algorithms=*/"ecdsa_secp256r1_sha256",
+                    SSL_SIGN_RSA_PSS_RSAE_SHA256, is_dtls);
+  UniquePtr<SSL_CTX> server_ctx =
+      CreateContext(true, /*use_buffer_method=*/false,
+                    /*delegated_algorithms=*/"ecdsa_secp256r1_sha256",
+                    SSL_SIGN_RSA_PSS_RSAE_SHA256, is_dtls);
+  if (!client_ctx || !server_ctx ||
+      !ConfigureServerCredential(server_ctx.get(), test_credential)) {
+    return false;
+  }
+  UniquePtr<SSL> client, server;
+  if (!CreatePair(&client, &server, client_ctx.get(), server_ctx.get()) ||
+      !CompleteHandshakes(client.get(), server.get())) {
+    return false;
+  }
+  if (out_client != nullptr) {
+    *out_client = std::move(client);
+  }
+  return true;
+}
+
+static bool RunDefaultCertificateHandshake(bool is_dtls) {
+  TestCredential test_credential;
+  if (!MakeTestCredential(CredentialOptions{}, &test_credential)) {
+    return false;
+  }
+  UniquePtr<SSL_CTX> client_ctx = CreateContext(
+      false, /*use_buffer_method=*/false,
+      /*delegated_algorithms=*/nullptr, SSL_SIGN_RSA_PSS_RSAE_SHA256, is_dtls);
+  UniquePtr<SSL_CTX> server_ctx = CreateContext(
+      true, /*use_buffer_method=*/false,
+      /*delegated_algorithms=*/nullptr, SSL_SIGN_RSA_PSS_RSAE_SHA256, is_dtls);
+  if (!client_ctx || !server_ctx ||
+      !ConfigureNormalServerCredential(server_ctx.get(), test_credential)) {
+    return false;
+  }
+  UniquePtr<SSL> client, server;
+  return CreatePair(&client, &server, client_ctx.get(), server_ctx.get()) &&
+         CompleteHandshakes(client.get(), server.get()) &&
+         !SSL_used_delegated_credential(client.get());
+}
