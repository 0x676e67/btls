+TEST(DelegatedCredentialTest, DisabledByDefault) {
+  UniquePtr<SSL_CTX> ctx = CreateContext(false, /*use_buffer_method=*/false,
+                                         /*delegated_algorithms=*/nullptr);
+  ASSERT_TRUE(ctx);
+  UniquePtr<SSL> ssl(SSL_new(ctx.get()));
+  ASSERT_TRUE(ssl);
+  SSL_set_connect_state(ssl.get());
+  EXPECT_FALSE(SSL_used_delegated_credential(ssl.get()));
+
+  SSLImpl *ssl_impl = FromOpaque(ssl.get());
+  SSL_HANDSHAKE hs(ssl_impl);
+  hs.config = ssl_impl->config.get();
+  hs.max_version = TLS1_3_VERSION;
+  ScopedCBB extensions, compressed;
+  ASSERT_TRUE(CBB_init(extensions.get(), 64));
+  ASSERT_TRUE(CBB_init(compressed.get(), 64));
+  EXPECT_TRUE(ssl_delegated_credential_add_clienthello(
+      &hs, extensions.get(), compressed.get(), ssl_client_hello_unencrypted));
+  EXPECT_EQ(CBB_len(extensions.get()), 0u);
+  EXPECT_EQ(CBB_len(compressed.get()), 0u);
