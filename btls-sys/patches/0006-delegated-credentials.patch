+// SSL_used_delegated_credential returns one if the peer authenticated with a
+// delegated credential in the most recent handshake and zero otherwise. It is
+// only set after both the delegated credential and CertificateVerify signature
+// have been validated.
+OPENSSL_EXPORT int SSL_used_delegated_credential(const SSL *ssl);
