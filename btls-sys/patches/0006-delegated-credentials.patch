+namespace {
+
+constexpr uint64_t kMaxDelegatedCredentialLifetime = 7 * 24 * 60 * 60;
+constexpr char kServerDelegatedCredentialContext[] =
+    "TLS, server delegated credentials";
+
+bool delegated_credential_error(uint8_t *out_alert, uint8_t alert) {
+  OPENSSL_PUT_ERROR(SSL, SSL_R_INVALID_DELEGATED_CREDENTIAL);
+  *out_alert = alert;
+  return false;
+}
+
+struct DelegationCertificate {
+  int64_t not_before;
+  int64_t not_after;
+};
+
+bool parse_certificate_time(CBS *validity, int64_t *out) {
+  CBS value;
+  struct tm civil_time;
+  if (CBS_peek_asn1_tag(validity, CBS_ASN1_UTCTIME)) {
+    if (!CBS_get_asn1(validity, &value, CBS_ASN1_UTCTIME) ||
+        !CBS_parse_utc_time(&value, &civil_time,
+                            /*allow_timezone_offset=*/false)) {
+      return false;
+    }
+  } else if (CBS_peek_asn1_tag(validity, CBS_ASN1_GENERALIZEDTIME)) {
+    if (!CBS_get_asn1(validity, &value, CBS_ASN1_GENERALIZEDTIME) ||
+        !CBS_parse_generalized_time(&value, &civil_time,
+                                    /*allow_timezone_offset=*/false)) {
+      return false;
+    }
+  } else {
+    return false;
+  }
+  return OPENSSL_tm_to_posix(&civil_time, out);
+}
+
+bool parse_delegation_certificate(DelegationCertificate *out,
+                                  Span<const uint8_t> certificate) {
+  CBS input(certificate), top_level, tbs_certificate, validity;
+  CBS outer_extensions, extensions;
+  int has_extensions;
+  if (!CBS_get_asn1(&input, &top_level, CBS_ASN1_SEQUENCE) ||
+      CBS_len(&input) != 0 ||
+      !CBS_get_asn1(&top_level, &tbs_certificate, CBS_ASN1_SEQUENCE) ||
+      !CBS_get_optional_asn1(
+          &tbs_certificate, nullptr, nullptr,
+          CBS_ASN1_CONSTRUCTED | CBS_ASN1_CONTEXT_SPECIFIC | 0) ||
+      !CBS_get_asn1(&tbs_certificate, nullptr, CBS_ASN1_INTEGER) ||
+      !CBS_get_asn1(&tbs_certificate, nullptr, CBS_ASN1_SEQUENCE) ||
+      !CBS_get_asn1(&tbs_certificate, nullptr, CBS_ASN1_SEQUENCE) ||
+      !CBS_get_asn1(&tbs_certificate, &validity, CBS_ASN1_SEQUENCE) ||
+      !parse_certificate_time(&validity, &out->not_before) ||
+      !parse_certificate_time(&validity, &out->not_after) ||
+      CBS_len(&validity) != 0 ||
+      !CBS_get_asn1(&tbs_certificate, nullptr, CBS_ASN1_SEQUENCE) ||
+      !CBS_get_asn1(&tbs_certificate, nullptr, CBS_ASN1_SEQUENCE) ||
+      !CBS_get_optional_asn1(&tbs_certificate, nullptr, nullptr,
+                             CBS_ASN1_CONTEXT_SPECIFIC | 1) ||
+      !CBS_get_optional_asn1(&tbs_certificate, nullptr, nullptr,
+                             CBS_ASN1_CONTEXT_SPECIFIC | 2) ||
+      !CBS_get_optional_asn1(
+          &tbs_certificate, &outer_extensions, &has_extensions,
+          CBS_ASN1_CONSTRUCTED | CBS_ASN1_CONTEXT_SPECIFIC | 3) ||
+      CBS_len(&tbs_certificate) != 0 || !has_extensions ||
+      !CBS_get_asn1(&outer_extensions, &extensions, CBS_ASN1_SEQUENCE) ||
+      CBS_len(&outer_extensions) != 0) {
+    return false;
+  }
+
+  // RFC 9345, section 4.2 requires the DelegationUsage extension and an
+  // explicit digitalSignature KeyUsage. DelegationUsage is a non-critical
+  // NULL extension with OID 1.3.6.1.4.1.44363.44.
+  static const uint8_t kDelegationUsageOid[] = {
+      0x2b, 0x06, 0x01, 0x04, 0x01, 0x82, 0xda, 0x4b, 0x2c,
+  };
+  static const uint8_t kKeyUsageOid[] = {0x55, 0x1d, 0x0f};
+  static const uint8_t kNull[] = {0x05, 0x00};
+  bool has_delegation_usage = false;
+  bool has_key_usage = false;
+  while (CBS_len(&extensions) > 0) {
+    CBS extension, oid, contents;
+    int critical = false;
+    if (!CBS_get_asn1(&extensions, &extension, CBS_ASN1_SEQUENCE) ||
+        !CBS_get_asn1(&extension, &oid, CBS_ASN1_OBJECT) ||
+        (CBS_peek_asn1_tag(&extension, CBS_ASN1_BOOLEAN) &&
+         !CBS_get_asn1_bool(&extension, &critical)) ||
+        !CBS_get_asn1(&extension, &contents, CBS_ASN1_OCTETSTRING) ||
+        CBS_len(&extension) != 0) {
+      return false;
+    }
+
+    if (CBS_mem_equal(&oid, kDelegationUsageOid, sizeof(kDelegationUsageOid))) {
+      if (has_delegation_usage || critical ||
+          !CBS_mem_equal(&contents, kNull, sizeof(kNull))) {
+        return false;
+      }
+      has_delegation_usage = true;
+      continue;
+    }
+
+    if (CBS_mem_equal(&oid, kKeyUsageOid, sizeof(kKeyUsageOid))) {
+      CBS bit_string;
+      if (has_key_usage ||
+          !CBS_get_asn1(&contents, &bit_string, CBS_ASN1_BITSTRING) ||
+          CBS_len(&contents) != 0 ||
+          !CBS_is_valid_asn1_bitstring(&bit_string) ||
+          !CBS_asn1_bitstring_has_bit(&bit_string,
+                                      key_usage_digital_signature)) {
+        return false;
+      }
+      has_key_usage = true;
+    }
+  }
+  return has_delegation_usage && has_key_usage;
+}
+
+bool credential_time_is_valid(const SSL_HANDSHAKE *hs,
+                              const DelegationCertificate &certificate,
+                              uint32_t valid_time, uint32_t *out_auth_timeout) {
+  if (certificate.not_before >
+      std::numeric_limits<int64_t>::max() - valid_time) {
+    return false;
+  }
+
+  const int64_t expiry = certificate.not_before + valid_time;
+  const uint64_t now = ssl_ctx_get_current_time(hs->ssl->ctx.get()).tv_sec;
+  if (now > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
+      static_cast<int64_t>(now) > expiry || expiry >= certificate.not_after) {
+    return false;
+  }
+  const uint64_t remaining =
+      static_cast<uint64_t>(expiry - static_cast<int64_t>(now));
+  if (remaining > kMaxDelegatedCredentialLifetime ||
+      hs->new_session->time > static_cast<uint64_t>(expiry)) {
+    return false;
+  }
+
+  const uint64_t auth_timeout =
+      static_cast<uint64_t>(expiry) - hs->new_session->time;
+  if (auth_timeout > std::numeric_limits<uint32_t>::max()) {
+    return false;
+  }
+  *out_auth_timeout = static_cast<uint32_t>(auth_timeout);
+  return true;
+}
+
+bool build_signature_input(Array<uint8_t> *out, Span<const uint8_t> leaf,
+                           const SSLDelegatedCredential *credential) {
+  ScopedCBB cbb;
+  uint8_t spaces[64];
+  OPENSSL_memset(spaces, 0x20, sizeof(spaces));
+  if (!CBB_init(cbb.get(),
+                sizeof(spaces) + sizeof(kServerDelegatedCredentialContext) +
+                    leaf.size() + credential->credential.size() + 2) ||
+      !CBB_add_bytes(cbb.get(), spaces, sizeof(spaces)) ||
+      // sizeof includes the NUL separator required by RFC 9345, section 4.
+      !CBB_add_bytes(
+          cbb.get(),
+          reinterpret_cast<const uint8_t *>(kServerDelegatedCredentialContext),
+          sizeof(kServerDelegatedCredentialContext)) ||
+      !CBB_add_bytes(cbb.get(), leaf.data(), leaf.size()) ||
+      !CBB_add_bytes(cbb.get(), credential->credential.data(),
+                     credential->credential.size()) ||
+      !CBB_add_u16(cbb.get(), credential->algorithm) ||
+      !CBBFinishArray(cbb.get(), out)) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+bool ssl_delegated_credential_add_clienthello(const SSL_HANDSHAKE *hs, CBB *,
+                                              CBB *out_compressible,
+                                              ssl_client_hello_type_t) {
+  if (!ssl_accepts_server_certificate_auth(hs) ||
+      hs->config->delegated_credentials.empty() ||
+      hs->max_version < TLS1_3_VERSION) {
+    return true;
+  }
+
+  CBB contents, algorithms;
+  if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
+      !CBB_add_u16_length_prefixed(&contents, &algorithms)) {
+    return false;
+  }
+  for (uint16_t algorithm : hs->config->delegated_credentials) {
+    if (!CBB_add_u16(&algorithms, algorithm)) {
+      return false;
+    }
+  }
+  if (!CBB_flush(out_compressible)) {
+    return false;
+  }
+  return true;
+}
+
+bool ssl_delegated_credential_parse(SSL_HANDSHAKE *hs, uint8_t *out_alert,
+                                    CBS *contents) {
+  if (!ssl_client_hello_extension_was_sent(
+          hs, TLSEXT_TYPE_delegated_credential)) {
+    return delegated_credential_error(out_alert, SSL_AD_UNEXPECTED_MESSAGE);
+  }
+  if (ssl_protocol_version(hs->ssl) < TLS1_3_VERSION ||
+      hs->peer_delegated_credential != nullptr) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  CBS copy = *contents, spki, signature;
+  auto credential = MakeUnique<SSLDelegatedCredential>();
+  if (credential == nullptr) {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return false;
+  }
+  if (!CBS_get_u32(&copy, &credential->valid_time) ||
+      !CBS_get_u16(&copy, &credential->cert_verify_algorithm) ||
+      !CBS_get_u24_length_prefixed(&copy, &spki) || CBS_len(&spki) == 0) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  const size_t credential_len = CBS_len(contents) - CBS_len(&copy);
+  if (!CBS_get_u16(&copy, &credential->algorithm) ||
+      !CBS_get_u16_length_prefixed(&copy, &signature) ||
+      CBS_len(&signature) == 0 || CBS_len(&copy) != 0) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+  if (!credential->credential.CopyFrom(
+          Span(CBS_data(contents), credential_len)) ||
+      !credential->signature.CopyFrom(
+          Span(CBS_data(&signature), CBS_len(&signature)))) {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return false;
+  }
+
+  credential->pubkey = ssl_parse_peer_subject_public_key_info(spki);
+  if (credential->pubkey == nullptr ||
+      std::find(hs->config->delegated_credentials.begin(),
+                hs->config->delegated_credentials.end(),
+                credential->cert_verify_algorithm) ==
+          hs->config->delegated_credentials.end() ||
+      !ssl_pkey_supports_algorithm(hs->ssl, credential->pubkey.get(),
+                                   credential->cert_verify_algorithm,
+                                   /*is_verify=*/true)) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  // BoringSSL does not implement the rsa_pss_pss_* SignatureSchemes. The RSAE
+  // schemes it does implement are explicitly forbidden for delegated
+  // credential public keys by RFC 9345, section 4.
+  if (SSL_get_signature_algorithm_key_type(credential->cert_verify_algorithm) ==
+      EVP_PKEY_RSA) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  hs->peer_delegated_credential = std::move(credential);
+  return true;
+}
+
+bool ssl_delegated_credential_verify(SSL_HANDSHAKE *hs, uint8_t *out_alert,
+                                     uint16_t cert_verify_algorithm) {
+  SSLDelegatedCredential *credential = hs->peer_delegated_credential.get();
+  if (credential == nullptr || hs->peer_pubkey == nullptr ||
+      hs->new_session == nullptr || hs->new_session->certs == nullptr ||
+      sk_CRYPTO_BUFFER_num(hs->new_session->certs.get()) == 0 ||
+      cert_verify_algorithm != credential->cert_verify_algorithm) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  uint8_t sigalg_alert = SSL_AD_ILLEGAL_PARAMETER;
+  if (!tls12_check_peer_sigalg(hs, &sigalg_alert, credential->algorithm,
+                               hs->peer_pubkey.get())) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  CRYPTO_BUFFER *leaf_buffer =
+      sk_CRYPTO_BUFFER_value(hs->new_session->certs.get(), 0);
+  const Span<const uint8_t> leaf_der(CRYPTO_BUFFER_data(leaf_buffer),
+                                     CRYPTO_BUFFER_len(leaf_buffer));
+  DelegationCertificate certificate;
+  uint32_t auth_timeout;
+  if (!parse_delegation_certificate(&certificate, leaf_der) ||
+      !credential_time_is_valid(hs, certificate, credential->valid_time,
+                                &auth_timeout)) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  Array<uint8_t> signature_input;
+  if (!build_signature_input(&signature_input, leaf_der, credential)) {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return false;
+  }
+  if (!ssl_public_key_verify(hs->ssl, credential->signature,
+                             credential->algorithm, hs->peer_pubkey.get(),
+                             signature_input)) {
+    return delegated_credential_error(out_alert, SSL_AD_ILLEGAL_PARAMETER);
+  }
+
+  hs->new_session->auth_timeout =
+      std::min(hs->new_session->auth_timeout, auth_timeout);
+  hs->new_session->timeout = std::min(hs->new_session->timeout, auth_timeout);
+  hs->peer_pubkey = std::move(credential->pubkey);
+  return true;
+}
+
+BSSL_NAMESPACE_END
