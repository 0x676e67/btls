+TEST(SSLTest, NistMLKEMRejectsMalformedKeyShares) {
+  for (auto group : {SSL_GROUP_SECP256R1_MLKEM768,
+                     SSL_GROUP_SECP384R1_MLKEM1024}) {
+    auto client = SSLKeyShare::Create(group);
+    auto server = SSLKeyShare::Create(group);
+    ASSERT_TRUE(client);
+    ASSERT_TRUE(server);
+    ScopedCBB public_key, ciphertext;
+    ASSERT_TRUE(CBB_init(public_key.get(), 2048));
+    ASSERT_TRUE(CBB_init(ciphertext.get(), 2048));
+    ASSERT_TRUE(client->Generate(public_key.get()));
+    Span<const uint8_t> key(CBB_data(public_key.get()), CBB_len(public_key.get()));
+    Array<uint8_t> server_secret, client_secret;
+    uint8_t alert;
+    ASSERT_TRUE(server->Encap(ciphertext.get(), &server_secret, &alert, key));
+    Span<const uint8_t> ct(CBB_data(ciphertext.get()), CBB_len(ciphertext.get()));
+    ASSERT_TRUE(client->Decap(&client_secret, &alert, ct));
+    EXPECT_EQ(Bytes(server_secret), Bytes(client_secret));
+    for (int change : {-1, 1, 0}) {
+      std::vector<uint8_t> bad_key(key.begin(), key.end());
+      std::vector<uint8_t> bad_ct(ct.begin(), ct.end());
+      if (change == -1) {
+        bad_key.pop_back();
+        bad_ct.pop_back();
+      } else if (change == 1) {
+        bad_key.push_back(0);
+        bad_ct.push_back(0);
+      } else {
+        bad_key[0] = 0;
+        bad_ct[0] = 0;
+      }
+      auto peer = SSLKeyShare::Create(group);
+      ScopedCBB output;
+      ASSERT_TRUE(CBB_init(output.get(), 2048));
+      EXPECT_FALSE(peer->Encap(output.get(), &server_secret, &alert, bad_key));
+      EXPECT_EQ(alert, SSL_AD_ILLEGAL_PARAMETER);
+      ERR_clear_error();
+      EXPECT_FALSE(client->Decap(&client_secret, &alert, bad_ct));
+      EXPECT_EQ(alert, SSL_AD_ILLEGAL_PARAMETER);
+      ERR_clear_error();
+    }
+    std::vector<uint8_t> bad_kem(key.begin(), key.end());
+    size_t ec_size = group == SSL_GROUP_SECP256R1_MLKEM768 ? 65 : 97;
+    bad_kem[ec_size] = 0xff;
+    bad_kem[ec_size + 1] |= 0x0f;
+    auto peer = SSLKeyShare::Create(group);
+    ScopedCBB output;
+    ASSERT_TRUE(CBB_init(output.get(), 2048));
+    EXPECT_FALSE(peer->Encap(output.get(), &server_secret, &alert, bad_kem));
+    EXPECT_EQ(alert, SSL_AD_ILLEGAL_PARAMETER);
+    ERR_clear_error();
+  }
+}
