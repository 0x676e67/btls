+class SecP256r1MLKEM768KeyShare : public SSLKeyShare {
+ public:
+  SecP256r1MLKEM768KeyShare() : ec_(EC_group_p256(), SSL_GROUP_SECP256R1) {}
+
+  uint16_t GroupID() const override { return SSL_GROUP_SECP256R1_MLKEM768; }
+
+  bool Generate(CBB *out) override {
+    uint8_t public_key[MLKEM768_PUBLIC_KEY_BYTES];
+    MLKEM768_generate_key(public_key, nullptr, &private_key_);
+    return ec_.Generate(out) &&
+           CBB_add_bytes(out, public_key, sizeof(public_key));
+  }
+
+  bool Encap(CBB *out_ciphertext, Array<uint8_t> *out_secret,
+             uint8_t *out_alert, Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (peer_key.size() != 65 + MLKEM768_PUBLIC_KEY_BYTES) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    CBS input;
+    CBS_init(&input, peer_key.data() + 65, MLKEM768_PUBLIC_KEY_BYTES);
+    MLKEM768_public_key public_key;
+    if (!MLKEM768_parse_public_key(&public_key, &input)) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    Array<uint8_t> ec_secret;
+    if (!ec_.Encap(out_ciphertext, &ec_secret, out_alert,
+                    peer_key.first(65)) ||
+        !out_secret->InitForOverwrite(ec_secret.size() +
+                                      MLKEM_SHARED_SECRET_BYTES)) {
+      return false;
+    }
+    OPENSSL_memcpy(out_secret->data(), ec_secret.data(), ec_secret.size());
+    uint8_t ciphertext[MLKEM768_CIPHERTEXT_BYTES];
+    MLKEM768_encap(ciphertext, out_secret->data() + ec_secret.size(),
+                    &public_key);
+    return CBB_add_bytes(out_ciphertext, ciphertext, sizeof(ciphertext));
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> ciphertext) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (ciphertext.size() != 65 + MLKEM768_CIPHERTEXT_BYTES) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    Array<uint8_t> ec_secret;
+    if (!ec_.Decap(&ec_secret, out_alert, ciphertext.first(65)) ||
+        !out_secret->InitForOverwrite(ec_secret.size() +
+                                      MLKEM_SHARED_SECRET_BYTES)) {
+      return false;
+    }
+    OPENSSL_memcpy(out_secret->data(), ec_secret.data(), ec_secret.size());
+    if (!MLKEM768_decap(out_secret->data() + ec_secret.size(),
+                        ciphertext.data() + 65, MLKEM768_CIPHERTEXT_BYTES,
+                        &private_key_)) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    return true;
+  }
+
+ private:
+  ECKeyShare ec_;
+  MLKEM768_private_key private_key_;
+};
