+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    Array<uint8_t> ec_secret;
+    if (!ec_.Encap(out_ciphertext, &ec_secret, out_alert,
+                    peer_key.first(97)) ||
+        !out_secret->InitForOverwrite(ec_secret.size() +
+                                      MLKEM_SHARED_SECRET_BYTES)) {
+      return false;
+    }
+    OPENSSL_memcpy(out_secret->data(), ec_secret.data(), ec_secret.size());
+    uint8_t ciphertext[MLKEM1024_CIPHERTEXT_BYTES];
+    MLKEM1024_encap(ciphertext, out_secret->data() + ec_secret.size(),
+                    &public_key);
+    return CBB_add_bytes(out_ciphertext, ciphertext, sizeof(ciphertext));
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> ciphertext) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (ciphertext.size() != 97 + MLKEM1024_CIPHERTEXT_BYTES) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    Array<uint8_t> ec_secret;
+    if (!ec_.Decap(&ec_secret, out_alert, ciphertext.first(97)) ||
+        !out_secret->InitForOverwrite(ec_secret.size() +
+                                      MLKEM_SHARED_SECRET_BYTES)) {
+      return false;
+    }
+    OPENSSL_memcpy(out_secret->data(), ec_secret.data(), ec_secret.size());
+    if (!MLKEM1024_decap(out_secret->data() + ec_secret.size(),
+                        ciphertext.data() + 97, MLKEM1024_CIPHERTEXT_BYTES,
+                        &private_key_)) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    return true;
+  }
+
+ private:
+  ECKeyShare ec_;
+  MLKEM1024_private_key private_key_;
+};
